@using TeachingRecordSystem.SupportUi
@model SortDirection?
@* Added in the same order as Pages/_ViewImports.cshtml: tag helpers that share an Order run in the
   order their assemblies were registered, so the sortable column helper only gets to rewrite the cell
   before the GOV.UK table helper reads it because it sets an explicit Order. *@
@addTagHelper *, GovUk.Frontend.AspNetCore
@addTagHelper *, TeachingRecordSystem.SupportUi
@{
    Layout = null;

    // Written as an expression rather than a literal so Razor hands the tag helper an already-encoded
    // value - that's the case where the value used to get encoded a second time on the way to the button
    var include = "[name='SupportTaskReference']";
}

<govuk-table sortable>
    <table-head>
        <table-head-cell sort-direction="@Model"
                         link-template="@(direction => $"/_sortable-table?sortDirection={direction}")"
                         use-htmx="true"
                         hx-select="main"
                         hx-include="@include">
            Task
        </table-head-cell>
    </table-head>
</govuk-table>
