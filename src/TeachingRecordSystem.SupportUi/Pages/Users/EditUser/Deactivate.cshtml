@page "/users/{userId}/deactivate/{handler?}"
@using TeachingRecordSystem.Core
@model TeachingRecordSystem.SupportUi.Pages.Users.EditUser.DeactivateModel
@{
    ViewBag.Title = "Why are you deactivating this user?";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Users.EditUser.Index(Model.UserId)" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <h1 class="govuk-heading-l">@ViewBag.Title</h1>

        <form method="post">
            <govuk-radios for="HasAdditionalReason">
                <legend class="govuk-visually-hidden">
                    Reason for deactivating user
                </legend>
                <radios-item value="@false">
                    They no longer need access
                </radios-item>
                <radios-item value="@true">
                    Another reason

                    <conditional>
                        <govuk-character-count for="AdditionalReasonDetail"
                                               textarea-class="govuk-!-width-one-half"
                                               max-length="UiDefaults.ReasonDetailsMaxCharacterCount"
                                               rows="UiDefaults.ReasonDetailsRows">
                            <label>
                                Enter a reason for deactivating this user
                            </label>
                        </govuk-character-count>
                    </conditional>
                </radios-item>
            </govuk-radios>

            <h2 class="govuk-heading-m">Do you want to provide more details?</h2>

            <govuk-radios for="HasMoreInformation">
                <legend class="govuk-visually-hidden">
                    Do you have more information?
                </legend>
                <radios-item value="@true">
                    Yes

                    <conditional>
                        <govuk-character-count for="MoreInformationDetail"
                                               textarea-class="govuk-!-width-one-half"
                                               max-length="UiDefaults.ReasonDetailsMaxCharacterCount"
                                               rows="UiDefaults.ReasonDetailsRows">
                            <label>
                                Enter details
                            </label>
                        </govuk-character-count>
                    </conditional>
                </radios-item>
                <radios-item value="@false">
                    No
                </radios-item>
            </govuk-radios>

            @Html.EditorFor(m => m.Evidence)

            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button type="submit"
                              data-testid="cancel-button"
                              formaction=@LinkGenerator.Users.EditUser.DeactivateCancel(Model.UserId)
                              class="govuk-button--secondary">
                    Cancel and return to user
                </govuk-button>
            </div>
        </form>
    </div>
</div>
