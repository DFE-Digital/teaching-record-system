@page "/users/{userId}/{handler?}"
@model TeachingRecordSystem.SupportUi.Pages.Users.EditUser.IndexModel
@{
    ViewBag.Title = $"Change {Model.Name}\u2019s details";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Users.Index()" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <form method="post">
            @if (ViewData.ModelState.ErrorCount > 0)
            {
                // The role options are rendered without a tag helper so the error summary needs listing explicitly
                <govuk-error-summary>
                    <error-summary-item for="Name" />
                    <error-summary-item for="Role" />
                </govuk-error-summary>
            }

            <h1 class="govuk-heading-l">@ViewBag.Title</h1>

            <govuk-input for="Email" input-class="govuk-!-width-two-thirds" type="email" disabled="true">
                <label>Email address</label>
            </govuk-input>

            <govuk-input for="Name" input-class="govuk-!-width-two-thirds" disabled="@(!Model.IsActiveUser)">
                <label>Name</label>
            </govuk-input>

            <govuk-select for="TeamId" select-class="govuk-!-width-two-thirds" disabled="@(!Model.IsActiveUser)">
                <label class="govuk-label--m">Team</label>
                <select-item value=""></select-item>
                @foreach (var team in Model.AllTeams)
                {
                    <select-item value="@team.TeamId">@team.Name</select-item>
                }
            </govuk-select>

            <partial name="_UserRoleOptions" model="@(new UserRoleOptionsViewModel { FieldName = nameof(Model.Role), Roles = Model.RoleOptions, SelectedRole = Model.Role, Disabled = !Model.IsActiveUser })" />

            @if (Model.IsActiveUser)
            {
                <div class="govuk-button-group">
                    <govuk-button type="submit">Save changes</govuk-button>
                    <govuk-button-link class="govuk-button--secondary" href=@LinkGenerator.Users.EditUser.Deactivate(Model.UserId)>Deactivate user</govuk-button-link>
                    <govuk-button-link class="govuk-button--secondary" href=@LinkGenerator.Users.Index()>Cancel and return to users</govuk-button-link>
                </div>
            }
            else
            {
                <div class="govuk-button-group">
                    <govuk-button type="submit" asp-page-handler="activate">Reactivate user</govuk-button>
                    <govuk-button-link class="govuk-button--secondary" href=@LinkGenerator.Users.Index()>Cancel and return to users</govuk-button-link>
                </div>
            }

        </form>
    </div>
</div>
