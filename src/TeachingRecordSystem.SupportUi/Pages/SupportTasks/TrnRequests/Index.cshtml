@page "/support-tasks/trn-requests"
@using TeachingRecordSystem.SupportUi.Services.SupportTasks
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.TrnRequests.Index
@{
    ViewBag.Title = "Potential duplicates via API";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Index()" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">TRN requests</span>
        <h1 class="govuk-heading-l">@ViewBag.Title</h1>
    </div>

    @if (Model.TotalTaskCount == 0)
    {
        <div class="govuk-grid-column-two-thirds" data-testid="no-tasks-message">
            <p class="govuk-body-l govuk-!-font-weight-bold">There are no outstanding tasks</p>
        </div>
    }
    else
    {
        <div class="govuk-grid-column-two-thirds">
            <form method="get" asp-antiforgery="false">
                <div class="govuk-!-margin-bottom-4">
                    <govuk-input for="Search" type="search">
                        <label>
                            <h2 class="govuk-heading-s govuk-!-margin-bottom-2">Search</h2>
                        </label>
                        <hint>
                            Enter a name, email address or request date, for example 31/3/2025
                        </hint>
                        <after-input>
                            <govuk-button class="govuk-!-margin-bottom-0 govuk-!-margin-left-2 trs-!-height-full" type="submit">Search</govuk-button>
                        </after-input>
                    </govuk-input>
                </div>
            </form>
        </div>

        <div class="govuk-grid-column-full">
            @if (Model.ShowFilters)
            {
                <div class="trs-horizontal-filters">
                    @* autocomplete=off prevents the browser from remembering form state when the Back button is used *@
                    <form method="get" asp-antiforgery="false">
                        <h3 class="govuk-heading-s trs-horizontal-filters__heading">Filter by</h3>

                        <input asp-for="Search" type="hidden">

                        <div class="trs-horizontal-filters__container">
                            <div class="trs-horizontal-filters__options">
                                <govuk-checkboxes for="ApplicationUserIds">
                                    @foreach (var source in Model.ResultsBySourceApplication!)
                                    {
                                        <checkboxes-item value="@source.ApplicationUserId"
                                                               checked="@(Model.ApplicationUserIds?.Contains(source.ApplicationUserId) is true)">
                                            @source.Name (@source.Count)
                                        </checkboxes-item>
                                    }
                                </govuk-checkboxes>
                            </div>
                            <div class="trs-horizontal-filters__actions">
                                <div class="govuk-button-group govuk-!-margin-bottom-0">
                                    <a href="@LinkGenerator.SupportTasks.TrnRequests.Index(Model.Search)" class="govuk-link">Clear all</a>
                                    <govuk-button type="submit" class="govuk-!-margin-bottom-0">Apply filters</govuk-button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            }

            @if (Model.Results!.TotalItemCount == 0)
            {
                <p class="govuk-body-l govuk-!-font-weight-bold govuk-!-margin-top-2 govuk-!-margin-bottom-3" data-testid="no-results-message">
                    No matching requests found
                </p>
                <p class="govuk-body-m">Try searching again with different details.</p>
            }
            else
            {
                <govuk-table class="trs-table-layout-fixed" sortable data-testid="results" first-cell-is-header="true">
                    <table-head>
                        <table-head-cell class="govuk-!-width-one-quarter"
                            sort-direction="@(Model.SortBy == TrnRequestsSortByOption.Name ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.TrnRequests.Index(search: Model.Search, TrnRequestsSortByOption.Name, direction))">
                            Name and task ID
                        </table-head-cell>
                        <table-head-cell
                            sort-direction="@(Model.SortBy == TrnRequestsSortByOption.Email ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.TrnRequests.Index(search: Model.Search, TrnRequestsSortByOption.Email, direction))">
                            Email address
                        </table-head-cell>
                        <table-head-cell class="trs-!-width-150"
                            sort-direction="@(Model.SortBy == TrnRequestsSortByOption.RequestedOn ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.TrnRequests.Index(search: Model.Search, TrnRequestsSortByOption.RequestedOn, direction))">
                            Requested on
                        </table-head-cell>
                        <table-head-cell class="trs-!-width-150"
                            sort-direction="@(Model.SortBy == TrnRequestsSortByOption.Source ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.TrnRequests.Index(search: Model.Search, TrnRequestsSortByOption.Source, direction))">
                            Source
                        </table-head-cell>
                    </table-head>
                    @foreach (var result in Model.Results)
                    {
                        <table-row data-testid="task:@result.SupportTaskReference">
                            <table-cell data-testid="name">
                                <a href="@LinkGenerator.SupportTasks.TrnRequests.Resolve.Index(result.SupportTaskReference)" class="govuk-link trs-task-link">
                                    <span class="trs-task-link__name">@result.FirstName @result.MiddleName @result.LastName</span>
                                    <span class="trs-task-link__reference">@result.SupportTaskReference</span>
                                </a>
                            </table-cell>
                            <table-cell data-testid="email">@result.EmailAddress</table-cell>
                            <table-cell data-testid="requested-on">@result.CreatedOn.ToString(WebConstants.DateShortDisplayFormat)</table-cell>
                            <table-cell data-testid="source"><tag color="TagColor.Auto">@result.SourceApplicationName</tag></table-cell>
                        </table-row>
                    }
                </govuk-table>

                <govuk-pagination current-page="@Model.Pagination!.CurrentPage" total-pages="@Model.Pagination.LastPage" generate-page-href="@Model.Pagination.GetPageLink" />
            }
        </div>
    }
</div>
