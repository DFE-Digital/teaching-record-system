@page "/support-tasks/{supportTaskReference}"
@addTagHelper *, Joonasw.AspNetCore.SecurityHeaders
@using Microsoft.AspNetCore.Html
@using Microsoft.AspNetCore.Http.Extensions
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.SupportTaskDetail.Index
@{
    ViewBag.Title = $"{Model.Subject} {Model.SupportTaskReference}";

    var returnUrl = Request.GetEncodedPathAndQuery();
}

@section BeforeContent {
    <govuk-back-link href="@Model.BackLink" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            @if (Model.IsOutstanding)
            {
                <span class="govuk-caption-m">Manage task</span>

                <h1 class="govuk-heading-l govuk-!-margin-bottom-2">
                    @Model.Subject<br/>
                    @Model.SupportTaskReference
                </h1>
            }
            else
            {
                <span class="govuk-caption-m">@Model.SupportTaskType.GetTitle()</span>
                <span class="govuk-caption-m">@Model.SupportTaskReference</span>

                <h1 class="govuk-heading-l govuk-!-margin-bottom-2">
                    @Model.Subject
                </h1>
            }

            @{
                var linksBuilder = new HtmlContentBuilder();
            }

            @if (Model.IsOutstanding)
            {
                <capture-content to="linksBuilder">
                    <a href="@LinkGenerator.SupportTaskResolve(Model.SupportTaskReference, Model.SupportTaskType, returnUrl)" class="govuk-link">View task</a>
                </capture-content>
            }

            @if (Model.SubjectLink is not null)
            {
                if (linksBuilder.Count > 0)
                {
                    <capture-content to="linksBuilder">
                        <span class="trs-link-separator" aria-hidden="true">｜</span>
                    </capture-content>
                }

                <capture-content to="linksBuilder">
                    <a href="@Model.SubjectLink" target="_blank" class="govuk-link">@Model.SubjectLinkText (opens in a new tab)</a>
                </capture-content>
            }

            @if (linksBuilder.Count > 0)
            {
                <div class="govuk-!-margin-bottom-6">
                    @linksBuilder
                </div>
            }
        </form>
    </div>

    @if (Model.IsOutstanding)
    {
        <div class="govuk-grid-column-full">
            <form method="post">
                <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Overview</h2>

                <div class="trs-support-task__overview-actions">
                    <govuk-select for="AssignedToUserId">
                        <govuk-select-label>Assigned to</govuk-select-label>
                        <govuk-select-item value="@Model.UnassignedUserId">Unassigned</govuk-select-item>
                        @if (Model.ShowMyselfOption)
                        {
                            <govuk-select-item value="@Model.CurrentUserId">Myself</govuk-select-item>
                        }
                        @foreach (var option in Model.AssignToOptions!)
                        {
                            <govuk-select-item value="@option.UserId">@option.UserName</govuk-select-item>
                        }
                    </govuk-select>

                    <govuk-select for="Status">
                        <govuk-select-label>Status</govuk-select-label>
                        <govuk-select-item value="@SupportTaskStatus.Open">Not started</govuk-select-item>
                        <govuk-select-item value="@SupportTaskStatus.InProgress">In progress</govuk-select-item>
                    </govuk-select>
                </div>

                <div class="govuk-button-group">
                    <govuk-button type="submit">Update details</govuk-button>
                    <govuk-button-link href="@Model.BackLink" class="govuk-button--secondary">Cancel</govuk-button-link>
                </div>
            </form>
        </div>

        <div class="govuk-grid-column-full trs-task-detail__section">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Notes</h2>

            <p class="govuk-body">View and add notes related to this task.</p>

            @if (Model.Notes!.Count == 0)
            {
                <p class="govuk-body trs-empty-fallback" data-testid="no-notes">There are no notes associated with this task.</p>
            }
            else
            {
                <govuk-details open="@Model.ExpandNotes" data-testid="notes">
                    <govuk-details-summary>View notes</govuk-details-summary>
                    <govuk-details-text>
                        <div class="moj-timeline">
                            @foreach (var note in Model.Notes!)
                            {
                                <timeline-entry title="Note added" by="@note.CreatedBy" timestamp="@note.CreatedOn.ToGmt()">
                                    @note.Content
                                </timeline-entry>
                            }
                        </div>
                    </govuk-details-text>
                </govuk-details>
            }

            <govuk-button-link href="@LinkGenerator.SupportTasks.SupportTaskDetail.AddNote(Model.SupportTaskReference, returnUrl: returnUrl)"
                               class="govuk-button--secondary">
                Add a note
            </govuk-button-link>
        </div>

        <div class="govuk-grid-column-full trs-task-detail__section">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Zendesk tickets</h2>

            <p class="govuk-body">View and add Zendesk tickets related to this task.</p>

            @if (Model.ZendeskTickets!.Count == 0)
            {
                <p class="govuk-body trs-empty-fallback">No Zendesk tickets have been added yet.</p>
            }
            else
            {
                <govuk-details open="@Model.ExpandZendeskTickets" data-testid="zendesk-tickets">
                    <govuk-details-summary>View tickets</govuk-details-summary>
                    <govuk-details-text>
                        <table class="govuk-table">
                            <thead class="govuk-table__head">
                            <tr class="govuk-table__row">
                                <th scope="col" class="govuk-table__header govuk-!-width-one-half">
                                    Link to ticket
                                </th>
                                <th scope="col" class="govuk-table__header">
                                    Action
                                </th>
                            </tr>
                            </thead>
                            <tbody class="govuk-table__body">
                            @foreach (var ticketUrl in Model.ZendeskTickets)
                            {
                                <tr class="govuk-table__row">
                                    <td class="govuk-table__cell">@Index.GetZendeskTicketDisplayText(ticketUrl)</td>
                                    <td class="govuk-table__cell">
                                        <div class="govuk-button-group govuk-!-margin-bottom-0">
                                            <govuk-button type="button"
                                                          class="govuk-button--secondary trs-requires-js govuk-!-margin-bottom-0"
                                                          data-clipboard-text="@ticketUrl">
                                                Copy to clipboard
                                            </govuk-button>

                                            <a
                                                href="@ticketUrl"
                                                target="_blank"
                                                rel="noopener noreferrer"
                                                class="govuk-link">
                                                View ticket (opens in new tab)
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </govuk-details-text>
                </govuk-details>
            }

            <govuk-button-link href="@LinkGenerator.SupportTasks.SupportTaskDetail.ZendeskTickets(Model.SupportTaskReference, returnUrl: returnUrl)"
                               class="govuk-button--secondary">
                Add a Zendesk ticket
            </govuk-button-link>
        </div>

        @if (FeatureProvider.IsEnabled(FeatureNames.SupportTaskChangeHistory))
        {
            <div class="govuk-grid-column-full trs-task-detail__section">
                <h2 class="govuk-heading-m govuk-!-margin-bottom-2">History</h2>

                <govuk-details>
                    <govuk-details-summary>View activity</govuk-details-summary>
                    <govuk-details-text>
                        <div class="moj-timeline">
                            @foreach (var entry in Model.ChangeHistory!)
                            {
                                <vc:change-history-entry model="@entry" />
                            }
                        </div>
                    </govuk-details-text>
                </govuk-details>
            </div>
        }
    }
    else
    {
        <div class="govuk-grid-column-two-thirds">
            <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Key task details</h2>

            <govuk-summary-list>
                <row>
                    <key>Outcome</key>
                    <value>
                        <tag class="trs-!-max-width-none">@Model.Outcome?.GetDisplayName()</tag>
                    </value>
                </row>
                <row>
                    <key>Type</key>
                    <value>@Model.SupportTaskTypeTitle</value>
                </row>
                <row>
                    <key>Completed on</key>
                    <value>@Model.CompletedOn?.ToString(DateDisplayFormat)</value>
                </row>
                <row>
                    <key>Completed by</key>
                    <value>@Model.CompletedByUserName</value>
                </row>
                <row>
                    <key>Zendesk tickets</key>
                    <value>
                        @if (Model.ZendeskTickets?.Any() == true)
                        {
                            <ul class="govuk-list">
                                @foreach (var ticket in Model.ZendeskTickets)
                                {
                                    <li>
                                        <a href="@ticket" target="_blank" class="govuk-link" rel="noopener noreferrer">
                                            @Index.GetZendeskTicketDisplayText(ticket)
                                        </a>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <text>None</text>
                        }
                    </value>
                </row>
            </govuk-summary-list>

            @if (FeatureProvider.IsEnabled(FeatureNames.SupportTaskChangeHistory))
            {
                <h2 class="govuk-heading-m govuk-!-margin-bottom-2">Task history</h2>

                <div class="moj-timeline">
                    @foreach (var entry in Model.ChangeHistory!)
                    {
                        <vc:change-history-entry model="@entry" />
                    }
                </div>
            }
            else
            {
                @if (Model.Notes!.Count == 0)
                {
                    <p class="govuk-body trs-empty-fallback" data-testid="no-notes">There are no notes associated with this task.</p>
                }
                else
                {
                    <div class="moj-timeline">
                        @foreach (var note in Model.Notes!)
                        {
                            <timeline-entry title="Note added" by="@note.CreatedBy" timestamp="@note.CreatedOn.ToGmt()">
                                @note.Content
                            </timeline-entry>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@section Scripts {
    <script type="text/javascript" asp-add-nonce="true">
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('[data-clipboard-text]').forEach((element) => {
                element.addEventListener('click', (e) => {
                    var text = e.target.getAttribute('data-clipboard-text');
                    navigator.clipboard.writeText(text);
                })
            });
        });
    </script>
}
