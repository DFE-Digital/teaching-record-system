@page "/support-tasks/manual-checks-needed/{supportTaskReference}/resolve/confirm"
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.TrnRequestManualChecksNeeded.Resolve.Confirm
@{
    ViewBag.Title = "Confirm you’ve completed the checks";
}

<form method="post">
    <govuk-panel class="govuk-panel--interruption">
        <panel-title>@ViewBag.Title</panel-title>
        <panel-body>
            <p class="govuk-body">
                By continuing, you confirm that all checks needed outside this service are complete.
            </p>
        </panel-body>
        <panel-actions>
            <action-button type="submit">Continue</action-button>
            <action-link href="@LinkGenerator.SupportTasks.TrnRequestManualChecksNeeded.Resolve.Index(Model.SupportTaskReference!)">
                Go back to the TRN request
            </action-link>
        </panel-actions>
    </govuk-panel>
</form>
