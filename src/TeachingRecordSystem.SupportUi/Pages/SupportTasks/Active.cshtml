@page "/support-tasks/active/{handler?}"
@using TeachingRecordSystem.SupportUi.Services.SupportTasks
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.Active
@{
    ViewBag.Title = "Active tasks";

    var returnUrl = Model.ReturnUrl;
}

@section BeforeContent {
    @* Wrapped so the out of band attribute can be left off entirely - on a plain div a null value
       omits it, where on the tag helper it would render bare and htmx would read it as a swap. *@
    <div id="back-link" hx-swap-oob="@(Model.SwapBackLinkOutOfBand ? "true" : null)">
        <govuk-back-link href="@Model.BackLinkUrl"
                         hx-boost="@(Model.BackLinkUsesHtmx ? "true" : "false")"
                         hx-select="main"
                         hx-target="main"
                         hx-swap="outerHTML"
                         hx-include="@Model.SelectedTaskInputsSelector"
                         hx-push-url="true" />
    </div>
}

<span class="govuk-caption-m">Tasks overview</span>
<h1 class="govuk-heading-l">@ViewBag.Title</h1>

<div class="trs-vertical-filters">
    <form method="get" asp-antiforgery="false">
        <h2 class="govuk-heading-m trs-vertical-filters__heading">Filter tasks</h2>

        <div class="trs-display-flex trs-column-gap-1 govuk-!-margin-bottom-3">
            <govuk-select for="Type"
                          select-hx-get="@LinkGenerator.SupportTasks.Active(type: null, Model.AssignedToUserId, Model.Status, Model.SortBy, Model.SortDirection)"
                          select-hx-trigger="change"
                          select-hx-select="main"
                          select-hx-target="main"
                          select-hx-swap="outerHTML"
                          select-hx-push-url="true"
                          class="govuk-!-width-one-half govuk-!-margin-bottom-0"
                          select-class="govuk-!-width-full">
                <label class="govuk-label--s">Task type</label>
                <select-item value="">All types</select-item>
                @foreach (var type in SupportTaskTypeRegistry.GetAllTypes(includeLegacy: false).OrderBy(t => t.GetTitle()))
                {
                    <select-item value="@type">@type.GetTitle()</select-item>
                }
            </govuk-select>

            <govuk-select for="AssignedToUserId"
                          select-hx-get="@LinkGenerator.SupportTasks.Active(Model.Type, assignedToUserId: null, Model.Status, Model.SortBy, Model.SortDirection)"
                          select-hx-trigger="change"
                          select-hx-select="main"
                          select-hx-target="main"
                          select-hx-swap="outerHTML"
                          select-hx-push-url="true"
                          class="govuk-!-width-one-half govuk-!-margin-bottom-0"
                          select-class="govuk-!-width-full">
                <label class="govuk-label--s">Assigned to</label>
                <select-item value="">All owners</select-item>
                <select-item value="@Model.UnassignedUserId">Unassigned</select-item>
                @if (Model.ShowMyselfOption)
                {
                    <select-item value="@Model.CurrentUserId">Myself</select-item>
                }
                @foreach (var user in Model.AssignToOptions!)
                {
                    <select-item value="@user.UserId">
                        @user.UserName
                    </select-item>
                }
            </govuk-select>
        </div>

        <govuk-checkboxes for="Status" class="govuk-checkboxes--small trs-checkboxes--horizontal govuk-!-margin-bottom-3">
            <legend class="govuk-fieldset__legend--s govuk-!-margin-bottom-1">Status</legend>
            @foreach (var status in new[] { SupportTaskStatus.Open, SupportTaskStatus.InProgress })
            {
                var toggledStatuses = (Model.Status ?? []).ToHashSet();
                toggledStatuses.SymmetricExceptWith([status]);

                <checkboxes-item value="@status"
                                       checked="@Model.Status.Contains(status)"
                                       input-hx-get="@LinkGenerator.SupportTasks.Active(Model.Type, Model.AssignedToUserId, toggledStatuses, Model.SortBy, Model.SortDirection)"
                                       input-hx-select="main"
                                       input-hx-target="main"
                                       input-hx-swap="outerHTML"
                                       input-hx-push-url="true">
                    @status.GetDisplayName()
                </checkboxes-item>
            }
        </govuk-checkboxes>

        <div class="trs-vertical-filters__actions">
            <div class="govuk-button-group govuk-!-margin-bottom-0">
                <noscript class="trs-display-flex">
                    <govuk-button type="submit">Apply filters</govuk-button>
                </noscript>
                <a href="@LinkGenerator.SupportTasks.Active()"
                   hx-get="@LinkGenerator.SupportTasks.Active()"
                   hx-select="main"
                   hx-target="main"
                   hx-swap="outerHTML"
                   hx-push-url="true"
                   class="govuk-link">
                    Clear all
                </a>
            </div>
        </div>
    </form>
</div>

@if (Model.Results!.Count == 0)
{
    <p class="govuk-body-l govuk-!-font-weight-bold govuk-!-margin-top-2 govuk-!-margin-bottom-3" data-testid="no-results-message">
        No matching tasks found
    </p>
    <p class="govuk-body-m">Try searching again with different details.</p>
}
else
{
    <govuk-table class="trs-table-layout-fixed" sortable data-testid="results">
        <table-head>
            <table-head-cell class="trs-!-width-35">
                <div class="govuk-checkboxes__item govuk-checkboxes--small trs-select-row trs-requires-js">
                    <partial name="_SelectAllTasks" model="@Model.GetSelectAllViewModel(swapOutOfBand: false)" />
                    <label for="select-all-tasks" class="govuk-label govuk-checkboxes__label">
                        <span class="govuk-visually-hidden">Select all tasks on this page</span>
                    </label>
                </div>
            </table-head-cell>
            <table-head-cell
                sort-direction="@(Model.SortBy == SupportTasksSortByOption.Subject ? Model.SortDirection : null)"
                link-template="@(direction => LinkGenerator.SupportTasks.Active(Model.Type, Model.AssignedToUserId, Model.Status, SupportTasksSortByOption.Subject, direction))"
                use-htmx="true"
                hx-include="@Model.SelectedTaskInputsSelector"
                hx-select="main"
                hx-target="main"
                hx-swap="outerHTML"
                hx-push-url="true">
                Task
            </table-head-cell>
            <table-head-cell class="trs-!-width-150"
                sort-direction="@(Model.SortBy == SupportTasksSortByOption.RequestedOn ? Model.SortDirection : null)"
                link-template="@(direction => LinkGenerator.SupportTasks.Active(Model.Type, Model.AssignedToUserId, Model.Status, SupportTasksSortByOption.RequestedOn, direction))"
                use-htmx="true"
                hx-include="@Model.SelectedTaskInputsSelector"
                hx-select="main"
                hx-target="main"
                hx-swap="outerHTML"
                hx-push-url="true">
                Requested on
            </table-head-cell>
            <table-head-cell class="trs-!-width-150"
                sort-direction="@(Model.SortBy == SupportTasksSortByOption.TaskType ? Model.SortDirection : null)"
                link-template="@(direction => LinkGenerator.SupportTasks.Active(Model.Type, Model.AssignedToUserId, Model.Status, SupportTasksSortByOption.TaskType, direction))"
                use-htmx="true"
                hx-include="@Model.SelectedTaskInputsSelector"
                hx-select="main"
                hx-target="main"
                hx-swap="outerHTML"
                hx-push-url="true">
                Type
            </table-head-cell>
            <table-head-cell class="trs-!-width-120"
                sort-direction="@(Model.SortBy == SupportTasksSortByOption.Status ? Model.SortDirection : null)"
                link-template="@(direction => LinkGenerator.SupportTasks.Active(Model.Type, Model.AssignedToUserId, Model.Status, SupportTasksSortByOption.Status, direction))"
                use-htmx="true"
                hx-include="@Model.SelectedTaskInputsSelector"
                hx-select="main"
                hx-target="main"
                hx-swap="outerHTML"
                hx-push-url="true">
                Status
            </table-head-cell>
            <table-head-cell class="trs-!-width-130"
                sort-direction="@(Model.SortBy == SupportTasksSortByOption.AssignedTo ? Model.SortDirection : null)"
                link-template="@(direction => LinkGenerator.SupportTasks.Active(Model.Type, Model.AssignedToUserId, Model.Status, SupportTasksSortByOption.AssignedTo, direction))"
                use-htmx="true"
                hx-include="@Model.SelectedTaskInputsSelector"
                hx-select="main"
                hx-target="main"
                hx-swap="outerHTML"
                hx-push-url="true">
                Assigned to
            </table-head-cell>
            <table-head-cell class="trs-!-width-90"
                sort-direction="@(Model.SortBy == SupportTasksSortByOption.Source ? Model.SortDirection : null)"
                link-template="@(direction => LinkGenerator.SupportTasks.Active(Model.Type, Model.AssignedToUserId, Model.Status, SupportTasksSortByOption.Source, direction))"
                use-htmx="true"
                hx-include="@Model.SelectedTaskInputsSelector"
                hx-select="main"
                hx-target="main"
                hx-swap="outerHTML"
                hx-push-url="true">
                Source
            </table-head-cell>
            <table-head-cell class="trs-!-width-90">
                Action
            </table-head-cell>
        </table-head>
        @foreach (var result in Model.Results!)
        {
            var isSelected = Model.IsSelected(result.SupportTaskReference);

            <table-row data-testid="task:@result.SupportTaskReference">
                <table-cell>
                    <div class="govuk-checkboxes__item govuk-checkboxes--small trs-select-row">
                        <input type="checkbox"
                               class="govuk-checkboxes__input"
                               id="AssignSupportTask-@(result.SupportTaskReference)"
                               value="@result.SupportTaskReference"
                               name="SupportTaskReference"
                               form="assign-tasks-form"
                               data-selects-row
                               checked="@(isSelected ? "checked" : null)"
                               hx-get="@Model.SelectionBannerUrl"
                               hx-include="@Model.RowCheckboxIncludeSelector"
                               hx-target="#selected-tasks-banner"
                               hx-swap="innerHTML" />
                        <label for="AssignSupportTask-@(result.SupportTaskReference)" class="govuk-label govuk-checkboxes__label">
                            <span class="govuk-visually-hidden">Select @result.SupportTaskReference</span>
                        </label>
                    </div>
                </table-cell>
                <table-cell data-testid="task-name-and-id">
                    <a href="@LinkGenerator.SupportTaskResolve(result.SupportTaskReference, result.SupportTaskType, returnUrl)" class="govuk-link trs-task-link">
                        <span class="trs-task-link__name" data-testid="task-name">@result.Subject</span>
                        <span class="trs-task-link__reference" data-testid="task-reference">@result.SupportTaskReference</span>
                    </a>
                </table-cell>
                <table-cell data-testid="requested-on">@result.CreatedOn.ToString(WebConstants.DateShortDisplayFormat)</table-cell>
                <table-cell>@result.SupportTaskType.GetTitle()</table-cell>
                <table-cell data-testid="status">
                    <support-task-status-tag status="@result.Status"/>
                </table-cell>
                <table-cell data-testid="assigned-to" use-empty-fallback="Unassigned">
                    @(result.AssignedToUserId == Model.CurrentUserId ? "Myself" : result.AssignedToName)
                </table-cell>
                <table-cell data-testid="source">
                    @if (result.SourceApplicationName is not null)
                    {
                        <tag>@result.SourceApplicationName</tag>
                    }
                    else
                    {
                        <span use-empty-fallback="Not applicable"></span>
                    }
                </table-cell>
                <table-cell>
                    <a href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(result.SupportTaskReference, returnUrl: returnUrl)"
                       class="govuk-link">
                        Manage
                    </a>
                </table-cell>
            </table-row>
        }
    </govuk-table>
}

@* htmx snapshots innerHTML for its history cache, and clicking a checkbox sets the property but
   never the attribute - so a restored snapshot would come back with the selection silently dropped.
   Opting out of the cache makes back and forward re-request the URL, which does carry it. *@
<form id="assign-tasks-form" action="@LinkGenerator.SupportTasks.Assign()" method="get" asp-antiforgery="false" hx-history="false">
    <input name="returnUrl" type="hidden" value="@returnUrl">
    <input name="sortBy" type="hidden" value="@Model.SortBy">
    <input name="sortDirection" type="hidden" value="@Model.SortDirection">
    @foreach (var supportTaskReference in Model.SelectedTaskReferencesNotOnPage)
    {
        <input type="hidden" name="SupportTaskReference" value="@supportTaskReference">
    }
    <noscript>
        <govuk-button type="submit">Assign tasks</govuk-button>
    </noscript>
</form>

<input type="hidden" name="pageTaskReferences" value="@Model.PageTaskReferences">

@* Boosting the pagination links swaps the results in place, and hx-include sends the selection up
   with the request so that changing page keeps it. *@
<div hx-boost="true"
     hx-select="main"
     hx-target="main"
     hx-swap="outerHTML"
     hx-include="@Model.SelectedTaskInputsSelector"
     hx-push-url="true">
    <govuk-pagination current-page="@Model.Pagination!.CurrentPage" total-pages="@Model.Pagination.LastPage" generate-page-href="@Model.Pagination.GetPageLink" />
</div>

<div id="selected-tasks-banner" aria-live="polite" aria-atomic="true">
    <partial name="_SelectedActiveSupportTasks" model="@(new Active.SelectionViewModel(Model.SelectedTaskCount, Model.ClearSelectionUrl))" />
</div>

@section ContainerEnd {
    <div aria-atomic="true" aria-live="polite" role="status" id="status" class="govuk-visually-hidden" hx-swap-oob="innerHTML">
        @if (Model.Results!.Count == 0)
        {
            <text>No matching tasks found.</text>
        }
        else
        {
            <text>
                Showing @Model.Results!.Count of @Model.TotalTaskCount matching tasks
                sorted by @Model.OrderedByLabel (@Model.OrderDirectionLabel).
            </text>
        }
    </div>
}
