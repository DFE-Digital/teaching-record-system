@page "/support-tasks/integration-transactions"
@addTagHelper *, Joonasw.AspNetCore.SecurityHeaders
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.IntegrationTransactions.IndexModel
@{
    ViewBag.Title = "Integration transactions";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Index()" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Third-party tasks</span>
        <h1 class="govuk-heading-l">@ViewBag.Title</h1>
    </div>

    <div class="govuk-grid-column-full" data-testid="results">
        <govuk-table sortable>
            <table-head>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.IntegrationTransactionId ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.IntegrationTransactionId, direction))">
                    ID
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.InterfaceType ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.InterfaceType, direction))">
                    Interface
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.CreatedOn ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.CreatedOn, direction))">
                    Date and time
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.ImportStatus ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.ImportStatus, direction))">
                    Import status
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.Total ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.Total, direction))">
                    Total
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.Successes ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.Successes, direction))">
                    Successes
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.Warnings ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.Warnings, direction))">
                    Warnings
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.Failures ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.Failures, direction))">
                    Failures
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == IntegrationTransactionSortByOption.Duplicates ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.SupportTasks.IntegrationTransactions.Index(IntegrationTransactionSortByOption.Duplicates, direction))">
                    Duplicates
                </table-head-cell>
            </table-head>
            @if (Model.Results!.Count == 0)
            {
                <table-row data-testid="no-integration-transactions-message">
                    <table-cell colspan="8">No integration transactions</table-cell>
                </table-row>
            }
            else
            {
                foreach (var result in Model.Results)
                {
                    <table-row data-testid="integration-transaction:@result.IntegrationTransactionId">
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:id">
                            @result.IntegrationTransactionId
                        </table-cell>
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:interface">
                            <a class="govuk-link" href="integration-transactions/@result.IntegrationTransactionId/detail">@result.InterfaceType.GetDisplayName()</a>
                        </table-cell>
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:createdon">
                            <div class="govuk-\!-text-align-centre">@result.CreatedOn.ToString(WebConstants.DateDisplayFormat)</div>
                            <div>@result.CreatedOn.ToString("hh:mm tt")</div>
                        </table-cell>
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:importstatus">
                            @if (result.ImportStatus == IntegrationTransactionImportStatus.Success)
                            {
                                <tag color="TagColor.Green" class="govuk-!-static-padding-1">@result.ImportStatus.GetDisplayName()</tag>
                            }
                            else @if (result.ImportStatus == IntegrationTransactionImportStatus.InProgress)
                            {
                                <tag color="TagColor.Blue" class="govuk-!-static-padding-1">@result.ImportStatus.GetDisplayName()</tag>
                            }
                            else
                            {
                                <tag color="TagColor.Red" class="govuk-!-static-padding-1">@result.ImportStatus.GetDisplayName()</tag>
                            }
                        </table-cell>

                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:total">
                            @result.TotalCount
                        </table-cell>
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:successes">
                            @result.SuccessesCount
                        </table-cell>
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:warnings">
                            @result.WarningsCount
                        </table-cell>
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:failures">
                            @result.FailuresCount
                        </table-cell>
                        <table-cell
                            data-testid="integration-transaction:@result.IntegrationTransactionId:duplicates">
                            @result.DuplicatesCount
                        </table-cell>
                    </table-row>
                }
            }
        </govuk-table>
    </div>

    <div class="govuk-grid-column-full">
        <govuk-pagination current-page="@Model.Pagination!.CurrentPage" total-pages="@Model.Pagination.LastPage" generate-page-href="@Model.Pagination.GetPageLink" />
    </div>

</div>

