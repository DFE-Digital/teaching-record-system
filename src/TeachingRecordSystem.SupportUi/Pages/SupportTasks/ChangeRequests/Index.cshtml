@page "/support-tasks/change-requests"
@using TeachingRecordSystem.SupportUi.Services.SupportTasks
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.ChangeRequests.IndexModel
@{
    ViewBag.Title = "Name and date of birth change requests";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Index()" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Record management</span>
        <h1 class="govuk-heading-l">@ViewBag.Title</h1>
    </div>

    @if (Model.TotalRequestCount == 0)
    {
        <div class="govuk-grid-column-two-thirds" data-testid="no-tasks-message">
            <p class="govuk-body-l govuk-!-font-weight-bold">There are no outstanding tasks</p>
        </div>
    }
    else
    {
        <div class="govuk-grid-column-full">
            <filter-layout>
                <filter-layout-filter>
                    <filter>
                        <input type="hidden" asp-for="@Model.SortBy" />
                        <input type="hidden" asp-for="@Model.SortDirection" />
                        @* This flag is so we can track when the filters have been applied vs a fresh page load *@
                        <input type="hidden" name="_f" value="true" />

                        <filter-options>
                            <govuk-input for="Search" label-class="govuk-label--s" spellcheck="false" type="search" />

                            <govuk-checkboxes for="ChangeRequestTypes" class="govuk-checkboxes--small">
                                <legend class="govuk-fieldset__legend--s">
                                    Type of request
                                </legend>
                                <checkboxes-item value="@SupportTaskType.ChangeDateOfBirthRequest" checked="true">
                                    Date of birth (@Model.DateOfBirthChangeRequestCount)
                                </checkboxes-item>
                                <checkboxes-item value="@SupportTaskType.ChangeNameRequest" checked="true">
                                    Name (@Model.NameChangeRequestCount)
                                </checkboxes-item>
                            </govuk-checkboxes>

                            <div class="govuk-button-group">
                                <govuk-button type="submit">Apply filters</govuk-button>
                                <a class="govuk-link govuk-link--no-visited-state" href="@LinkGenerator.SupportTasks.ChangeRequests.Index()">Clear filters</a>
                            </div>
                        </filter-options>
                    </filter>
                </filter-layout-filter>
                <filter-layout-content>
                    @if (Model.Results!.TotalItemCount == 0)
                    {
                        <p class="govuk-body-l govuk-!-font-weight-bold govuk-!-margin-top-2 govuk-!-margin-bottom-3" data-testid="no-results-message">
                            No matching requests found
                        </p>
                        <p class="govuk-body-m">Try searching again with different details.</p>
                    }
                    else
                    {
                        <govuk-table sortable data-testid="results" first-cell-is-header="true">
                            <table-head>
                                <table-head-cell class="govuk-!-width-one-quarter"
                                    sort-direction="@(Model.SortBy == ChangeRequestsSortByOption.Name ? Model.SortDirection : null)"
                                    link-template="@(direction => LinkGenerator.SupportTasks.ChangeRequests.Index(sortBy: ChangeRequestsSortByOption.Name, sortDirection: direction))">
                                    Name
                                </table-head-cell>
                                <table-head-cell class="trs-!-width-150"
                                    sort-direction="@(Model.SortBy == ChangeRequestsSortByOption.RequestedOn ? Model.SortDirection : null)"
                                    link-template="@(direction => LinkGenerator.SupportTasks.ChangeRequests.Index(sortBy: ChangeRequestsSortByOption.RequestedOn, sortDirection: direction))">
                                    Requested on
                                </table-head-cell>
                                <table-head-cell class="trs-!-width-150"
                                    sort-direction="@(Model.SortBy == ChangeRequestsSortByOption.ChangeType ? Model.SortDirection : null)"
                                    link-template="@(direction => LinkGenerator.SupportTasks.ChangeRequests.Index(sortBy: ChangeRequestsSortByOption.ChangeType, sortDirection: direction))">
                                    Type
                                </table-head-cell>
                            </table-head>
                            @foreach (var result in Model.Results)
                            {
                                <table-row data-reference="@result.SupportTaskReference">
                                    <table-cell data-testid="name">
                                        <a href="@LinkGenerator.SupportTasks.ChangeRequests.EditChangeRequest.Index(result.SupportTaskReference)" class="govuk-link">@result.Name</a>
                                    </table-cell>
                                    <table-cell data-testid="requested-on">@result.CreatedOn.ToString(WebConstants.DateDisplayFormat)</table-cell>
                                    <table-cell data-testid="change-type">@(result.SupportTaskType == SupportTaskType.ChangeDateOfBirthRequest ? "Date of birth" : "Name")</table-cell>
                                </table-row>
                            }
                        </govuk-table>
                    }
                </filter-layout-content>
            </filter-layout>

            <govuk-pagination current-page="@Model.Pagination!.CurrentPage" total-pages="@Model.Pagination.LastPage" generate-page-href="@Model.Pagination.GetPageLink" />
        </div>
    }
</div>
