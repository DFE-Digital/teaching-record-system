@page "/support-tasks/change-requests/{supportTaskReference}/accept"
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.ChangeRequests.EditChangeRequest.AcceptModel
@{
    ViewBag.Title = "Confirm the change";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.SupportTasks.ChangeRequests.EditChangeRequest.Index(Model.SupportTaskReference, Model.ReturnUrl)" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <vc:support-task-header page-header="@ViewBag.Title" />

        <form method="post">
            <govuk-table>
            <table-head>
                <table-head-cell class="govuk-!-width-one-quarter">Details</table-head-cell>
                <table-head-cell>Current</table-head-cell>
                <table-head-cell>New</table-head-cell>
            </table-head>
                @if (Model.ChangeType == SupportTaskType.ChangeNameRequest)
                {
                @if (Model.NameChangeRequest!.CurrentFirstName != Model.NameChangeRequest!.NewFirstName)
                {
                    <table-row data-testid="first-name">
                        <table-cell class="govuk-!-font-weight-bold" data-testid="first-name-title">First name</table-cell>
                        <table-cell data-testid="first-name-current">@Model.NameChangeRequest!.CurrentFirstName</table-cell>
                        <table-cell data-testid="first-name-new">@Model.NameChangeRequest!.NewFirstName</table-cell>
                    </table-row>
                }
                @if (Model.NameChangeRequest!.CurrentMiddleName != Model.NameChangeRequest!.NewMiddleName)
                {
                    <table-row data-testid="middle-name">
                        <table-cell class="govuk-!-font-weight-bold" data-testid="middle-name-title">Middle name</table-cell>
                        <table-cell data-testid="middle-name-current">@Model.NameChangeRequest!.CurrentMiddleName</table-cell>
                        <table-cell data-testid="middle-name-new">@Model.NameChangeRequest!.NewMiddleName</table-cell>
                    </table-row>
                }
                @if (Model.NameChangeRequest!.CurrentLastName != Model.NameChangeRequest!.NewLastName)
                {
                    <table-row data-testid="last-name">
                        <table-cell class="govuk-!-font-weight-bold" data-testid="last-name-title">Last name</table-cell>
                        <table-cell data-testid="last-name-current">@Model.NameChangeRequest!.CurrentLastName</table-cell>
                        <table-cell data-testid="last-name-new">@Model.NameChangeRequest!.NewLastName</table-cell>
                    </table-row>
                }
                }
                @if (Model.ChangeType == SupportTaskType.ChangeDateOfBirthRequest)
                {
                <table-row data-testid="date-of-birth">
                    <table-cell class="govuk-!-font-weight-bold" data-testid="date-of-birth-title">Date of birth</table-cell>
                    <table-cell data-testid="date-of-birth-current">@Model.DateOfBirthChangeRequest!.CurrentDateOfBirth.ToString(WebConstants.DateDisplayFormat)</table-cell>
                    <table-cell data-testid="date-of-birth-new">@Model.DateOfBirthChangeRequest!.NewDateOfBirth.ToString(WebConstants.DateDisplayFormat)</table-cell>
                </table-row>
                }
            </govuk-table>

            <govuk-button type="submit">Confirm</govuk-button>
        </form>
    </div>
</div>
