@page "/support-tasks/change-requests/{supportTaskReference}/{handler?}/{id?}"
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.ChangeRequests.EditChangeRequest.IndexModel
@{
    ViewBag.Title = "Change details request";
}

@section BeforeContent {
    <govuk-back-link href="@Model.BackLink" />
}

<vc:support-task-header />

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <govuk-table>
            <table-head>
                <table-head-cell class="govuk-!-width-one-quarter">Details</table-head-cell>
                <table-head-cell>Current</table-head-cell>
                <table-head-cell>New</table-head-cell>
            </table-head>
            @if (Model.ChangeType == SupportTaskType.ChangeNameRequest)
            {
                if (Model.NameChangeRequest!.NewFirstName is not null && Model.NameChangeRequest!.CurrentFirstName != Model.NameChangeRequest!.NewFirstName)
                {
                    <table-row data-testid="first-name">
                        <table-cell class="govuk-!-font-weight-bold" data-testid="first-name-title">First name</table-cell>
                        <table-cell data-testid="first-name-current">@Model.NameChangeRequest!.CurrentFirstName</table-cell>
                        <table-cell data-testid="first-name-new">@Model.NameChangeRequest!.NewFirstName</table-cell>
                    </table-row>
                }
                if (Model.NameChangeRequest!.NewMiddleName is not null && Model.NameChangeRequest!.CurrentMiddleName != Model.NameChangeRequest!.NewMiddleName)
                {
                    <table-row data-testid="middle-name">
                        <table-cell class="govuk-!-font-weight-bold" data-testid="middle-name-title">Middle name</table-cell>
                        <table-cell data-testid="middle-name-current">@Model.NameChangeRequest!.CurrentMiddleName</table-cell>
                        <table-cell data-testid="middle-name-new">@Model.NameChangeRequest!.NewMiddleName</table-cell>
                    </table-row>
                }
                if (Model.NameChangeRequest!.NewLastName is not null && Model.NameChangeRequest!.CurrentLastName != Model.NameChangeRequest!.NewLastName)
                {
                    <table-row data-testid="last-name">
                        <table-cell class="govuk-!-font-weight-bold" data-testid="last-name-title">Last name</table-cell>
                        <table-cell data-testid="last-name-current">@Model.NameChangeRequest!.CurrentLastName</table-cell>
                        <table-cell data-testid="last-name-new">@Model.NameChangeRequest!.NewLastName</table-cell>
                    </table-row>
                }
            }
            @if (Model.ChangeType == SupportTaskType.ChangeDateOfBirthRequest)
            {
                <table-row data-testid="date-of-birth">
                    <table-cell class="govuk-!-font-weight-bold" data-testid="date-of-birth-title">Date of birth</table-cell>
                    <table-cell data-testid="date-of-birth-current">@Model.DateOfBirthChangeRequest!.CurrentDateOfBirth.ToString(WebConstants.DateDisplayFormat)</table-cell>
                    <table-cell data-testid="date-of-birth-new">@Model.DateOfBirthChangeRequest!.NewDateOfBirth.ToString(WebConstants.DateDisplayFormat)</table-cell>
                </table-row>
            }
            <table-row data-testid="email">
                <table-cell class="govuk-!-font-weight-bold" data-testid="email-title">Email</table-cell>
                <table-cell colspan="2" data-testid="email-value">@Model.Email</table-cell>
            </table-row>
            <table-row data-testid="linked-record">
                <table-cell class="govuk-!-font-weight-bold" data-testid="linked-record-title">TRN</table-cell>
                <table-cell colspan="2" data-testid="linked-record-value">
                    <a href="@LinkGenerator.Persons.PersonDetail.Index(Model.PersonId!.Value)" target="_blank" rel="noopener noreferrer" class="govuk-link">
                        @Model.Trn (opens in a new tab)
                    </a>
                </table-cell>
            </table-row>
        </govuk-table>
    </div>
</div>

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <h2 class="govuk-heading-m">Proof of identity</h2>
        <govuk-details>
            <summary>Documents we accept</summary>
            <text>
                <p class="govuk-body">We accept the following documents:</p>
                <ul class="govuk-list govuk-list--bullet">
                    @if (Model.ChangeType == SupportTaskType.ChangeNameRequest)
                    {
                        <li>passport</li>
                        <li>marriage certificate</li>
                        <li>civil agreement certificate</li>
                        <li>deed poll</li>
                        <li>birth certificate</li>
                        <li>decree absolute</li>
                        <li>statutory declaration</li>
                    }
                    @if (Model.ChangeType == SupportTaskType.ChangeDateOfBirthRequest)
                    {
                        <li>passport</li>
                        <li>birth certificate</li>
                        <li>driving license</li>
                    }
                </ul>
            </text>
        </govuk-details>
        <div class="govuk-grid-row">
            <div class="govuk-grid-column-full govuk-!-margin-bottom-4">
                @if (Model.Evidence!.MimeType == "application/pdf")
                {
                    <object data="@LinkGenerator.SupportTasks.ChangeRequests.EditChangeRequest.Evidence(Model.SupportTaskReference!)" type="application/pdf" width="100%" height="500px" class="govuk-!-margin-bottom-2" data-testid="pdf-@Model.Evidence!.FileId">
                    </object>
                }
                else
                {
                    <img src="@LinkGenerator.SupportTasks.ChangeRequests.EditChangeRequest.Evidence(Model.SupportTaskReference!)" alt="@Model.Evidence.FileName" width="100%" height="auto" class="govuk-!-margin-bottom-2" data-testid="image-@Model.Evidence!.FileId" />
                }
                <a href="@Model.Evidence!.FileUrl" class="govuk-link" rel="noreferrer noopener" target="_blank" date-testid="view-larger-@Model.Evidence!.FileId">View larger (opens in new tab)</a>
            </div>
        </div>
    </div>
</div>

<div class="govuk-button-group">
    <govuk-button-link href="@LinkGenerator.SupportTasks.ChangeRequests.EditChangeRequest.Accept(Model.SupportTaskReference!, Model.ReturnUrl)" class="govuk-button">Accept change</govuk-button-link>
    <govuk-button-link href="@LinkGenerator.SupportTasks.ChangeRequests.EditChangeRequest.Reject(Model.SupportTaskReference!, Model.ReturnUrl)" class="govuk-button govuk-button--warning">Reject change</govuk-button-link>
</div>
