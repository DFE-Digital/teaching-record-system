@page "/support-tasks/change-requests/{supportTaskReference}/reject"
@using TeachingRecordSystem.Core.Models.SupportTasks;
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.ChangeRequests.EditChangeRequest.RejectModel
@{
    ViewBag.Title = "Reject the change";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.SupportTasks.ChangeRequests.EditChangeRequest.Index(Model.SupportTaskReference, Model.ReturnUrl)" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <vc:support-task-header page-header="@ViewBag.Title" />

        <form method="post">
            <govuk-radios for="RejectionReasonChoice">
                <legend>
                    <h3 class="govuk-heading-m">Reason for rejecting</h3>
                </legend>
                <radios-item value="@ChangeRequestRejectReason.RequestAndProofDontMatch">
                    @ChangeRequestRejectReason.RequestAndProofDontMatch.GetDisplayName()
                </radios-item>
                <radios-item value="@ChangeRequestRejectReason.WrongTypeOfDocument">
                    @ChangeRequestRejectReason.WrongTypeOfDocument.GetDisplayName()
                </radios-item>
                <radios-item value="@ChangeRequestRejectReason.ImageQuality">
                    @ChangeRequestRejectReason.ImageQuality.GetDisplayName()
                </radios-item>
                <radios-item value="@ChangeRequestRejectReason.ChangeNoLongerRequired">
                    @ChangeRequestRejectReason.ChangeNoLongerRequired.GetDisplayName()
                </radios-item>
            </govuk-radios>

            <govuk-button type="submit">Reject</govuk-button>
        </form>
    </div>
</div>
