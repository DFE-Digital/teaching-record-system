@page "/support-tasks/one-login-user-matching/{supportTaskReference}/resolve/reject"
@using TeachingRecordSystem.Core.Models.SupportTasks
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.OneLoginUserMatching.Resolve.Reject
@{
    ViewBag.Title = "Why are you rejecting this request?";
}

@section BeforeContent {
    <govuk-back-link href="@Model.BackLink" />
}

<form method="post">
    <div class="govuk-grid-row">
        <div class="govuk-grid-column-two-thirds">
            <govuk-radios for="Reason">
                <govuk-radios-fieldset-legend>
                    <vc:support-task-header page-header="@ViewBag.Title" />
                    <div class="govuk-hint">We’ll email the person with the reason you select</div>
                </govuk-radios-fieldset-legend>
                <govuk-radios-item value="@OneLoginIdVerificationRejectReason.ProofDoesNotMatchRequest">
                    @OneLoginIdVerificationRejectReason.ProofDoesNotMatchRequest.GetDisplayName()
                </govuk-radios-item>
                <govuk-radios-item value="@OneLoginIdVerificationRejectReason.ProofIsUnclear">
                    @OneLoginIdVerificationRejectReason.ProofIsUnclear.GetDisplayName()
                </govuk-radios-item>
                <govuk-radios-item value="@OneLoginIdVerificationRejectReason.ProofIsWrongType">
                    @OneLoginIdVerificationRejectReason.ProofIsWrongType.GetDisplayName()
                </govuk-radios-item>
                <govuk-radios-item value="@OneLoginIdVerificationRejectReason.AnotherReason">
                    @OneLoginIdVerificationRejectReason.AnotherReason.GetDisplayName()
                    <govuk-radios-item-conditional>
                        <govuk-character-count for="AdditionalDetails" max-length="@UiDefaults.ReasonDetailsMaxCharacterCount">
                            <govuk-character-count-label>Enter details</govuk-character-count-label>
                        </govuk-character-count>
                    </govuk-radios-item-conditional>
                </govuk-radios-item>
            </govuk-radios>

            <div class="govuk-button-group">
                <govuk-button type="submit" data-testid="continue-button">Continue</govuk-button>

                <govuk-button type="submit" name="action" value="@Reject.Actions.SaveAndComeBackLater" class="govuk-button--secondary">
                    Save and come back later
                </govuk-button>

                <govuk-button type="submit" name="action" value="@Reject.Actions.Cancel" data-testid="cancel-button" class="govuk-button--secondary">
                    Cancel
                </govuk-button>
            </div>
        </div>
    </div>
</form>

