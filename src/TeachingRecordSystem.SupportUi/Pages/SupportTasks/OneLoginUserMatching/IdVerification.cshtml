@page "/support-tasks/one-login-user-matching/id-verification"
@using TeachingRecordSystem.SupportUi.Services.SupportTasks
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.OneLoginUserMatching.IdVerification

@{
    ViewBag.Title = "GOV.UK One Login – identity verification";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Index()" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <span class="govuk-caption-l">Record management</span>
        <h1 class="govuk-heading-l">@ViewBag.Title</h1>
    </div>

    @if (Model.TotalTaskCount == 0)
    {
        <div class="govuk-grid-column-two-thirds" data-testid="no-tasks-message">
            <p class="govuk-body-l govuk-!-font-weight-bold govuk-!-margin-top-2 govuk-!-margin-bottom-3">
                There are no outstanding tasks
            </p>
        </div>
    }
    else
    {
        <div class="govuk-grid-column-two-thirds">
            <form method="get" asp-antiforgery="false" data-testid="search">
                <div class="govuk-!-margin-bottom-4">
                    <govuk-input for="Search" type="search">
                        <label>
                            <h2 class="govuk-heading-s govuk-!-margin-bottom-2">Search</h2>
                        </label>
                        <hint>
                            Enter a task ID, name, email address or request date, for example 31/3/2025
                        </hint>
                        <after-input>
                            <govuk-button class="govuk-!-margin-bottom-0 govuk-!-margin-left-2 trs-!-height-full" type="submit">Search</govuk-button>
                        </after-input>
                    </govuk-input>
                </div>
            </form>
        </div>
        <div class="govuk-grid-column-full">
            @if (Model.Results!.Count == 0)
            {
                <p class="govuk-body-l govuk-!-font-weight-bold govuk-!-margin-top-2 govuk-!-margin-bottom-3" data-testid="no-results-message">
                    No matching requests found
                </p>
                <p class="govuk-body-m">Try searching again with different details.</p>
            }
            else
            {
                <govuk-table class="trs-table-layout-fixed" sortable data-testid="results">
                    <table-head>
                        <table-head-cell class="trs-!-width-200"
                            sort-direction="@(Model.SortBy == OneLoginUserIdVerificationSupportTasksSortByOption.Name ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.OneLoginUserMatching.IdVerification(Model.Search, OneLoginUserIdVerificationSupportTasksSortByOption.Name, direction))">
                            Name and task ID
                        </table-head-cell>
                        <table-head-cell class="trs-!-width-130"
                            sort-direction="@(Model.SortBy == OneLoginUserIdVerificationSupportTasksSortByOption.RequestedOn ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.OneLoginUserMatching.IdVerification(Model.Search, OneLoginUserIdVerificationSupportTasksSortByOption.RequestedOn, direction))">
                            Requested on
                        </table-head-cell>
                        <table-head-cell class="trs-!-width-120">
                            Status
                        </table-head-cell>
                        <table-head-cell
                            sort-direction="@(Model.SortBy == OneLoginUserIdVerificationSupportTasksSortByOption.Email ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.OneLoginUserMatching.IdVerification(Model.Search, OneLoginUserIdVerificationSupportTasksSortByOption.Email, direction))">
                            Email address
                        </table-head-cell>
                        <table-head-cell class="trs-!-width-80"
                            sort-direction="@(Model.SortBy == OneLoginUserIdVerificationSupportTasksSortByOption.Source ? Model.SortDirection : null)"
                            link-template="@(direction => LinkGenerator.SupportTasks.OneLoginUserMatching.IdVerification(search: Model.Search, OneLoginUserIdVerificationSupportTasksSortByOption.Source, direction))">
                            Source
                        </table-head-cell>
                    </table-head>
                    @foreach (var result in Model.Results!)
                    {
                        <table-row data-testid="task:@result.SupportTaskReference">
                            <table-cell data-testid="task-name-and-id">
                                <a href="@LinkGenerator.SupportTasks.OneLoginUserMatching.Resolve.Index(result.SupportTaskReference)" class="govuk-link trs-task-link">
                                    <span class="trs-task-link__name" data-testid="task-name">@result.Name</span>
                                    <span class="trs-task-link__reference" data-testid="task-reference">@result.SupportTaskReference</span>
                                </a>
                            </table-cell>
                            <table-cell data-testid="requested-on">@result.CreatedOn.ToString(WebConstants.DateDisplayFormat)</table-cell>
                            <table-cell data-testid="status">
                                <support-task-status-tag status="@result.Status"/>
                            </table-cell>
                            <table-cell class="trs-break-word" data-testid="email">@result.EmailAddress</table-cell>
                            <table-cell data-testid="source">
                                <tag color="TagColor.Auto">@result.SourceApplicationName</tag>
                            </table-cell>
                        </table-row>
                    }
                </govuk-table>

                <govuk-pagination current-page="@Model.Pagination!.CurrentPage" total-pages="@Model.Pagination.LastPage" generate-page-href="@Model.Pagination.GetPageLink" />
            }
        </div>
    }
</div>
