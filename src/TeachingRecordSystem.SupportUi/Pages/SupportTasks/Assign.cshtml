@page "/support-tasks/assign"
@using Microsoft.AspNetCore.Http.Extensions
@model TeachingRecordSystem.SupportUi.Pages.SupportTasks.Assign
@{
    ViewBag.Title = "Assign tasks";

    var returnUrl = HttpContext.Request.GetEncodedPathAndQuery();
}

@section BeforeContent {
    <govuk-back-link href="@Model.BackLink" />
}

<span class="govuk-caption-m">Bulk assignment</span>
<h1 class="govuk-heading-l">@ViewBag.Title</h1>

<table class="govuk-table trs-table-layout-fixed">
    <caption class="govuk-table__caption govuk-table__caption--m">Selected tasks</caption>
    <thead class="govuk-table__head">
        <tr class="govuk-table__row">
            <th scope="col" class="govuk-table__header">Task</th>
            <th scope="col" class="govuk-table__header trs-!-width-150">Requested on</th>
            <th scope="col" class="govuk-table__header trs-!-width-180">Type</th>
            <th scope="col" class="govuk-table__header trs-!-width-120">Status</th>
            <th scope="col" class="govuk-table__header trs-!-width-150">Assigned to</th>
            <th scope="col" class="govuk-table__header trs-!-width-90">Source</th>
            <th scope="col" class="govuk-table__header trs-!-width-90">Action</th>
        </tr>
    </thead>
    <tbody class="govuk-table__body">
        @foreach (var task in Model.Tasks!)
        {
            <tr class="govuk-table__row">
                <th scope="row" class="govuk-table__cell">
                    <a href="@LinkGenerator.SupportTaskResolve(task.SupportTaskReference, task.Type, returnUrl: returnUrl)" class="govuk-link trs-task-link">
                        <span class="trs-task-link__name" data-testid="task-name">@task.Subject</span>
                        <span class="trs-task-link__reference" data-testid="task-reference">@task.SupportTaskReference</span>
                    </a>
                </th>
                <td class="govuk-table__cell">@task.CreatedOn.ToGmt().ToString(DateShortDisplayFormat)</td>
                <td class="govuk-table__cell">@task.Type.GetTitle()</td>
                <td class="govuk-table__cell">
                    <support-task-status-tag status="@task.Status"/>
                </td>
                <td class="govuk-table__cell">
                    @if (task.SourceApplicationName is not null)
                    {
                        <tag>@task.SourceApplicationName</tag>
                    }
                    else
                    {
                        <span use-empty-fallback="Not applicable"></span>
                    }
                </td>
                <td class="govuk-table__cell" use-empty-fallback="Unassigned">@task.AssignedTo</td><td class="govuk-table__cell">
                    <a href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(@task.SupportTaskReference, returnUrl: returnUrl)"
                       class="govuk-link">
                        Manage
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

<form method="post">
    <govuk-select for="AssignToUserId" select-class="govuk-!-width-one-third">
        <govuk-select-label class="govuk-label--s govuk-!-margin-bottom-2">Who do you want to assign these tasks to?</govuk-select-label>
        <govuk-select-item value=""></govuk-select-item>
        <govuk-select-item value="@Model.UnassignedUserId">Unassigned</govuk-select-item>
        @if (Model.ShowMyselfOption)
        {
            <govuk-select-item value="@Model.CurrentUserId">Myself</govuk-select-item>
        }
        @foreach (var assignOption in Model.AssignToOptions!)
        {
            <govuk-select-item value="@assignOption.UserId">@assignOption.UserName</govuk-select-item>
        }
    </govuk-select>

    <div class="govuk-button-group">
        <govuk-button type="submit">Assign tasks</govuk-button>
        <govuk-button-link href="@Model.BackLink" class="govuk-button--secondary">Cancel</govuk-button-link>
    </div>
</form>
