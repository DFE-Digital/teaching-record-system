@page "/routes/add/training-provider"
@model TeachingRecordSystem.SupportUi.Pages.RoutesToProfessionalStatus.AddRoute.TrainingProviderModel
@addTagHelper *, Joonasw.AspNetCore.SecurityHeaders
@{
    ViewBag.Title = "Enter the training provider for this route"
        + (Model.TrainingProviderRequired ? "" : " (optional)");
}

@section Scripts {
    <script asp-add-nonce="true">
        window.onload = function () {
            const selectElement = document.querySelector('#@nameof(Model.TrainingProviderId)');
            if (!selectElement) return;

            accessibleAutocomplete.enhanceSelectElement({
                defaultValue: '',
                selectElement: selectElement
            });

            setTimeout(() => {
                const inputElement = selectElement.parentElement.querySelector('.autocomplete__input');
                if (!inputElement) return;

                inputElement.addEventListener('input', () => {
                    if (inputElement.value === '') {
                        selectElement.value = '';
                    }
                });
            }, 0); // 0ms = defer to next event loop tick
        }
    </script>
}

@section BeforeContent {
    <govuk-back-link href=@(Model.BackLink)>Back</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">@Model.PageCaption</span>
            <govuk-select for="TrainingProviderId" label-class="govuk-label--l">
                <label is-page-heading="true">
                    @ViewBag.Title
                </label>
                <hint>Start typing the name of the training provider</hint>
                <select-item value=""></select-item>
                @foreach (var trainingProvider in Model.TrainingProviders)
                {
                    <select-item value="@trainingProvider.TrainingProviderId" selected="@Model.TrainingProviderId==trainingProvider.TrainingProviderId">@trainingProvider.Name</select-item>
                }
            </govuk-select>

            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button data-testid="cancel-button" name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
