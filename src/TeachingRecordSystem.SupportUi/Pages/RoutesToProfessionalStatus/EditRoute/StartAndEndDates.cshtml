@page "/routes/{qualificationId}/edit/start-and-end-date"
@model TeachingRecordSystem.SupportUi.Pages.RoutesToProfessionalStatus.EditRoute.StartAndEndDateModel
@{
    ViewBag.Title = "Enter the route start and end dates"
       + (Model.StartAndEndDatesRequired ? "" : " (optional)");
}

@section BeforeContent {
    <govuk-back-link data-testid="back-link" href="@Model.BackLink">Back</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">@Model.PageCaption</span>
            <govuk-fieldset>
                <legend is-page-heading="true" class="govuk-fieldset__legend--l">
                    @ViewBag.Title
                </legend>
                <govuk-date-input for="TrainingStartDate" error-message-prefix="Start date">
                    <legend class="govuk-fieldset__legend--m">
                        Route start date
                    </legend>
                    <hint>For example, 27 3 2023</hint>
                </govuk-date-input>

                <govuk-date-input for="TrainingEndDate" error-message-prefix="End date">
                    <legend class="govuk-fieldset__legend--m">
                        Route end date
                    </legend>
                    <hint>For example, 27 3 2024</hint>
                </govuk-date-input>
            </govuk-fieldset>


            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button data-testid="cancel-button" name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
