@page "/routes/{qualificationId}/edit/age-range"
@model TeachingRecordSystem.SupportUi.Pages.RoutesToProfessionalStatus.EditRoute.AgeRangeSpecialismModel
@{
    ViewBag.Title = "Edit age range specialism"
       + (Model.AgeRangeSpecialismRequired ? "" : " (optional)");
}
@section BeforeContent {
    <govuk-back-link data-testid="back-link" href="@Model.BackLink">Back</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">@Model.PageCaption</span>
            <govuk-radios for="@Model.TrainingAgeSpecialism.AgeRangeType">
                <legend is-page-heading="true" class="govuk-fieldset__legend--l">
                    @ViewBag.Title
                </legend>
                <radios-item value="@TrainingAgeSpecialismType.FoundationStage">@TrainingAgeSpecialismType.FoundationStage.GetDisplayName()</radios-item>
                <radios-item value="@TrainingAgeSpecialismType.KeyStage1">@TrainingAgeSpecialismType.KeyStage1.GetDisplayName()</radios-item>
                <radios-item value="@TrainingAgeSpecialismType.KeyStage2">@TrainingAgeSpecialismType.KeyStage2.GetDisplayName()</radios-item>
                <radios-item value="@TrainingAgeSpecialismType.KeyStage3">@TrainingAgeSpecialismType.KeyStage3.GetDisplayName()</radios-item>
                <radios-item value="@TrainingAgeSpecialismType.KeyStage4">@TrainingAgeSpecialismType.KeyStage4.GetDisplayName()</radios-item>
                <radios-item value="@TrainingAgeSpecialismType.FurtherEducation">@TrainingAgeSpecialismType.FurtherEducation.GetDisplayName()</radios-item>
                <divider>or</divider>
                <radios-item value="@TrainingAgeSpecialismType.Range">
                    Enter an age range
                    <conditional>
                        <govuk-input input-class="govuk-input--width-2" for="TrainingAgeSpecialism.AgeRangeFrom" />
                        <govuk-input input-class="govuk-input--width-2" for="TrainingAgeSpecialism.AgeRangeTo" />
                    </conditional>
                </radios-item>
            </govuk-radios>
            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button data-testid="cancel-button" name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
