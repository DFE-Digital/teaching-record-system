@page "/alerts/{alertId}/end-date/reason"
@model TeachingRecordSystem.SupportUi.Pages.Alerts.EditAlert.EndDate.ReasonModel
@{
    ViewBag.Title = "Why are you changing the end date?";
}

@section BeforeContent {
    @if (Model.BackLink is not null)
    {
        <govuk-back-link href="@Model.BackLink">Back</govuk-back-link>
    }
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">Change closed alert - @Model.PersonName</span>
            <h1 class="govuk-heading-l" data-testid="title">@ViewBag.Title</h1>

            <govuk-radios for="ChangeReason" data-testid="change-reason-options">
                <radios-item value="@AlertChangeEndDateReasonOption.IncorrectEndDate">
                    @AlertChangeEndDateReasonOption.IncorrectEndDate.GetDisplayName()
                </radios-item>
                <radios-item value="@AlertChangeEndDateReasonOption.ChangeOfEndDate">
                    @AlertChangeEndDateReasonOption.ChangeOfEndDate.GetDisplayName()
                </radios-item>
                <radios-item value="@AlertChangeEndDateReasonOption.AnotherReason">
                    @AlertChangeEndDateReasonOption.AnotherReason.GetDisplayName()
                </radios-item>
            </govuk-radios>

            <govuk-radios for="HasAdditionalReasonDetail">
                <legend>
                    <h2 class="govuk-fieldset__legend--m">Do you want to provide more information?</h2>
                </legend>
                <radios-item value="@true">
                    Yes
                    <conditional>
                        <govuk-character-count for="ChangeReasonDetail" max-length="UiDefaults.ReasonDetailsMaxCharacterCount" rows="UiDefaults.ReasonDetailsRows">
                            <label>Add additional detail</label>
                        </govuk-character-count>
                    </conditional>
                </radios-item>
                <radios-item value="@false">
                    No
                </radios-item>
            </govuk-radios>

            @Html.EditorFor(m => m.Evidence)

            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
