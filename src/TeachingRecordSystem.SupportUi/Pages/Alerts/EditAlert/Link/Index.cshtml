@page "/alerts/{alertId}/link"
@model TeachingRecordSystem.SupportUi.Pages.Alerts.EditAlert.Link.IndexModel

@section BeforeContent {
    @if (Model.BackLink is not null)
    {
        <govuk-back-link href="@Model.BackLink" />
    }
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">Edit alert - @Model.PersonName</span>

            <govuk-radios for="AddLink">
                <legend class="govuk-fieldset__legend--l">
                    @(Model.PreviousLink is not null ?
                        "Do you want to change or delete the link to the panel outcome?" :
                        "Do you want to add a link to a panel outcome?")
                </legend>
                <hint>
                    <a href="https://www.gov.uk/search/all?parent=&keywords=panel+outcome+misconduct&level_one_taxon=&manual=&organisations%5B%5D=teaching-regulation-agency&organisations%5B%5D=national-college-for-teaching-and-leadership&public_timestamp%5Bfrom%5D=&public_timestamp%5Bto%5D=&order=updated-newest" class="govuk-link" target="_blank" rel="noopener noreferrer">Panel outcomes (opens in a new tab)</a>
                    include details about the allegation, the panel’s decision and reasons for it. The link will only be seen internally.
                </hint>
                <radios-item value="@true">
                    @(Model.PreviousLink is not null ? "Change link" : "Yes")
                    <conditional>
                        <govuk-input for="Link">
                            <label>Enter link to panel outcome</label>
                        </govuk-input>
                    </conditional>
                </radios-item>
                <radios-item value="@false">
                    @(Model.PreviousLink is not null ? "Delete link" : "No")
                </radios-item>
            </govuk-radios>

            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
