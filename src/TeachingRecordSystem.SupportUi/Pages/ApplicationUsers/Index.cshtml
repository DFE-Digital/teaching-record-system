@page "/application-users"
@model TeachingRecordSystem.SupportUi.Pages.ApplicationUsers.IndexModel
@{
    ViewBag.Title = "Application users";
}

<h1 class="govuk-heading-l">@ViewBag.Title</h1>

<govuk-table>
    <table-head>
        <table-head-cell>Name</table-head-cell>
    </table-head>
    @if (Model.Users!.Length > 0)
    {
        @foreach (var user in Model.Users!)
        {
            <table-row data-testid="user-@user.UserId">
                <table-cell>
                    <a href="@LinkGenerator.ApplicationUsers.EditApplicationUser.Index(user.UserId)" class="govuk-link" data-testid="edit-application-user-@user.UserId">@user.Name</a>
                </table-cell>
            </table-row>
        }
    }
    else
    {
        <table-row data-testid="no-users">
            <table-cell>
                <div class="govuk-caption-m">No users</div>
            </table-cell>
        </table-row>
    }
</govuk-table>

<govuk-button-link href="@LinkGenerator.ApplicationUsers.AddApplicationUser.Index()" class="govuk-button--secondary" data-testid="add-application-user">Add application user</govuk-button-link>
