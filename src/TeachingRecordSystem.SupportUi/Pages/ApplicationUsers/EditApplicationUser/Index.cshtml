@page "/application-users/{userId}"
@addTagHelper *, Joonasw.AspNetCore.SecurityHeaders
@model TeachingRecordSystem.SupportUi.Pages.ApplicationUsers.EditApplicationUser.IndexModel
@inject TimeProvider TimeProvider
@{
    ViewBag.Title = $"Edit {Model.Name}";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.ApplicationUsers.Index()" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <h1 class="govuk-heading-l">@ViewBag.Title</h1>

            <govuk-input for="Name">
                <label class="govuk-label--m">Name</label>
            </govuk-input>

            <govuk-input for="ShortName" input-class="govuk-input--width-10">
                <label class="govuk-label--m">Short name</label>
            </govuk-input>

            <govuk-checkboxes for="ApiRoles">
                <legend class="govuk-fieldset__legend--m">API roles</legend>
                @foreach (var role in ApiRoles.All.OrderBy(r => r))
                {
                    <checkboxes-item value="@role">@role</checkboxes-item>
                }
            </govuk-checkboxes>

            <h2 class="govuk-heading-m">API keys</h2>
            <govuk-table class="govuk-!-margin-bottom-3" data-testid="ApiKeysTable">
                <table-head>
                    <table-head-cell>Key ID</table-head-cell>
                    <table-head-cell class="govuk-!-width-one-third">Expires</table-head-cell>
                </table-head>
                @if (Model.ApiKeys!.Length > 0)
                {
                    @foreach (var key in Model.ApiKeys)
                    {
                        <table-row>
                            <table-cell>
                                <a href="@LinkGenerator.ApiKeys.EditApiKey.Index(key.ApiKeyId)" class="govuk-link trs-monospace" data-testid="EditApiKey-@key.ApiKeyId">@key.ApiKeyId</a>
                            </table-cell>
                            <table-cell data-testid="Expiry">
                                @if (key.Expires is DateTime expires)
                                {
                                    <time datetime="@expires.ToString("s")">
                                        <span class="@(expires < TimeProvider.UtcNow ? "govuk-caption-m" : "")">
                                            @expires.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    </time>
                                }
                                else
                                {
                                    <div class="govuk-caption-m">No expiration</div>
                                }
                            </table-cell>
                        </table-row>
                    }
                }
                else
                {
                    <table-row>
                        <table-cell colspan="2">
                            <div class="govuk-caption-m">No API keys</div>
                        </table-cell>
                    </table-row>
                }
            </govuk-table>

            <div class="govuk-!-margin-bottom-1">
                <govuk-button-link href="@LinkGenerator.ApiKeys.AddApiKey.Index(Model.UserId)" class="govuk-button--secondary" data-testid="AddApiKey">Add API key</govuk-button-link>
            </div>

            <govuk-checkboxes for="IsOidcClient">
                <checkboxes-item value="@true" label-class="govuk-label--m">
                    OIDC client
                    <conditional>
                        <govuk-input for="ClientId" input-class="govuk-!-width-two-thirds trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">Client ID</label>
                        </govuk-input>

                        <govuk-password-input for="ClientSecret" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">Client secret</label>
                        </govuk-password-input>

                        <govuk-textarea for="RedirectUris" textarea-class="trs-monospace trs-nowrap">
                            <label class="govuk-label--s">Redirect URIs</label>
                            <hint>Enter one per line</hint>
                            <value>@string.Join("\n", Model.RedirectUris!)</value>
                        </govuk-textarea>

                        <govuk-textarea for="PostLogoutRedirectUris" textarea-class="trs-monospace trs-nowrap">
                            <label class="govuk-label--s">Post logout redirect URIs</label>
                            <hint>Enter one per line</hint>
                            <value>@string.Join("\n", Model.PostLogoutRedirectUris!)</value>
                        </govuk-textarea>

                        <govuk-input for="OneLoginAuthenticationSchemeName" input-class="govuk-!-width-two-thirds trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">Authentication scheme name</label>
                        </govuk-input>

                        <govuk-input for="OneLoginClientId" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">One Login client ID</label>
                        </govuk-input>

                        <govuk-radios for="UseSharedOneLoginSigningKeys">
                            <legend class="govuk-fieldset__legend--s">
                                Use shared One Login signing keys (<span class="trs-monospace">/one-login-jwks</span>)
                            </legend>
                            <radios-item value="@true">Yes</radios-item>
                            <radios-item value="@false">
                                No
                                <conditional>
                                    <govuk-textarea for="OneLoginPrivateKeyPem" textarea-class="trs-monospace trs-nowrap" spellcheck="false">
                                        <label class="govuk-label--s">One Login private key</label>
                                        <hint>Enter a key in the PEM format</hint>
                                    </govuk-textarea>
                                </conditional>
                            </radios-item>
                        </govuk-radios>

                        <govuk-input for="OneLoginRedirectUriPath" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">One Login redirect URI path</label>
                        </govuk-input>

                        <govuk-input for="OneLoginPostLogoutRedirectUriPath" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">One Login post logout redirect URI path</label>
                        </govuk-input>

                        <govuk-radios for="RecordMatchingPolicy">
                            <legend class="govuk-fieldset__legend--s">
                                Record matching policy
                            </legend>
                            <radios-item value="@RecordMatchingPolicy.Required">
                                Required
                                <hint>Users must be matched to a teaching record to sign in</hint>
                            </radios-item>
                            <radios-item value="@RecordMatchingPolicy.Deferred">
                                Deferred
                                <hint>Users can sign in without a teaching record and be allocated one later</hint>
                            </radios-item>
                        </govuk-radios>

                        <h3 class="govuk-heading-s">App content</h3>

                        <govuk-input for="SignInUrl" input-class="trs-monospace" type="url" spellcheck="false">
                            <label class="govuk-label--s">Sign in URL</label>
                        </govuk-input>

                        <govuk-input for="SupportEmailAddressNotifyId" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">Support email address Notify ID</label>
                            <hint>The GOV.UK Notify reply-to email address ID for support emails. Leave blank to use default.</hint>
                        </govuk-input>

                        <govuk-input for="SupportEmailAddress" input-class="govuk-!-width-two-thirds" type="email" spellcheck="false">
                            <label class="govuk-label--s">Support email address</label>
                            <hint>The support email address for display in page footers. Leave blank to use default.</hint>
                        </govuk-input>

                        <govuk-input for="OneLoginCannotFindRecordEmailTemplateId" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘cannot find record’ email template ID</label>
                            <hint>Leave blank to use default template</hint>
                        </govuk-input>

                        <govuk-input for="OneLoginNotVerifiedEmailTemplateId" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘not verified’ email template ID</label>
                            <hint>Leave blank to use default template</hint>
                        </govuk-input>

                        <govuk-input for="OneLoginRecordMatchedEmailTemplateId" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘record matched’ email template ID</label>
                            <hint>Leave blank to use default template</hint>
                        </govuk-input>

                        <govuk-input for="OneLoginNotConnectedEmailTemplateId" input-class="trs-monospace" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘not connected’ email template ID</label>
                            <hint>Leave blank to use default template</hint>
                        </govuk-input>

                        <govuk-textarea for="OneLoginNoMatchesPageContentHtml" textarea-class="govuk-!-width-full trs-monospace" rows="10" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘no matches’ page content</label>
                            <hint>HTML content shown on the No Matches page when a user cannot be matched to a teaching record. Leave blank to use default content.</hint>
                        </govuk-textarea>

                        <govuk-textarea for="OneLoginNoMatchesEmailSentFlashMessage" textarea-class="govuk-!-width-full trs-monospace" rows="3" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘no matches’ email sent flash message</label>
                            <hint>Flash message shown when email is sent on No Matches page. Use {0} placeholder for name. Leave blank to use default message.</hint>
                        </govuk-textarea>

                        <govuk-textarea for="OneLoginNotConnectedEmailSentFlashMessage" textarea-class="govuk-!-width-full trs-monospace" rows="3" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘not connected’ email sent flash message</label>
                            <hint>Flash message shown when email is sent on Not Connecting page (deferred policy only). Use {0} placeholder for name. Leave blank to use default message.</hint>
                        </govuk-textarea>

                        <govuk-textarea for="OneLoginFoundPageLinkText" textarea-class="govuk-!-width-full trs-monospace" rows="3" spellcheck="false">
                            <label class="govuk-label--s">One Login - ‘found’ page link text</label>
                            <hint>HTML text with link shown on the Found page. Use {0} placeholder for continue URL. Leave blank to use default text.</hint>
                        </govuk-textarea>
                    </conditional>
                </checkboxes-item>
            </govuk-checkboxes>

            <govuk-button type="submit">Save changes</govuk-button>
        </form>
    </div>
</div>
