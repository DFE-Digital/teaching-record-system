@page "/mqs/{qualificationId}/start-date/reason"
@model TeachingRecordSystem.SupportUi.Pages.Mqs.EditMq.StartDate.ReasonModel
@{
    ViewBag.Title = Html.DisplayNameFor(m => m.ChangeReason);
}

@section BeforeContent {
    @if (Model.BackLink is not null)
    {
        <govuk-back-link href="@Model.BackLink" />
    }
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">Edit mandatory qualification - @Model.PersonName</span>

            <govuk-radios for="ChangeReason" data-testid="change-reason-options">
                <legend class="govuk-fieldset__legend--l" is-page-heading="true" data-testid="change-reason-options-legend">Why are you changing the start date?</legend>
                <radios-item value="@MqChangeStartDateReasonOption.IncorrectStartDate">
                    @MqChangeStartDateReasonOption.IncorrectStartDate.GetDisplayName()
                </radios-item>
                <radios-item value="@MqChangeStartDateReasonOption.ChangeOfStartDate">
                    @MqChangeStartDateReasonOption.ChangeOfStartDate.GetDisplayName()
                </radios-item>
                <radios-item value="@MqChangeStartDateReasonOption.UnableToConfirmIfTheDataIsCorrect">
                    @MqChangeStartDateReasonOption.UnableToConfirmIfTheDataIsCorrect.GetDisplayName()
                </radios-item>
                <radios-item value="@MqChangeStartDateReasonOption.AnotherReason">
                    @MqChangeStartDateReasonOption.AnotherReason.GetDisplayName()
                    <conditional data-testid="start-date-reason-detail">
                        <govuk-input data-testid="reason-detail" for="ChangeReasonDetail" input-class="govuk-input--width-20" spellcheck="false">
                            <label>Enter a reason</label>
                        </govuk-input>
                    </conditional>
                </radios-item>
            </govuk-radios>

            <govuk-radios for="ProvideAdditionalInformation" data-testid="has-additional-reason_detail-options">
                <legend><h2 class="govuk-fieldset__legend--m">Do you want to provide more information?</h2></legend>
                <radios-item value="@true">
                    Yes
                    <conditional data-testid="additional-detail">
                        <govuk-character-count for="AdditionalInformation" max-length="UiDefaults.ReasonDetailsMaxCharacterCount" rows="UiDefaults.ReasonDetailsRows">
                            <label>Enter details</label>
                        </govuk-character-count>
                    </conditional>
                </radios-item>
                <radios-item value="@false">
                    No
                </radios-item>
            </govuk-radios>

            @Html.EditorFor(m => m.Evidence)

            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
