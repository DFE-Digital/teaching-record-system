@page "/mqs/{qualificationId}/delete"
@model TeachingRecordSystem.SupportUi.Pages.Mqs.DeleteMq.IndexModel
@{
    ViewBag.Title = Html.DisplayNameFor(m => m.DeletionReason);
}

@section BeforeContent {
    @if (Model.BackLink is not null)
    {
        <govuk-back-link href="@Model.BackLink">Back</govuk-back-link>
    }
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">Delete mandatory qualification - @Model.PersonName</span>

            <govuk-radios for="DeletionReason" data-testid="deletion-reason-options">
                <legend class="govuk-fieldset__legend--l" is-page-heading="true" data-testid="change-reason-options-legend">Why are you deleting this mandatory qualification?</legend>
                <radios-item value="@MqDeletionReasonOption.AddedInError">
                    @MqDeletionReasonOption.AddedInError.GetDisplayName()
                </radios-item>
                <radios-item value="@MqDeletionReasonOption.ProviderRequest">
                    @MqDeletionReasonOption.ProviderRequest.GetDisplayName()
                </radios-item>
                <radios-item value="@MqDeletionReasonOption.AnotherReason">
                    @MqDeletionReasonOption.AnotherReason.GetDisplayName()
                    <conditional data-testid="delete-reason-detail">
                        <govuk-input data-testid="reason-detail" for="DeletionReasonDetail" input-class="govuk-input--width-20" spellcheck="false">
                            <label>Enter a reason</label>
                        </govuk-input>
                    </conditional>
                </radios-item>
            </govuk-radios>

            <govuk-radios for="ProvideAdditionalInformation" data-testid="has-additional-reason_detail-options">
                <legend class="govuk-fieldset__legend--m">Do you want to provide more information?</legend>
                <radios-item value="@true">
                    Yes
                    <conditional data-testid="additional-detail">
                        <govuk-character-count for="AdditionalInformation" max-length="UiDefaults.ReasonDetailsMaxCharacterCount" rows="UiDefaults.ReasonDetailsRows">
                            <label>Enter details</label>
                        </govuk-character-count>
                    </conditional>
                </radios-item>
                <radios-item value="@false">
                    No
                </radios-item>
            </govuk-radios>

            @Html.EditorFor(m => m.Evidence)

            <div class="govuk-button-group">
                <govuk-button type="submit">Continue</govuk-button>
                <govuk-button name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
