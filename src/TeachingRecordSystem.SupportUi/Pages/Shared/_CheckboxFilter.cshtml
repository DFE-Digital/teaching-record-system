@model CheckboxFilterViewModel

<govuk-checkboxes id-prefix="trs-filters-@Model.Name" name=@Model.Name checkboxes-class="govuk-checkboxes--small">
    <legend class="govuk-fieldset__legend--s">
        @Model.DisplayName
    </legend>

    @foreach (var value in Model.Values)
    {
        <checkboxes-item value=@value.Name checked=@value.Selected>
            @value.DisplayName (@value.Count)
        </checkboxes-item>
    }
</govuk-checkboxes>
