@model PaginationViewModel

@if (Model.ShowPagination)
{
    <govuk-pagination>
        @if (Model.ShowPreviousPage)
        {
            <previous href="@Html.Raw(Model.GetPageLink(Model.PreviousPage))" />
        }

        @if (Model.ShowFirstPage)
        {
            <pagination-item href="@Html.Raw(Model.GetPageLink(Model.FirstPage))">@Model.FirstPage</pagination-item>
            if (Model.ShowFirstPageEllipsis)
            {
                <ellipsis />
            }
        }

        @if (Model.ShowPreviousPage)
        {
            <pagination-item href="@Html.Raw(Model.GetPageLink(Model.PreviousPage))">@Model.PreviousPage</pagination-item>
        }

        <pagination-item href="@Html.Raw(Model.GetPageLink(Model.CurrentPage))" current=@true>@Model.CurrentPage</pagination-item>

        @if (Model.ShowNextPage)
        {
            <pagination-item href="@Html.Raw(Model.GetPageLink(Model.NextPage))">@Model.NextPage</pagination-item>
        }

        @if (Model.ShowLastPage)
        {
            if (Model.ShowLastPageEllipsis)
            {
                <ellipsis />
            }
            <pagination-item href="@Html.Raw(Model.GetPageLink(Model.LastPage))">@Model.LastPage</pagination-item>
        }

        @if (Model.ShowNextPage)
        {
            <next href="@Html.Raw(Model.GetPageLink(Model.NextPage))" />
        }
    </govuk-pagination>
}
