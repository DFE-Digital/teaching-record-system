@model PaginationViewModel

@if (Model.ShowPagination)
{
    <govuk-pagination>
        @if (Model.ShowPreviousPage)
        {
            <govuk-pagination-previous href="@Html.Raw(Model.GetPageLink(Model.PreviousPage))" htmx="@Model.Htmx" />
        }

        @if (Model.ShowFirstPage)
        {
            <govuk-pagination-item href="@Html.Raw(Model.GetPageLink(Model.FirstPage))" htmx="@Model.Htmx">@Model.FirstPage</govuk-pagination-item>
            if (Model.ShowFirstPageEllipsis)
            {
                <govuk-pagination-ellipsis />
            }
        }

        @if (Model.ShowPreviousPage)
        {
            <govuk-pagination-item href="@Html.Raw(Model.GetPageLink(Model.PreviousPage))" htmx="@Model.Htmx">@Model.PreviousPage</govuk-pagination-item>
        }

        <govuk-pagination-item href="@Html.Raw(Model.GetPageLink(Model.CurrentPage))" htmx="@Model.Htmx" current=@true>@Model.CurrentPage</govuk-pagination-item>

        @if (Model.ShowNextPage)
        {
            <govuk-pagination-item href="@Html.Raw(Model.GetPageLink(Model.NextPage))" htmx="@Model.Htmx">@Model.NextPage</govuk-pagination-item>
        }

        @if (Model.ShowLastPage)
        {
            if (Model.ShowLastPageEllipsis)
            {
                <govuk-pagination-ellipsis />
            }
            <govuk-pagination-item href="@Html.Raw(Model.GetPageLink(Model.LastPage))" htmx="@Model.Htmx">@Model.LastPage</govuk-pagination-item>
        }

        @if (Model.ShowNextPage)
        {
            <govuk-pagination-next href="@Html.Raw(Model.GetPageLink(Model.NextPage))" htmx="@Model.Htmx" />
        }
    </govuk-pagination>
}
