@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.SupportUi.Services.ChangeHistory
@model ChangeHistoryEntryViewModel
@{
    var personDeactivatedEvent = Model.GetEvent<PersonDeactivatedEvent>();
    var deactivatedPersonId = personDeactivatedEvent.PersonId;
    var retainedPersonId = personDeactivatedEvent.MergedWithPersonId!.Value;
    var deactivatedPersonTrn = Model.Context.GetPersonInfo(deactivatedPersonId).Trn;
    var retainedPersonTrn = Model.Context.GetPersonInfo(retainedPersonId).Trn;

    var hasPersonDetailsUpdatedEvent = Model.TryGetEvent<PersonDetailsUpdatedEvent>(out var personDetailsUpdatedEvent);
    var supportTaskUpdatedEvent = Model.GetEvent<SupportTaskUpdatedEvent>();
    var supportTaskReference = supportTaskUpdatedEvent.SupportTaskReference;
    var hasSupportTaskCreatedEvent = Model.TryGetEvent<SupportTaskCreatedEvent>(out var supportTaskCreatedEvent);

    var isDeactivatedPersonContext = Model.Context.ContextType == ChangeHistoryContextType.Person && Model.Context.PersonId == deactivatedPersonId;
    var isRetainedPersonContext = Model.Context.ContextType == ChangeHistoryContextType.Person && Model.Context.PersonId == retainedPersonId;
    var isSupportTaskContext = Model.Context.ContextType == ChangeHistoryContextType.SupportTask;

    var showPersonDetailsChanges = hasPersonDetailsUpdatedEvent && (isRetainedPersonContext || isSupportTaskContext);
}

<timeline-entry title="Teachers’ Pensions potential duplicate task resolved" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="merge-message">
        @if (isDeactivatedPersonContext)
        {
            @:Record merged into TRN <a href="@LinkGenerator.Persons.PersonDetail.Index(retainedPersonId)" class="govuk-link" target="_blank" data-testid="retained-person-link">@retainedPersonTrn <span class="govuk-visually-hidden">(opens in new tab)</span></a> and deactivated.
        }
        else if (isRetainedPersonContext)
        {
            @:Record merged with TRN <a href="@LinkGenerator.Persons.PersonDetail.Index(deactivatedPersonId)" class="govuk-link" target="_blank" data-testid="deactivated-person-link">@deactivatedPersonTrn <span class="govuk-visually-hidden">(opens in new tab)</span></a>.
        }
        else
        {
            @:TRN <a href="@LinkGenerator.Persons.PersonDetail.Index(deactivatedPersonId)" class="govuk-link" target="_blank" data-testid="deactivated-person-link">@deactivatedPersonTrn <span class="govuk-visually-hidden">(opens in new tab)</span></a> merged with TRN <a href="@LinkGenerator.Persons.PersonDetail.Index(retainedPersonId)" class="govuk-link" target="_blank" data-testid="retained-person-link">@retainedPersonTrn <span class="govuk-visually-hidden">(opens in new tab)</span></a> and deactivated.
        }
    </p>

    @if (showPersonDetailsChanges)
    {
        var details = personDetailsUpdatedEvent!.PersonDetails;
        var oldDetails = personDetailsUpdatedEvent.OldPersonDetails;
        var name = string.JoinNonEmpty(' ', details.FirstName, details.MiddleName, details.LastName);
        var oldName = string.JoinNonEmpty(' ', oldDetails.FirstName, oldDetails.MiddleName, oldDetails.LastName);
        var email = EmailAddress.TryParse(details.EmailAddress, out var parsedEmail)
            ? parsedEmail.ToDisplayString()
            : details.EmailAddress;
        var oldEmail = EmailAddress.TryParse(oldDetails.EmailAddress, out var oldParsedEmail)
            ? oldParsedEmail.ToDisplayString()
            : oldDetails.EmailAddress;
        var nino = NationalInsuranceNumber.TryParse(details.NationalInsuranceNumber, out var parsedNino)
            ? parsedNino.ToDisplayString()
            : details.NationalInsuranceNumber;
        var oldNino = NationalInsuranceNumber.TryParse(oldDetails.NationalInsuranceNumber, out var oldParsedNino)
            ? oldParsedNino.ToDisplayString()
            : oldDetails.NationalInsuranceNumber;

        if (personDetailsUpdatedEvent.Changes.HasAnyFlag(PersonDetailsUpdatedEventChanges.NameChange))
        {
            <p class="govuk-body" data-testid="name">Name changed from @oldName to @name</p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.DateOfBirth))
        {
            <p class="govuk-body" data-testid="date-of-birth">
                Date of birth changed from @oldDetails.DateOfBirth?.ToString(WebConstants.DateDisplayFormat) to @details.DateOfBirth?.ToString(WebConstants.DateDisplayFormat)
            </p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.EmailAddress))
        {
            <p class="govuk-body" data-testid="email-address">Email address changed from @oldEmail to @email</p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.NationalInsuranceNumber))
        {
            <p class="govuk-body" data-testid="national-insurance-number">National Insurance number changed from @oldNino to @nino</p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.Gender))
        {
            <p class="govuk-body" data-testid="gender">Gender changed from @oldDetails.Gender?.GetDisplayName() to @details.Gender?.GetDisplayName()</p>
        }
    }

    <p class="govuk-body" data-testid="task-closed-message">
        @if (!isSupportTaskContext)
        {
            <a class="govuk-link" href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(supportTaskReference)" data-testid="support-task-link">
                Task<span class="govuk-visually-hidden"> @supportTaskReference</span>
            </a>
            <text> closed.</text>
        }
        else
        {
            <text>Task closed.</text>
        }
    </p>

    @if (hasSupportTaskCreatedEvent)
    {
        var createdTaskReference = supportTaskCreatedEvent!.SupportTask.SupportTaskReference;

        <p class="govuk-body" data-testid="support-task-created-message">
            @if (!isSupportTaskContext)
            {
                <text>TRN request manual checks needed task <a href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(createdTaskReference)" class="govuk-link" target="_blank" data-testid="created-task-link">@createdTaskReference <span class="govuk-visually-hidden">(opens in new tab)</span></a> was created.</text>
            }
            else
            {
                <text>TRN request manual checks needed support task @createdTaskReference was created.</text>
            }
        </p>
    }

    @if (!string.IsNullOrEmpty(supportTaskUpdatedEvent.Comments))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="change-reason">
            <summary>Reason for change</summary>
            <text>
                <govuk-summary-list>
                    <row>
                        <key>Reason</key>
                        <value use-empty-fallback data-testid="reason">@supportTaskUpdatedEvent.Comments</value>
                    </row>
                </govuk-summary-list>
            </text>
        </govuk-details>
    }
</timeline-entry>
