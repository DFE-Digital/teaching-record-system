@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.SupportUi.Services.ChangeHistory
@model ChangeHistoryEntryViewModel
@{
    var hasTrnRequestUpdatedEvent = Model.TryGetEvent<TrnRequestUpdatedEvent>(out var trnRequestUpdatedEvent);
    var trnRequest = trnRequestUpdatedEvent?.TrnRequest;

    var hasPersonCreatedEvent = Model.TryGetEvent<PersonCreatedEvent>(out var personCreatedEvent);
    var hasSupportTaskCreatedEvent = Model.TryGetEvent<SupportTaskCreatedEvent>(out var supportTaskCreatedEvent);
    var hasOneLoginUpdatedEvent = Model.TryGetEvent<OneLoginUserUpdatedEvent>(out var oneLoginUpdatedEvent);

    var isPersonContext = Model.Context.ContextType == ChangeHistoryContextType.Person;
    var isSupportTaskContext = Model.Context.ContextType == ChangeHistoryContextType.SupportTask;
    var isOneLoginContext = Model.Context.ContextType == ChangeHistoryContextType.OneLogin;

    var matchedPersonId = hasPersonCreatedEvent
        ? personCreatedEvent!.PersonId
        : trnRequest?.ResolvedPersonId ?? oneLoginUpdatedEvent?.OneLoginUser.PersonId ?? supportTaskCreatedEvent?.SupportTask.PersonId;
    var matchedPersonInfo = matchedPersonId is not null ? Model.Context.TryGetPersonInfo(matchedPersonId.Value) : null;
    var matchedPersonLinkText = matchedPersonInfo is not null ? $"{matchedPersonInfo.FirstName} {matchedPersonInfo.LastName}" : null;

    var oneLoginEmail = oneLoginUpdatedEvent?.OneLoginUser.EmailAddress;
    var oneLoginSubject = oneLoginUpdatedEvent?.OneLoginUser.Subject;
}

<timeline-entry title="TRN request activated" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    @if (hasPersonCreatedEvent || matchedPersonId is not null)
    {
        <p class="govuk-body" data-testid="trn-request-summary">
            @if (hasPersonCreatedEvent)
            {
                @:Record created when a dormant TRN request was activated.
            }
            else if (!isPersonContext)
            {
                @:Dormant TRN request was activated and matched to <a href="@LinkGenerator.Persons.PersonDetail.Index(matchedPersonId!.Value)" class="govuk-link" target="_blank" data-testid="matched-person-link">@(matchedPersonLinkText ?? "a record") <span class="govuk-visually-hidden">(opens in new tab)</span></a>.
            }
            else
            {
                @:A dormant TRN request was activated and matched to this record.
            }
        </p>
    }

    @if (hasPersonCreatedEvent)
    {
        <partial name="~/Pages/Shared/Components/ChangeHistoryEntry/_PersonDetailsSummary.cshtml" model="@personCreatedEvent!.Details" />
    }

    @if (hasSupportTaskCreatedEvent)
    {
        var createdTaskReference = supportTaskCreatedEvent!.SupportTask.SupportTaskReference;
        var createdTaskType = supportTaskCreatedEvent.SupportTask.SupportTaskType;
        var taskTypeDescription = createdTaskType == SupportTaskType.TrnRequestManualChecksNeeded
            ? "TRN request manual checks needed support task"
            : "TRN request support task";

        <p class="govuk-body" data-testid="support-task-created-message">
            @if (!isSupportTaskContext)
            {
                <text>@taskTypeDescription <a href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(createdTaskReference)" class="govuk-link" target="_blank" data-testid="created-task-link">@createdTaskReference <span class="govuk-visually-hidden">(opens in new tab)</span></a> was created.</text>
            }
            else
            {
                <text>@taskTypeDescription @createdTaskReference was created.</text>
            }
        </p>
    }

    @if (hasOneLoginUpdatedEvent
        && oneLoginUpdatedEvent!.OneLoginUser.PersonId is not null
        && matchedPersonInfo is not null)
    {
        <p class="govuk-body" data-testid="one-login-matched-message">
            @if (isSupportTaskContext)
            {
                @:GOV.UK One Login <a href="@LinkGenerator.OneLogins.OneLoginDetail.Index(oneLoginSubject!)" class="govuk-link" target="_blank" data-testid="one-login-link">@oneLoginEmail <span class="govuk-visually-hidden">(opens in new tab)</span></a> matched to <a href="@LinkGenerator.Persons.PersonDetail.Index(oneLoginUpdatedEvent.OneLoginUser.PersonId.Value)" class="govuk-link" target="_blank" data-testid="person-link">@matchedPersonLinkText <span class="govuk-visually-hidden">(opens in new tab)</span></a>.
            }
            else if (isPersonContext)
            {
                @:GOV.UK One Login <a href="@LinkGenerator.OneLogins.OneLoginDetail.Index(oneLoginSubject!)" class="govuk-link" target="_blank" data-testid="one-login-link">@oneLoginEmail <span class="govuk-visually-hidden">(opens in new tab)</span></a> matched to a record.
            }
            else if (isOneLoginContext)
            {
                @:GOV.UK One Login @oneLoginEmail matched to <a href="@LinkGenerator.Persons.PersonDetail.Index(oneLoginUpdatedEvent.OneLoginUser.PersonId.Value)" class="govuk-link" target="_blank" data-testid="person-link">@matchedPersonLinkText <span class="govuk-visually-hidden">(opens in new tab)</span></a>.
            }
        </p>
    }
</timeline-entry>
