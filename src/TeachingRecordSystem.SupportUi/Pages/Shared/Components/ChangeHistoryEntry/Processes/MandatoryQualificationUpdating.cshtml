@using Microsoft.AspNetCore.Html
@using TeachingRecordSystem.Core.Events.ChangeReasons
@model ChangeHistoryEntryViewModel
@{
    var updatedEvent = Model.GetEvent<MandatoryQualificationUpdatedEvent>();
    var mandatoryQualification = updatedEvent.MandatoryQualification;
    var oldMandatoryQualification = updatedEvent.OldMandatoryQualification;
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
}

<timeline-entry title="Mandatory qualification updated" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    @if (updatedEvent.Changes.HasFlag(MandatoryQualificationUpdatedEventChanges.Provider))
    {
        <p class="govuk-body">
            Training provider changed from @ToDisplayValueOrFallback(oldMandatoryQualification.Provider?.Name ?? oldMandatoryQualification.Provider?.DqtMqEstablishmentName) to @ToDisplayValueOrFallback(mandatoryQualification.Provider?.Name ?? mandatoryQualification.Provider?.DqtMqEstablishmentName)
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(MandatoryQualificationUpdatedEventChanges.Specialism))
    {
        <p class="govuk-body">
            Specialism changed from @ToDisplayValueOrFallback(oldMandatoryQualification.Specialism?.GetTitle()) to @ToDisplayValueOrFallback(mandatoryQualification.Specialism?.GetTitle())
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(MandatoryQualificationUpdatedEventChanges.StartDate))
    {
        <p class="govuk-body">
            Start date changed from @ToDisplayValueOrFallback(oldMandatoryQualification.StartDate?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(mandatoryQualification.StartDate?.ToString(WebConstants.DateDisplayFormat))
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(MandatoryQualificationUpdatedEventChanges.Status))
    {
        <p class="govuk-body">
            Status changed from @ToDisplayValueOrFallback(oldMandatoryQualification.Status?.GetTitle()) to @ToDisplayValueOrFallback(mandatoryQualification.Status?.GetTitle())
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(MandatoryQualificationUpdatedEventChanges.EndDate))
    {
        <p class="govuk-body">
            End date changed from @ToDisplayValueOrFallback(oldMandatoryQualification.EndDate?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(mandatoryQualification.EndDate?.ToString(WebConstants.DateDisplayFormat))
        </p>
    }

    @functions {
        private static IHtmlContent ToDisplayValueOrFallback(string? value)
        {
            if (string.IsNullOrEmpty(value))
            {
                return new HtmlString("<span class=\"trs-empty-fallback\">None</span>");
            }

            return new HtmlString(System.Net.WebUtility.HtmlEncode(value));
        }
    }

    @if (changeReason is not null && (!string.IsNullOrEmpty(changeReason.Reason) || !string.IsNullOrEmpty(changeReason.Details)))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="reason-for-change">
            <govuk-details-summary>Reason for change</govuk-details-summary>
            <govuk-details-text>
                <govuk-summary-list>
                    <row>
                        <key>Reason details</key>
                        <value data-testid="change-reason" use-empty-fallback>
                            @if (changeReason.Reason == "Another reason" && !string.IsNullOrEmpty(changeReason.Details))
                            {
                                @Html.ConvertNewlinesToLineBreaks($"{changeReason.Reason}: {changeReason.Details}")
                            }
                            else
                            {
                                @changeReason.Reason
                            }
                        </value>
                    </row>
                    <row>
                        <key>Additional information</key>
                        <value data-testid="additional-information" use-empty-fallback>
                            @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                        </value>
                    </row>
                    @if (changeReason.EvidenceFile is not null)
                    {
                        <row>
                            <key>Evidence</key>
                            <value data-testid="evidence">
                                <vc:event-evidence-file-link evidence-file="@changeReason.EvidenceFile" />
                            </value>
                        </row>
                    }
                </govuk-summary-list>
            </govuk-details-text>
        </govuk-details>
    }
</timeline-entry>
