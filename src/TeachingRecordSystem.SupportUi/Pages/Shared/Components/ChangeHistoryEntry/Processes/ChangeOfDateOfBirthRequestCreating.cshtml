@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Models.SupportTasks
@model ChangeHistoryEntryViewModel
@{
    var supportTaskCreatedEvent = Model.GetEvent<SupportTaskCreatedEvent>();
    var changeRequestData = (ChangeDateOfBirthRequestData)supportTaskCreatedEvent.SupportTask.Data;
    var requestedDateOfBirth = changeRequestData.DateOfBirth.ToString(WebConstants.DateDisplayFormat);
}

<timeline-entry title="Change of date of birth request created" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="change-request-context">
        Request to change date of birth to <strong>@requestedDateOfBirth</strong>.
    </p>
</timeline-entry>
