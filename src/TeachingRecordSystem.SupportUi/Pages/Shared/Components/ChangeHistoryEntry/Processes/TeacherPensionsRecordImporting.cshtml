@model ChangeHistoryEntryViewModel
@{
    // The import creates a person, raises a potential duplicate task, or both, so neither event is guaranteed.
    var hasCreatedEvent = Model.TryGetEvent<PersonCreatedEvent>(out var createdEvent);
    var raisedDuplicateTask = Model.ContainsEvent<SupportTaskCreatedEvent>();

    var details = createdEvent?.Details;
}

<timeline-entry title="Record imported from Teachers’ Pensions" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="import-summary">
        @if (hasCreatedEvent)
        {
            @:Record created from the Teachers’ Pensions import@(raisedDuplicateTask ? " and flagged as a potential duplicate." : ".")
        }
        else
        {
            @:Teachers’ Pensions record flagged as a potential duplicate.
        }
    </p>

    @if (hasCreatedEvent)
    {
        <partial name="~/Pages/Shared/Components/ChangeHistoryEntry/_PersonDetailsSummary.cshtml" model="@details!" />
    }
</timeline-entry>
