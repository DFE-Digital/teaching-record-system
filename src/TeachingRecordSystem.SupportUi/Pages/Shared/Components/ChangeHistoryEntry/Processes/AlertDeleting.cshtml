@inject ReferenceDataCache ReferenceDataCache
@model ChangeHistoryEntryViewModel
@{
    var deletedEvent = Model.GetEvent<AlertDeletedEvent>();
    var alert = deletedEvent.Alert;
    var alertType = alert.AlertTypeId is not null ? await ReferenceDataCache.GetAlertTypeByIdAsync(alert.AlertTypeId.Value) : null;
}

<timeline-entry title="Alert deleted" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body">
        Alert deleted for @alertType?.Name with start date @alert.StartDate?.ToString(WebConstants.DateDisplayFormat)
    </p>
</timeline-entry>
