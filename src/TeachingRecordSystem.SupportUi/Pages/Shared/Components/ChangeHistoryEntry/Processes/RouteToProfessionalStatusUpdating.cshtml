@using Microsoft.AspNetCore.Html
@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Events.ChangeReasons
@using TeachingRecordSystem.SupportUi.Pages.RoutesToProfessionalStatus
@inject ReferenceDataCache ReferenceDataCache
@model ChangeHistoryEntryViewModel
@{
    var updatedEvent = Model.GetEvent<RouteToProfessionalStatusUpdatedEvent>();
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
    var oldDetails = updatedEvent.OldRouteToProfessionalStatus;
    var professionalStatus = updatedEvent.RouteToProfessionalStatus;
    var routeType = await ReferenceDataCache.GetRouteToProfessionalStatusTypeByIdAsync(professionalStatus.RouteToProfessionalStatusTypeId);
    var trainingProvider = professionalStatus.TrainingProviderId.HasValue ? await ReferenceDataCache.GetTrainingProviderByIdAsync(professionalStatus.TrainingProviderId.Value) : null;
    var country = !string.IsNullOrEmpty(professionalStatus.TrainingCountryId) ? await ReferenceDataCache.GetTrainingCountryByIdAsync(professionalStatus.TrainingCountryId) : null;
    var degreeType = professionalStatus.DegreeTypeId.HasValue ? await ReferenceDataCache.GetDegreeTypeByIdAsync(professionalStatus.DegreeTypeId.Value) : null;
    var ageRangeType = professionalStatus.TrainingAgeSpecialismType;
    var ageRangeFromTo = (professionalStatus.TrainingAgeSpecialismRangeFrom is not null && professionalStatus.TrainingAgeSpecialismRangeTo is not null) ?
        $"From {professionalStatus.TrainingAgeSpecialismRangeFrom} to {professionalStatus.TrainingAgeSpecialismRangeTo}" : null;
    var subjects = await SubjectDisplayHelper.GetFormattedSubjectNamesAsync(professionalStatus.TrainingSubjectIds, ReferenceDataCache);
    var oldTrainingProvider = oldDetails.TrainingProviderId.HasValue ? await ReferenceDataCache.GetTrainingProviderByIdAsync(oldDetails.TrainingProviderId.Value) : null;
    var oldCountry = !string.IsNullOrEmpty(oldDetails.TrainingCountryId) ? await ReferenceDataCache.GetTrainingCountryByIdAsync(oldDetails.TrainingCountryId) : null;
    var oldDegreeType = oldDetails.DegreeTypeId.HasValue ? await ReferenceDataCache.GetDegreeTypeByIdAsync(oldDetails.DegreeTypeId.Value) : null;
    var oldAgeRangeType = oldDetails.TrainingAgeSpecialismType;
    var oldAgeRangeFromTo = (oldDetails.TrainingAgeSpecialismRangeFrom is not null && oldDetails.TrainingAgeSpecialismRangeTo is not null) ?
        $"From {oldDetails.TrainingAgeSpecialismRangeFrom} to {oldDetails.TrainingAgeSpecialismRangeTo}" : null;
    var oldSubjects = await SubjectDisplayHelper.GetFormattedSubjectNamesAsync(oldDetails.TrainingSubjectIds, ReferenceDataCache);

    // Route and ExemptFromInductionDueToQtsDate have no rows of their own, so an entry carrying only those has
    // nothing to list beyond the source application reference.
    var displayedChanges = updatedEvent.Changes &
        ~(RouteToProfessionalStatusUpdatedEventChanges.Route | RouteToProfessionalStatusUpdatedEventChanges.ExemptFromInductionDueToQtsDate);
    var hasRouteRows = displayedChanges != RouteToProfessionalStatusUpdatedEventChanges.None ||
        professionalStatus.SourceApplicationReference is not null;
}
@functions {
    private static IHtmlContent ToDisplayValueOrFallback(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return new HtmlString("<span class=\"trs-empty-fallback\">None</span>");
        }

        return new HtmlString(System.Net.WebUtility.HtmlEncode(value));
    }
}

<timeline-entry title="Route updated" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="route-name">@routeType.Name</p>
    @if (hasRouteRows)
    {
        <govuk-details class="govuk-!-margin-bottom-2">
            <govuk-details-summary>Route details</govuk-details-summary>
            <govuk-details-text>
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.Status))
                {
                    <p class="govuk-body" data-testid="status">
                        Status changed from @ToDisplayValueOrFallback(oldDetails.Status.GetDisplayName()) to @ToDisplayValueOrFallback(professionalStatus.Status.GetDisplayName())
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.StartDate))
                {
                    <p class="govuk-body" data-testid="start-date">
                        Start date changed from @ToDisplayValueOrFallback(oldDetails.TrainingStartDate?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(professionalStatus.TrainingStartDate?.ToString(WebConstants.DateDisplayFormat))
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.EndDate))
                {
                    <p class="govuk-body" data-testid="end-date">
                        End date changed from @ToDisplayValueOrFallback(oldDetails.TrainingEndDate?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(professionalStatus.TrainingEndDate?.ToString(WebConstants.DateDisplayFormat))
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.HoldsFrom))
                {
                    <p class="govuk-body" data-testid="award-date">
                        Held since changed from @ToDisplayValueOrFallback(oldDetails.HoldsFrom?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(professionalStatus.HoldsFrom?.ToString(WebConstants.DateDisplayFormat))
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.ExemptFromInduction))
                {
                    <p class="govuk-body" data-testid="exemption">
                        Induction exemption changed from @ToDisplayValueOrFallback(oldDetails.ExemptFromInduction.HasValue ? oldDetails.ExemptFromInduction.Value ? "Yes" : "No" : null) to @ToDisplayValueOrFallback(professionalStatus.ExemptFromInduction.HasValue ? professionalStatus.ExemptFromInduction.Value ? "Yes" : "No" : null)
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.TrainingProvider))
                {
                    <p class="govuk-body" data-testid="training-provider">
                        Training provider changed from @ToDisplayValueOrFallback(oldTrainingProvider?.Name) to @ToDisplayValueOrFallback(trainingProvider?.Name)
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.DegreeType))
                {
                    <p class="govuk-body" data-testid="degree-type">
                        Degree type changed from @ToDisplayValueOrFallback(oldDegreeType?.Name) to @ToDisplayValueOrFallback(degreeType?.Name)
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.TrainingCountry))
                {
                    <p class="govuk-body" data-testid="country">
                        Country changed from @ToDisplayValueOrFallback(oldCountry?.Name) to @ToDisplayValueOrFallback(country?.Name)
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.TrainingAgeSpecialismRangeFrom) || updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.TrainingAgeSpecialismRangeTo))
                {
                    <p class="govuk-body" data-testid="age-range">
                        Age range changed from @ToDisplayValueOrFallback(oldAgeRangeFromTo) to @ToDisplayValueOrFallback(ageRangeFromTo)
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.TrainingAgeSpecialismType))
                {
                    <p class="govuk-body" data-testid="age-range-type">
                        Age range changed from @ToDisplayValueOrFallback(oldAgeRangeType?.GetDisplayName()) to @ToDisplayValueOrFallback(ageRangeType?.GetDisplayName())
                    </p>
                }
                @if (updatedEvent.Changes.HasFlag(RouteToProfessionalStatusUpdatedEventChanges.TrainingSubjectIds))
                {
                    <p class="govuk-body" data-testid="subjects">
                        Subjects changed from @ToDisplayValueOrFallback(oldSubjects is not null ? string.Join(", ", oldSubjects) : null) to @ToDisplayValueOrFallback(subjects is not null ? string.Join(", ", subjects) : null)
                    </p>
                }
                @if (professionalStatus.SourceApplicationReference is not null)
                {
                    <p class="govuk-body" data-testid="source-application-reference">
                        Source application reference: @professionalStatus.SourceApplicationReference
                    </p>
                }
            </govuk-details-text>
        </govuk-details>
    }
    @if (changeReason is not null && (!string.IsNullOrEmpty(changeReason.Reason) || !string.IsNullOrEmpty(changeReason.Details)))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="change-reason">
            <govuk-details-summary>Reason for change</govuk-details-summary>
            <govuk-details-text>
                <govuk-summary-list>
                    <row>
                        <key>Reason</key>
                        <value use-empty-fallback data-testid="reason">
                            @if (changeReason.Reason == "Another reason" && !string.IsNullOrEmpty(changeReason.Details))
                            {
                                @Html.ConvertNewlinesToLineBreaks(changeReason.Details)
                            }
                            else
                            {
                                @changeReason.Reason
                            }
                        </value>
                    </row>
                    @if (!string.IsNullOrEmpty(changeReason.AdditionalInformation))
                    {
                        <row>
                            <key>Additional information</key>
                            <value use-empty-fallback data-testid="additional-information">
                                @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                            </value>
                        </row>
                    }
                    @if (changeReason.EvidenceFile is not null)
                    {
                        <row>
                            <key>Evidence</key>
                            <value>
                                <vc:event-evidence-file-link evidence-file="@changeReason.EvidenceFile" />
                            </value>
                        </row>
                    }
                </govuk-summary-list>
            </govuk-details-text>
        </govuk-details>
    }
    <partial name="~/Pages/Shared/Components/ChangeHistoryEntry/Processes/_PersonProfessionalStatusChanges.cshtml" model="@Model" />
</timeline-entry>
