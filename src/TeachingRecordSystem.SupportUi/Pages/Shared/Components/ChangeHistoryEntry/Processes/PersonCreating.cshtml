@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Events.ChangeReasons
@using TeachingRecordSystem.Core.DataStore.Postgres.Models
@model ChangeHistoryEntryViewModel
@{
    var createdEvent = Model.GetEvent<PersonCreatedEvent>();
    var details = createdEvent.Details;
    var name = string.JoinNonEmpty(' ', details.FirstName, details.MiddleName, details.LastName);
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
    var hasEmailSentEvent = Model.TryGetEvent<EmailSentEvent>(out _);
    var isSystemUser = Model.UserName == SystemUser.SystemUserName;
    var title = isSystemUser ? "Record created" : "Record created manually";
}

<timeline-entry title="@title" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="name">Record created for @name</p>

    @if (changeReason is not null && (!string.IsNullOrEmpty(changeReason.Reason) || !string.IsNullOrEmpty(changeReason.Details)))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="create-reason">
            <summary>Reason for creating record</summary>
            <text>
                <govuk-summary-list>
                    <row>
                        <key>Reason</key>
                        <value use-empty-fallback data-testid="reason">
                            @if (changeReason.Reason == "Another reason" && !string.IsNullOrEmpty(changeReason.Details))
                            {
                                @Html.ConvertNewlinesToLineBreaks(changeReason.Details)
                            }
                            else
                            {
                                @changeReason.Reason
                            }
                        </value>
                    </row>
                    @if (!string.IsNullOrEmpty(changeReason.AdditionalInformation))
                    {
                        <row>
                            <key>Additional information</key>
                            <value use-empty-fallback data-testid="additional-information">
                                @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                            </value>
                        </row>
                    }
                    @if (changeReason.EvidenceFile is not null)
                    {
                        <row>
                            <key>Evidence</key>
                            <value>
                                <vc:event-evidence-file-link evidence-file="@changeReason.EvidenceFile" />
                            </value>
                        </row>
                    }
                </govuk-summary-list>
            </text>
        </govuk-details>
    }

    @if (hasEmailSentEvent)
    {
        <p class="govuk-body" data-testid="email-sent-message">
            We’ve sent them an email confirming their TRN.
        </p>
    }
</timeline-entry>
