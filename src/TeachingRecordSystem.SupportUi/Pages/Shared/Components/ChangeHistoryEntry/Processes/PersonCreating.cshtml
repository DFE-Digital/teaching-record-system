@using TeachingRecordSystem.Core.Events.ChangeReasons
@model ChangeHistoryEntryViewModel
@{
    var createdEvent = Model.GetEvent<PersonCreatedEvent>();
    var details = createdEvent.Details;
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
}

<timeline-entry title="Record created" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <partial name="~/Pages/Shared/Components/ChangeHistoryEntry/_PersonDetailsSummary.cshtml" model="@details" />

    <govuk-details class="govuk-!-margin-bottom-2" data-testid="create-reason">
        <govuk-details-summary>Reason for creating record</govuk-details-summary>
        <govuk-details-text>
            <govuk-summary-list>
                <row>
                    <key>Reason</key>
                    <value use-empty-fallback>@changeReason?.Reason</value>
                </row>
                <row>
                    <key>Reason details</key>
                    <value>
                        @if (changeReason?.Details is not null)
                        {
                            @Html.ConvertNewlinesToLineBreaks(changeReason.Details)
                        }
                        else
                        {
                            <span use-empty-fallback></span>
                        }
                    </value>
                </row>
                <row>
                    <key>Additional information</key>
                    <value>
                        @if (changeReason?.AdditionalInformation is not null)
                        {
                            @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                        }
                        else
                        {
                            <span use-empty-fallback></span>
                        }
                    </value>
                </row>
                <row>
                    <key>Evidence</key>
                    <value>
                        <vc:event-evidence-file-link evidence-file="@changeReason?.EvidenceFile" />
                    </value>
                </row>
            </govuk-summary-list>
        </govuk-details-text>
    </govuk-details>
</timeline-entry>
