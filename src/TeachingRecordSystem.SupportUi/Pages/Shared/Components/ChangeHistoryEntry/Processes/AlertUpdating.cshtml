@using TeachingRecordSystem.Core.Events.ChangeReasons
@inject ReferenceDataCache ReferenceDataCache
@model ChangeHistoryEntryViewModel
@{
    var updatedEvent = Model.GetEvent<AlertUpdatedEvent>();
    var alert = updatedEvent.Alert;
    var oldAlert = updatedEvent.OldAlert;
    TrsUriHelper.TryCreateWebsiteUri(alert.ExternalLink, out var externalLinkUri);
    TrsUriHelper.TryCreateWebsiteUri(oldAlert.ExternalLink, out var oldExternalLinkUri);
    var alertType = alert.AlertTypeId is not null ? await ReferenceDataCache.GetAlertTypeByIdAsync(alert.AlertTypeId.Value) : null;
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
}

<timeline-entry title="Alert updated" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    @if (updatedEvent.Changes.HasFlag(AlertUpdatedEventChanges.StartDate))
    {
        <p class="govuk-body">
            Start date changed from @oldAlert.StartDate?.ToString(WebConstants.DateDisplayFormat) to @alert.StartDate?.ToString(WebConstants.DateDisplayFormat)
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(AlertUpdatedEventChanges.EndDate))
    {
        <p class="govuk-body">
            @if (alert.EndDate is null && oldAlert.EndDate is not null)
            {
                @:Alert re-opened (end date removed: was @oldAlert.EndDate?.ToString(WebConstants.DateDisplayFormat))
            }
            else if (alert.EndDate is not null && oldAlert.EndDate is null)
            {
                @:Alert closed (end date set to @alert.EndDate?.ToString(WebConstants.DateDisplayFormat))
            }
            else
            {
                @:End date changed from @oldAlert.EndDate?.ToString(WebConstants.DateDisplayFormat) to @alert.EndDate?.ToString(WebConstants.DateDisplayFormat)
            }
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(AlertUpdatedEventChanges.Details))
    {
        <p class="govuk-body">
            Details changed from "@Html.ConvertNewlinesToLineBreaks(oldAlert.Details)" to "@Html.ConvertNewlinesToLineBreaks(alert.Details)"
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(AlertUpdatedEventChanges.ExternalLink))
    {
        <p class="govuk-body">
            External link changed from 
            @if (oldAlert.ExternalLink is not null)
            {
                <a href="@oldExternalLinkUri" class="govuk-link" rel="noreferrer noopener" target="_blank">@oldAlert.ExternalLink (opens in new tab)</a>
            }
            else
            {
                <text>(none)</text>
            }
            to 
            @if (alert.ExternalLink is not null)
            {
                <a href="@externalLinkUri" class="govuk-link" rel="noreferrer noopener" target="_blank">@alert.ExternalLink (opens in new tab)</a>
            }
            else
            {
                <text>(none)</text>
            }
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(AlertUpdatedEventChanges.DqtSanctionCode))
    {
        <p class="govuk-body">
            DQT sanction code changed from @oldAlert.DqtSanctionCode?.Name to @alert.DqtSanctionCode?.Name
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(AlertUpdatedEventChanges.DqtSpent))
    {
        <p class="govuk-body">
            DQT spent changed from @oldAlert.DqtSpent to @alert.DqtSpent
        </p>
    }

    @if (changeReason is not null && (!string.IsNullOrEmpty(changeReason.Reason) || !string.IsNullOrEmpty(changeReason.Details)))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="change-reason">
            <govuk-details-summary>Reason for change</govuk-details-summary>
            <govuk-details-text>
                <govuk-summary-list>
                    <row>
                        <key>Reason details</key>
                        <value use-empty-fallback>
                            @if (changeReason.Reason == "Another reason" && !string.IsNullOrEmpty(changeReason.Details))
                            {
                                @Html.ConvertNewlinesToLineBreaks($"{changeReason.Reason}: {changeReason.Details}")
                            }
                            else
                            {
                                @changeReason.Reason
                            }
                        </value>
                    </row>
                    <row>
                        <key>Additional information</key>
                        <value use-empty-fallback>
                            @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                        </value>
                    </row>
                </govuk-summary-list>
            </govuk-details-text>
        </govuk-details>
    }
</timeline-entry>
