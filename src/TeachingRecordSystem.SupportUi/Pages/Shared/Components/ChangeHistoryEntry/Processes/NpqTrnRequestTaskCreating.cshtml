@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.SupportUi.Services.ChangeHistory
@model ChangeHistoryEntryViewModel
@{
    var hasSupportTaskCreatedEvent = Model.TryGetEvent<SupportTaskCreatedEvent>(out var supportTaskCreatedEvent);
    var hasTrnRequestCreatedEvent = Model.TryGetEvent<TrnRequestCreatedEvent>(out var trnRequestCreatedEvent);

    var isSupportTaskContext = Model.Context.ContextType == ChangeHistoryContextType.SupportTask;

    var supportTaskReference = supportTaskCreatedEvent?.SupportTask.SupportTaskReference;
    var sourceApplicationName = hasTrnRequestCreatedEvent
        ? Model.Context.TryGetApplicationUserInfo(trnRequestCreatedEvent!.TrnRequest.ApplicationUserId)?.Name
        : null;
}

<timeline-entry title="NPQ TRN request received" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    @if (!string.IsNullOrWhiteSpace(sourceApplicationName))
    {
        <p class="govuk-body" data-testid="trn-request-summary">
            TRN request received from @sourceApplicationName.
        </p>
    }

    @if (hasSupportTaskCreatedEvent && supportTaskReference is not null)
    {
        <p class="govuk-body" data-testid="support-task-created-message">
            @if (!isSupportTaskContext)
            {
                <text>TRN request support task <a href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(supportTaskReference)" class="govuk-link" target="_blank" data-testid="created-task-link">@supportTaskReference <span class="govuk-visually-hidden">(opens in new tab)</span></a> was created.</text>
            }
            else
            {
                <text>TRN request support task @supportTaskReference was created.</text>
            }
        </p>
    }
</timeline-entry>
