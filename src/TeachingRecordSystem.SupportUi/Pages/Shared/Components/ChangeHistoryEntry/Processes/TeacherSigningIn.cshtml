@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.SupportUi.Pages.Shared.Components.ChangeHistoryEntry
@using TeachingRecordSystem.SupportUi.Services.ChangeHistory
@inject SupportUiLinkGenerator LinkGenerator
@model ChangeHistoryEntryViewModel
@{
    Model.TryGetEvent<OneLoginUserSignedInEvent>(out var oneLoginSignedInEvent);
    var hasOneLoginUpdatedEvent = Model.TryGetEvent<OneLoginUserUpdatedEvent>(out var oneLoginUpdatedEvent);
    var hasSupportTaskCreatedEvent = Model.TryGetEvent<SupportTaskCreatedEvent>(out var supportTaskCreatedEvent);
    var hasTrnRequestCreatedEvent = Model.TryGetEvent<TrnRequestCreatedEvent>(out _);
    var hasTrnRequestUpdatedEvent = Model.TryGetEvent<TrnRequestUpdatedEvent>(out _);
    var hasTrnRequestEvent = hasTrnRequestCreatedEvent || hasTrnRequestUpdatedEvent;
    var hasAuthorizeAccessRequestCompletedEvent = Model.ContainsEvent<AuthorizeAccessRequestCompletedEvent>();

    var oneLoginUser = hasOneLoginUpdatedEvent ? oneLoginUpdatedEvent!.OneLoginUser : oneLoginSignedInEvent?.OneLoginUser;
    var oneLoginSubject = oneLoginUser?.Subject;
    var oneLoginEmail = oneLoginUser?.EmailAddress ?? "GOV.UK One Login";
    var personId = oneLoginUser?.PersonId;
    var personInfo = personId is not null ? Model.Context.TryGetPersonInfo(personId.Value) : null;
    var firstPersonMatch = hasAuthorizeAccessRequestCompletedEvent
                           && hasOneLoginUpdatedEvent
                           && oneLoginUpdatedEvent!.OldOneLoginUser.PersonId is null
                           && personInfo is not null;

    var title = hasSupportTaskCreatedEvent
        ? supportTaskCreatedEvent!.SupportTask.SupportTaskType switch
        {
            SupportTaskType.OneLoginUserIdVerification => "GOV.UK One Login ID verification task created",
            SupportTaskType.OneLoginUserRecordMatching => "GOV.UK One Login record matching task created",
            _ => "GOV.UK One Login task created"
        }
        : hasOneLoginUpdatedEvent
            ? "GOV.UK One Login updated"
            : hasTrnRequestEvent
                ? "TRN request created"
                : "GOV.UK One Login user attempted to login";

    var oldEmail = hasOneLoginUpdatedEvent ? oneLoginUpdatedEvent!.OldOneLoginUser.EmailAddress : null;
    var newEmail = hasOneLoginUpdatedEvent ? oneLoginUpdatedEvent!.OneLoginUser.EmailAddress : null;
    var oldName = hasOneLoginUpdatedEvent && oneLoginUpdatedEvent!.OldOneLoginUser.VerifiedNames is { Length: > 0 } oldNames
        ? string.Join(" ", oldNames[0])
        : null;
    var newName = hasOneLoginUpdatedEvent && oneLoginUpdatedEvent!.OneLoginUser.VerifiedNames is { Length: > 0 } newNames
        ? string.Join(" ", newNames[0])
        : null;
    var verificationChanged = hasOneLoginUpdatedEvent && (oneLoginUpdatedEvent!.Changes & OneLoginUserUpdatedEventChanges.VerifiedOn) != 0;
    var matchChanged = hasOneLoginUpdatedEvent && (oneLoginUpdatedEvent!.Changes & OneLoginUserUpdatedEventChanges.MatchedOn) != 0;
    var routeText = hasOneLoginUpdatedEvent ? oneLoginUpdatedEvent!.OneLoginUser.MatchRoute switch
    {
        OneLoginUserMatchRoute.TrnToken => "via magic link",
        OneLoginUserMatchRoute.TrnRequest => "via TRN request",
        _ => "via a matching route"
    } : null;

    var supportTaskOneLoginSubject = hasSupportTaskCreatedEvent ? supportTaskCreatedEvent!.SupportTask.OneLoginUserSubject : null;
    var supportTaskOneLoginEmail = supportTaskOneLoginSubject is not null
        ? Model.Context.GetOneLoginUserInfo(supportTaskOneLoginSubject).EmailAddress ?? "GOV.UK One Login"
        : "GOV.UK One Login";
}

<timeline-entry title="@title" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    @if (hasSupportTaskCreatedEvent)
    {
        var createdTaskReference = supportTaskCreatedEvent!.SupportTask.SupportTaskReference;
        var createdTaskType = supportTaskCreatedEvent.SupportTask.SupportTaskType;
        var isOneLoginContext = Model.Context.ContextType == ChangeHistoryContextType.OneLogin;

        <p class="govuk-body" data-testid="support-task-created-message">
            @if (Model.Context.ContextType != ChangeHistoryContextType.SupportTask)
            {
                @:Task <a href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(createdTaskReference)" class="govuk-link" target="_blank" data-testid="support-task-link">@createdTaskReference<span class="govuk-visually-hidden">(opens in new tab)</span></a> created as
            }
            else
            {
                @:Task @createdTaskReference created as
            }

            @if (createdTaskType == SupportTaskType.OneLoginUserIdVerification)
            {
                @if (isOneLoginContext)
                {
                    @:user ID could not be verified through GOV.UK One Login.
                }
                else
                {
                    @:user ID <a href="@LinkGenerator.OneLogins.OneLoginDetail.Index(supportTaskOneLoginSubject!)" class="govuk-link" target="_blank" data-testid="one-login-link">@supportTaskOneLoginEmail<span class="govuk-visually-hidden">(opens in new tab)</span></a> could not be verified through GOV.UK One Login.
                }
            }
            else if (createdTaskType == SupportTaskType.OneLoginUserRecordMatching)
            {
                @if (isOneLoginContext)
                {
                    @:user could not be matched to a teaching record.
                }
                else
                {
                    @:user <a href="@LinkGenerator.OneLogins.OneLoginDetail.Index(supportTaskOneLoginSubject!)" class="govuk-link" target="_blank" data-testid="one-login-link">@supportTaskOneLoginEmail<span class="govuk-visually-hidden">(opens in new tab)</span></a> could not be matched to a teaching record.
                }
            }
        </p>
    }

    @if (hasOneLoginUpdatedEvent)
    {
        if (!string.IsNullOrEmpty(oldEmail) && !string.IsNullOrEmpty(newEmail) && !string.Equals(oldEmail, newEmail, StringComparison.Ordinal))
        {
            <p class="govuk-body" data-testid="one-login-email-changed-message">
                Email changed from @oldEmail to @newEmail.
            </p>
        }

        if (!string.IsNullOrEmpty(oldName) && !string.IsNullOrEmpty(newName) && !string.Equals(oldName, newName, StringComparison.OrdinalIgnoreCase))
        {
            <p class="govuk-body" data-testid="one-login-name-changed-message">
                Name changed from @oldName to @newName.
            </p>
        }

        if (verificationChanged)
        {
            <p class="govuk-body" data-testid="one-login-verified-message">
                User verified via GOV.UK One Login.
            </p>
        }

        if (matchChanged && routeText is not null)
        {
            <p class="govuk-body" data-testid="one-login-match-route-message">
                User matched @routeText.
            </p>
        }
    }

    @if (hasTrnRequestCreatedEvent && !hasSupportTaskCreatedEvent)
    {
        <p class="govuk-body" data-testid="trn-request-not-matched-message">
            User could not be matched to a teaching record.
        </p>
    }

    @if (hasTrnRequestCreatedEvent)
    {
        <p class="govuk-body" data-testid="trn-request-created-message">
            A dormant TRN request has been created for the user.
        </p>
    }

    @if (firstPersonMatch)
    {
        var personLink = LinkGenerator.Persons.PersonDetail.Index(personId!.Value);
        var personLinkText = $"{personInfo!.FirstName} {personInfo.LastName}";
        <p class="govuk-body" data-testid="person-linked-message">
            @if (Model.Context.ContextType == ChangeHistoryContextType.Person)
            {
                @:User authenticated with GOV.UK One Login @oneLoginEmail and matched to this record.
            }
            else if (Model.Context.ContextType == ChangeHistoryContextType.OneLogin)
            {
                @:User authenticated with GOV.UK One Login @oneLoginEmail and matched to <a href="@personLink" class="govuk-link" target="_blank" data-testid="person-link">@personLinkText<span class="govuk-visually-hidden">(opens in new tab)</span></a>.
            }
            else
            {
                @:User authenticated with GOV.UK One Login <a href="@LinkGenerator.OneLogins.OneLoginDetail.Index(oneLoginSubject!)" class="govuk-link" target="_blank" data-testid="one-login-link">@oneLoginEmail<span class="govuk-visually-hidden">(opens in new tab)</span></a> and matched to <a href="@personLink" class="govuk-link" target="_blank" data-testid="person-link">@personLinkText<span class="govuk-visually-hidden">(opens in new tab)</span></a>.
            }
        </p>
    }
</timeline-entry>
