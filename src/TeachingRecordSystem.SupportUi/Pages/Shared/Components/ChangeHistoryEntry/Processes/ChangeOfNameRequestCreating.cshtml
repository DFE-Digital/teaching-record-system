@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Models.SupportTasks
@model ChangeHistoryEntryViewModel
@{
    var supportTaskCreatedEvent = Model.GetEvent<SupportTaskCreatedEvent>();
    var changeRequestData = (ChangeNameRequestData)supportTaskCreatedEvent.SupportTask.Data;
    var requestedName = string.JoinNonEmpty(' ', changeRequestData.FirstName, changeRequestData.MiddleName, changeRequestData.LastName);
}

<timeline-entry title="Change of Name request created" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="change-request-context">
        Request to change name to <strong>@requestedName</strong>.
    </p>
</timeline-entry>
