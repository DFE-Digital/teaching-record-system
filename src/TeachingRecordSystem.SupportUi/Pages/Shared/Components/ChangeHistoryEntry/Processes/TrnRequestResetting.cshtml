@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.SupportUi.Services.ChangeHistory
@model ChangeHistoryEntryViewModel
@{
    var trnRequestUpdatedEvent = Model.GetEvent<TrnRequestUpdatedEvent>();
    var supportTaskCreatedEvent = Model.GetEvent<SupportTaskCreatedEvent>();
    var createdTaskReference = supportTaskCreatedEvent.SupportTask.SupportTaskReference;
    var isSupportTaskContext = Model.Context.ContextType == ChangeHistoryContextType.SupportTask;
}

<timeline-entry title="TRN request reset" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="trn-request-summary">
        TRN request reset and moved to pending.
    </p>

    <p class="govuk-body" data-testid="support-task-created-message">
        @if (!isSupportTaskContext)
        {
            <text>TRN request support task <a href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(createdTaskReference)" class="govuk-link" target="_blank" data-testid="created-task-link">@createdTaskReference <span class="govuk-visually-hidden">(opens in new tab)</span></a> was created.</text>
        }
        else
        {
            <text>TRN request support task @createdTaskReference was created.</text>
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(trnRequestUpdatedEvent.ReasonDetails))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="change-reason">
            <summary>Reason for change</summary>
            <text>
                <govuk-summary-list>
                    <row>
                        <key>Reason</key>
                        <value use-empty-fallback data-testid="reason">@Html.ConvertNewlinesToLineBreaks(trnRequestUpdatedEvent.ReasonDetails)</value>
                    </row>
                </govuk-summary-list>
            </text>
        </govuk-details>
    }
</timeline-entry>
