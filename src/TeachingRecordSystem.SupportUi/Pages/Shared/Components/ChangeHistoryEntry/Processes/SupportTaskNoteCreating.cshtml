@using TeachingRecordSystem.Core.Events
@model ChangeHistoryEntryViewModel
@{
    var noteCreatedEvent = Model.GetEvent<SupportTaskNoteCreatedEvent>();
    var note = noteCreatedEvent.SupportTaskNote;
}

<timeline-entry title="Support task note created" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <govuk-details class="govuk-!-margin-bottom-2" data-testid="note-content">
        <summary>Note</summary>
        <text>
            @Html.ConvertNewlinesToLineBreaks(note.Content)
        </text>
    </govuk-details>
</timeline-entry>
