@using System.Diagnostics
@model ChangeHistoryEntryViewModel
@{
    var deactivatedEvent = Model.GetEvent<PersonDeactivatedEvent>();
    Debug.Assert(deactivatedEvent.MergedWithPersonId is not null);

    var updatedEvent = Model.ContainsEvent<PersonUpdatedInDqtEvent>() ? Model.GetEvent<PersonUpdatedInDqtEvent>() : null;

    var thisRecordWasDeactivated = Model.Context.PersonId == deactivatedEvent.PersonId;

    // The "other" person (the one merged with) is the retained record when viewing the deactivated record,
    // otherwise it is the deactivated record. otherPersonInfo is always available in this context.
    var otherPersonId = thisRecordWasDeactivated ? deactivatedEvent.MergedWithPersonId!.Value : deactivatedEvent.PersonId;
    var otherPersonInfo = Model.Context.GetPersonInfo(otherPersonId);
}

<timeline-entry title="Record merged in DQT" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body">
        Record merged with TRN <a href="@LinkGenerator.Persons.PersonDetail.Index(otherPersonInfo.PersonId)" class="govuk-link" target="_blank" data-testid="merged-with-person-link">@otherPersonInfo.Trn <span class="govuk-visually-hidden">(opens in new tab)</span></a>@(thisRecordWasDeactivated ? " and deactivated" : "")
    </p>

    @* Render the updated-event details only when an updated event exists and we're viewing the retained person *@
    @if (updatedEvent is not null && !thisRecordWasDeactivated)
    {
        <govuk-details class="govuk-!-margin-bottom-2">
            <govuk-details-summary>Record details</govuk-details-summary>
            <govuk-details-text>
                <partial name="./_PersonUpdatedInDqtEvent.cshtml" model="updatedEvent" />
            </govuk-details-text>
        </govuk-details>
    }
</timeline-entry>
