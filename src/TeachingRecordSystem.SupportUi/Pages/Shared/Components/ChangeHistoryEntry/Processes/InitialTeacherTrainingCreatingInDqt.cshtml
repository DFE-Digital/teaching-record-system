@model ChangeHistoryEntryViewModel
@{
    var createdEvent = Model.GetEvent<DqtInitialTeacherTrainingCreatedEvent>();
    var itt = createdEvent.InitialTeacherTraining;
}

<timeline-entry title="DQT initial teacher training created" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <govuk-summary-list>
        <row>
            <key>Result</key>
            <value use-empty-fallback>@itt?.Result</value>
        </row>
    </govuk-summary-list>
</timeline-entry>
