@model ChangeHistoryEntryViewModel
@{
    var updatedEvent = Model.GetEvent<PersonUpdatedInDqtEvent>();
    var name = string.JoinNonEmpty(' ', updatedEvent.Details.FirstName, updatedEvent.Details.MiddleName, updatedEvent.Details.LastName);
}

<timeline-entry title="Record updated in DQT" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body">
        Record updated for @name
    </p>
    <govuk-details class="govuk-!-margin-bottom-2">
        <govuk-details-summary>Record details</govuk-details-summary>
        <govuk-details-text>
            <partial name="./_PersonUpdatedInDqtEvent.cshtml" model="updatedEvent" />
        </govuk-details-text>
    </govuk-details>
</timeline-entry>
