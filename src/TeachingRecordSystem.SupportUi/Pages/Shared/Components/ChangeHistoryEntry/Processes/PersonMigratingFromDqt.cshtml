@model ChangeHistoryEntryViewModel
@{
    var migratedEvent = Model.GetEvent<PersonMigratedEvent>();
    var attributes = migratedEvent.PersonAttributes;
    var name = string.JoinNonEmpty(' ', attributes.FirstName, attributes.MiddleName, attributes.LastName);
    var hasDetails = migratedEvent.Trn is not null || !string.IsNullOrEmpty(name) ||
        attributes.DateOfBirth is not null || attributes.EmailAddress is not null ||
        attributes.NationalInsuranceNumber is not null || attributes.Gender is not null;
}

<timeline-entry title="Record migrated from DQT" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body">
        Record migrated for @name
    </p>

    @if (hasDetails)
    {
        <govuk-details class="govuk-!-margin-bottom-2">
            <summary>Record details</summary>
            <text>
                <govuk-summary-list>
                    @if (migratedEvent.Trn is string trn)
                    {
                        <row>
                            <key>TRN</key>
                            <value use-empty-fallback>@trn</value>
                        </row>
                    }
                    @if (!string.IsNullOrEmpty(name))
                    {
                        <row>
                            <key>Name</key>
                            <value use-empty-fallback>@name</value>
                        </row>
                    }
                    @if (attributes.DateOfBirth is DateOnly dateOfBirth)
                    {
                        <row>
                            <key>Date of birth</key>
                            <value use-empty-fallback>@dateOfBirth.ToString(WebConstants.DateDisplayFormat)</value>
                        </row>
                    }
                    @if (attributes.EmailAddress is string emailAddress)
                    {
                        <row>
                            <key>Email address</key>
                            <value use-empty-fallback>@emailAddress</value>
                        </row>
                    }
                    @if (attributes.NationalInsuranceNumber is string nationalInsuranceNumber)
                    {
                        <row>
                            <key>National Insurance number</key>
                            <value use-empty-fallback>@nationalInsuranceNumber</value>
                        </row>
                    }
                    @if (attributes.Gender is Gender gender)
                    {
                        <row>
                            <key>Gender</key>
                            <value use-empty-fallback>@gender.GetDisplayName()</value>
                        </row>
                    }
                </govuk-summary-list>
            </text>
        </govuk-details>
    }
</timeline-entry>
