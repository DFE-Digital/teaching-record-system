@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Events.ChangeReasons
@inject ReferenceDataCache ReferenceDataCache
@model ChangeHistoryEntryViewModel
@*
    Shared by every process that sets the person's induction directly, so the entry looks the same whether the change
    came from the Support UI, CPD or the Welsh induction import.
*@
@{
    var updatedEvent = Model.GetEvent<PersonInductionUpdatedEvent>();
    var induction = updatedEvent.Induction;
    var oldInduction = updatedEvent.OldInduction;
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
    var exemptionReasons = (await ReferenceDataCache.GetInductionExemptionReasonsAsync()).ToDictionary(r => r.InductionExemptionReasonId);

    // The status-without-exemption and exempt-without-reason flags are bookkeeping the user never sees, so an
    // entry that only carries those has nothing to show and isn't rendered at all.
    var displayedChanges = updatedEvent.Changes &
        (PersonInductionUpdatedEventChanges.InductionStatus |
         PersonInductionUpdatedEventChanges.InductionExemptionReasons |
         PersonInductionUpdatedEventChanges.InductionStartDate |
         PersonInductionUpdatedEventChanges.InductionCompletedDate);

    string? FormatExemptionReasons(Guid[] exemptionReasonIds) =>
        exemptionReasonIds.Length > 0 ? string.Join(", ", exemptionReasonIds.Select(id => exemptionReasons[id].Name)) : null;
}
@functions {
    private static IHtmlContent ToDisplayValueOrFallback(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return new HtmlString("<span class=\"trs-empty-fallback\">None</span>");
        }

        return new HtmlString(HtmlEncoder.Default.Encode(value));
    }
}

@if (displayedChanges != PersonInductionUpdatedEventChanges.None)
{
    <timeline-entry title="Induction updated" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
        @if (displayedChanges.HasFlag(PersonInductionUpdatedEventChanges.InductionStatus))
        {
            <p class="govuk-body" data-testid="induction-status">
                Induction status changed from @ToDisplayValueOrFallback(oldInduction.Status.GetTitle()) to @ToDisplayValueOrFallback(induction.Status.GetTitle())
            </p>
        }

        @if (displayedChanges.HasFlag(PersonInductionUpdatedEventChanges.InductionExemptionReasons))
        {
            <p class="govuk-body" data-testid="exemption-reason">
                Exemption reason changed from @ToDisplayValueOrFallback(FormatExemptionReasons(oldInduction.ExemptionReasonIds)) to @ToDisplayValueOrFallback(FormatExemptionReasons(induction.ExemptionReasonIds))
            </p>
        }

        @if (displayedChanges.HasFlag(PersonInductionUpdatedEventChanges.InductionStartDate))
        {
            <p class="govuk-body" data-testid="start-date">
                Start date changed from @ToDisplayValueOrFallback(oldInduction.StartDate?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(induction.StartDate?.ToString(WebConstants.DateDisplayFormat))
            </p>
        }

        @if (displayedChanges.HasFlag(PersonInductionUpdatedEventChanges.InductionCompletedDate))
        {
            <p class="govuk-body" data-testid="completed-date">
                Completed date changed from @ToDisplayValueOrFallback(oldInduction.CompletedDate?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(induction.CompletedDate?.ToString(WebConstants.DateDisplayFormat))
            </p>
        }

        @if (changeReason is not null && (!string.IsNullOrEmpty(changeReason.Reason) || !string.IsNullOrEmpty(changeReason.Details)))
        {
            <govuk-details class="govuk-!-margin-bottom-2" data-testid="change-reason">
                <govuk-details-summary>Reason for change</govuk-details-summary>
                <govuk-details-text>
                    <govuk-summary-list>
                        <row>
                            <key>Reason</key>
                            <value use-empty-fallback data-testid="reason">
                                @if (changeReason.Reason == "Another reason" && !string.IsNullOrEmpty(changeReason.Details))
                                {
                                    @Html.ConvertNewlinesToLineBreaks(changeReason.Details)
                                }
                                else
                                {
                                    @changeReason.Reason
                                }
                            </value>
                        </row>
                        @if (!string.IsNullOrEmpty(changeReason.AdditionalInformation))
                        {
                            <row>
                                <key>Additional information</key>
                                <value use-empty-fallback data-testid="additional-information">
                                    @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                                </value>
                            </row>
                        }
                        @if (changeReason.EvidenceFile is not null)
                        {
                            <row>
                                <key>Evidence</key>
                                <value>
                                    <vc:event-evidence-file-link evidence-file="@changeReason.EvidenceFile" />
                                </value>
                            </row>
                        }
                    </govuk-summary-list>
                </govuk-details-text>
            </govuk-details>
        }
    </timeline-entry>
}
