@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Events.ChangeReasons
@model ChangeHistoryEntryViewModel
@{
    var updatedEvent = Model.GetEvent<PersonDetailsUpdatedEvent>();
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
    var details = updatedEvent.PersonDetails;
    var oldDetails = updatedEvent.OldPersonDetails;
    var name = string.JoinNonEmpty(' ', details.FirstName, details.MiddleName, details.LastName);
    var oldName = string.JoinNonEmpty(' ', oldDetails.FirstName, oldDetails.MiddleName, oldDetails.LastName);
    var email = EmailAddress.TryParse(details.EmailAddress, out var parsedEmail)
        ? parsedEmail.ToDisplayString()
        : details.EmailAddress;
    var oldEmail = EmailAddress.TryParse(oldDetails.EmailAddress, out var oldParsedEmail)
        ? oldParsedEmail.ToDisplayString()
        : oldDetails.EmailAddress;
    var nino = NationalInsuranceNumber.TryParse(details.NationalInsuranceNumber, out var parsedNino)
        ? parsedNino.ToDisplayString()
        : details.NationalInsuranceNumber;
    var oldNino = NationalInsuranceNumber.TryParse(oldDetails.NationalInsuranceNumber, out var oldParsedNino)
        ? oldParsedNino.ToDisplayString()
        : oldDetails.NationalInsuranceNumber;
}

<timeline-entry title="Record updated" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    @if (updatedEvent.Changes.HasAnyFlag(PersonDetailsUpdatedEventChanges.NameChange))
    {
        <p class="govuk-body" data-testid="name">Name changed from @oldName to @name</p>
    }
    @if (updatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.DateOfBirth))
    {
        <p class="govuk-body" data-testid="date-of-birth">
            Date of birth changed from @oldDetails.DateOfBirth?.ToString(WebConstants.DateDisplayFormat) to @details.DateOfBirth?.ToString(WebConstants.DateDisplayFormat)
        </p>
    }
    @if (updatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.EmailAddress))
    {
        <p class="govuk-body" data-testid="email-address">Email address changed from @oldEmail to @email</p>
    }
    @if (updatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.NationalInsuranceNumber))
    {
        <p class="govuk-body" data-testid="national-insurance-number">National Insurance number changed from @oldNino to @nino</p>
    }
    @if (updatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.Gender))
    {
        <p class="govuk-body" data-testid="gender">Gender changed from @oldDetails.Gender?.GetDisplayName() to @details.Gender?.GetDisplayName()</p>
    }

    @if (changeReason is not null && (!string.IsNullOrEmpty(changeReason.Reason) || !string.IsNullOrEmpty(changeReason.Details)))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="change-reason">
            <summary>Reason for change</summary>
            <text>
                <govuk-summary-list>
                    <row>
                        <key>Reason</key>
                        <value use-empty-fallback data-testid="reason">
                            @if (changeReason.Reason == "Another reason" && !string.IsNullOrEmpty(changeReason.Details))
                            {
                                @Html.ConvertNewlinesToLineBreaks(changeReason.Details)
                            }
                            else
                            {
                                @changeReason.Reason
                            }
                        </value>
                    </row>
                    @if (!string.IsNullOrEmpty(changeReason.AdditionalInformation))
                    {
                        <row>
                            <key>Additional information</key>
                            <value use-empty-fallback data-testid="additional-information">
                                @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                            </value>
                        </row>
                    }
                    @if (changeReason.EvidenceFile is not null)
                    {
                        <row>
                            <key>Evidence</key>
                            <value>
                                <vc:event-evidence-file-link evidence-file="@changeReason.EvidenceFile" />
                            </value>
                        </row>
                    }
                </govuk-summary-list>
            </text>
        </govuk-details>
    }
</timeline-entry>
