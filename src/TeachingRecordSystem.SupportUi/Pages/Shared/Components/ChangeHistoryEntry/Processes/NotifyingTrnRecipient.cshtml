@using TeachingRecordSystem.Core.Events
@inject PersonInfoCache PersonInfoCache
@model ChangeHistoryEntryViewModel
@{
    var emailSentEvent = Model.GetEvent<EmailSentEvent>();
    var personId = emailSentEvent.PersonId!.Value;
    var personInfo = await PersonInfoCache.GetRequiredPersonInfoAsync(personId);
}

<timeline-entry title="TRN email sent to @personInfo.FirstName @personInfo.LastName" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="email-sent-message">
        We’ve sent them an email confirming their TRN.
    </p>
</timeline-entry>
