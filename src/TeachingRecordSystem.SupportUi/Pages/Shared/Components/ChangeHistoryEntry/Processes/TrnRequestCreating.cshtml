@model ChangeHistoryEntryViewModel
@{
    var hasCreatedEvent = Model.TryGetEvent<PersonCreatedEvent>(out var createdEvent);
}

<timeline-entry title="TRN request received" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="trn-request-summary">
        @if (hasCreatedEvent)
        {
            @:Record created from a TRN request.
        }
        else
        {
            @:A TRN request was matched to this record.
        }
    </p>

    @if (hasCreatedEvent)
    {
        <partial name="~/Pages/Shared/Components/ChangeHistoryEntry/_PersonDetailsSummary.cshtml" model="@createdEvent!.Details" />
    }
</timeline-entry>
