@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.SupportUi.Services.ChangeHistory
@model ChangeHistoryEntryViewModel
@{
    var trnRequestUpdatedEvent = Model.GetEvent<TrnRequestUpdatedEvent>();
    var supportTaskUpdatedEvent = Model.GetEvent<SupportTaskUpdatedEvent>();
    var supportTaskReference = supportTaskUpdatedEvent.SupportTaskReference;
    var resolvedPersonId = trnRequestUpdatedEvent.TrnRequest.ResolvedPersonId;

    var isSupportTaskContext = Model.Context.ContextType == ChangeHistoryContextType.SupportTask;

    var resolvedPersonInfo = resolvedPersonId is not null ? Model.Context.TryGetPersonInfo(resolvedPersonId.Value) : null;
    var resolvedPersonLinkText = resolvedPersonInfo is not null ? $"{resolvedPersonInfo.FirstName} {resolvedPersonInfo.LastName}" : null;
}

<timeline-entry title="TRN request manual checks needed task completed" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body" data-testid="outcome-tag">
        <tag color="@TagColor.Green">Checks completed</tag>
    </p>

    @if (resolvedPersonId is not null)
    {
        <p class="govuk-body" data-testid="trn-request-summary">
            @if (isSupportTaskContext)
            {
                @:TRN request completed and matched to <a href="@LinkGenerator.Persons.PersonDetail.Index(resolvedPersonId.Value)" class="govuk-link" target="_blank" data-testid="person-link">@(resolvedPersonLinkText ?? "a record") <span class="govuk-visually-hidden">(opens in new tab)</span></a>.
            }
            else
            {
                @:TRN request completed and matched to this record.
            }
        </p>
    }

    <p class="govuk-body" data-testid="task-closed-message">
        @if (!isSupportTaskContext)
        {
            <a class="govuk-link" href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(supportTaskReference)" data-testid="support-task-link">
                Task<span class="govuk-visually-hidden"> @supportTaskReference</span>
            </a>
            <text> closed.</text>
        }
        else
        {
            <text>Task closed.</text>
        }
    </p>
</timeline-entry>
