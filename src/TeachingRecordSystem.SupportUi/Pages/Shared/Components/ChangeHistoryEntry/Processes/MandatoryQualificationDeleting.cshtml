@using TeachingRecordSystem.Core.Events.ChangeReasons
@model ChangeHistoryEntryViewModel
@{
    var deletedEvent = Model.GetEvent<MandatoryQualificationDeletedEvent>();
    var mandatoryQualification = deletedEvent.MandatoryQualification;
    var changeReason = Model.ChangeReason as ChangeReasonWithDetailsAndEvidence;
    var specialismTitle = mandatoryQualification.Specialism?.GetTitle();
    var startDateText = mandatoryQualification.StartDate?.ToString(WebConstants.DateDisplayFormat);
    var bodyText = "Mandatory qualification deleted"
        + (specialismTitle is not null ? $" for {specialismTitle}" : "")
        + (startDateText is not null ? $" with start date {startDateText}" : "");
}

<timeline-entry title="Mandatory qualification deleted" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <p class="govuk-body">@bodyText</p>


    @if (changeReason is not null && (!string.IsNullOrEmpty(changeReason.Reason) || !string.IsNullOrEmpty(changeReason.Details)))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="reason-for-change">
            <summary>Reason for deletion</summary>
            <text>
                <govuk-summary-list>
                    <row>
                        <key>Reason</key>
                        <value data-testid="reason" use-empty-fallback>
                            @if (changeReason.Reason == "Another reason" && !string.IsNullOrEmpty(changeReason.Details))
                            {
                                @Html.ConvertNewlinesToLineBreaks(changeReason.Details)
                            }
                            else
                            {
                                @changeReason.Reason
                            }
                        </value>
                    </row>
                    @if (!string.IsNullOrEmpty(changeReason.AdditionalInformation))
                    {
                        <row>
                            <key>Additional information</key>
                            <value data-testid="additional-information" use-empty-fallback>
                                @Html.ConvertNewlinesToLineBreaks(changeReason.AdditionalInformation)
                            </value>
                        </row>
                    }
                    @if (changeReason.EvidenceFile is not null)
                    {
                        <row>
                            <key>Evidence</key>
                            <value data-testid="evidence">
                                <vc:event-evidence-file-link evidence-file="@changeReason.EvidenceFile" />
                            </value>
                        </row>
                    }
                </govuk-summary-list>
            </text>
        </govuk-details>
    }
</timeline-entry>
