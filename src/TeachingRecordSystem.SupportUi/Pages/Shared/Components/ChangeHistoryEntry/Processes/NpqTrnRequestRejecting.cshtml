@using Microsoft.EntityFrameworkCore
@using TeachingRecordSystem.Core.DataStore.Postgres
@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Services.Files
@using TeachingRecordSystem.SupportUi.Pages.Shared.Components.ChangeHistoryEntry
@inject IFileService FileService
@inject TrsDbContext DbContext
@model ChangeHistoryEntryViewModel
@{
    var supportTaskUpdatedEvent = Model.GetEvent<SupportTaskUpdatedEvent>();
    var requestData = Model.GetEvent<TrnRequestUpdatedEvent>().TrnRequest;

    var applicationUserName = await DbContext.ApplicationUsers
        .Where(u => u.UserId == requestData.ApplicationUserId)
        .Select(u => u.Name)
        .SingleOrDefaultAsync();

    var requestDataName = string.JoinNonEmpty(' ', requestData.FirstName, requestData.MiddleName, requestData.LastName);
    var evidenceFileUrl = requestData.NpqEvidenceFileId is not null
        ? await FileService.GetFileUrlAsync(requestData.NpqEvidenceFileId.Value, TimeSpan.FromMinutes(15))
        : null;
}

<timeline-entry title="NPQ TRN request rejected" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    <govuk-details class="govuk-!-margin-bottom-2" data-testid="rejection-reason">
        <govuk-details-summary>Reason request was rejected</govuk-details-summary>
        <govuk-details-text>
            <govuk-summary-list>
                <row>
                    <key>Reason</key>
                    <value use-empty-fallback>@supportTaskUpdatedEvent.RejectionReason</value>
                </row>
                <row>
                    <key>Evidence</key>
                    <value>
                        @if (evidenceFileUrl is not null)
                        {
                            <a href="@evidenceFileUrl" class="govuk-link" rel="noreferrer noopener" target="_blank" data-testid="uploaded-evidence-link">@($"{requestData.NpqEvidenceFileName} (opens in new tab)")</a>
                        }
                        else
                        {
                            <span data-testid="uploaded-evidence-link" use-empty-fallback></span>
                        }
                    </value>
                </row>
            </govuk-summary-list>
        </govuk-details-text>
    </govuk-details>

    <govuk-details class="govuk-!-margin-bottom-2" data-testid="request-data">
        <govuk-details-summary>TRN request data</govuk-details-summary>
        <govuk-details-text>
            <govuk-summary-list>
                <row>
                    <key>Source</key>
                    <value>
                        @if (applicationUserName is not null)
                        {
                            <tag color="TagColor.Auto">@applicationUserName</tag>
                        }
                        else
                        {
                            <span use-empty-fallback></span>
                        }
                    </value>
                </row>
                <row>
                    <key>Request ID</key>
                    <value use-empty-fallback>@requestData.RequestId</value>
                </row>
                <row>
                    <key>Created on</key>
                    <value use-empty-fallback>@requestData.CreatedOn.ToString(WebConstants.DateAndTimeDisplayFormat)</value>
                </row>
                <row>
                    <key>Name</key>
                    <value>
                        @if (!string.IsNullOrWhiteSpace(requestDataName))
                        {
                            @Html.ConvertNewlinesToLineBreaks(requestDataName)
                        }
                        else
                        {
                            <span use-empty-fallback></span>
                        }
                    </value>
                </row>
                <row>
                    <key>Date of birth</key>
                    <value use-empty-fallback>@requestData.DateOfBirth.ToString(WebConstants.DateDisplayFormat)</value>
                </row>
                <row>
                    <key>Email address</key>
                    <value use-empty-fallback>@requestData.EmailAddress</value>
                </row>
                <row>
                    <key>National Insurance number</key>
                    <value use-empty-fallback>@requestData.NationalInsuranceNumber</value>
                </row>
                <row>
                    <key>Gender</key>
                    <value use-empty-fallback>@requestData.Gender?.GetDisplayName()</value>
                </row>
            </govuk-summary-list>
        </govuk-details-text>
    </govuk-details>
</timeline-entry>
