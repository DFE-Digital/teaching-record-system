@using TeachingRecordSystem.Core.Events
@model ChangeHistoryEntryViewModel
@{
    var deletedEvent = Model.GetEvent<SupportTaskDeletedEvent>();
    var supportTask = deletedEvent.SupportTask;
}

<timeline-entry title="@($"{supportTask.SupportTaskType.GetTitle()} support task deleted by Admin")" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
</timeline-entry>
