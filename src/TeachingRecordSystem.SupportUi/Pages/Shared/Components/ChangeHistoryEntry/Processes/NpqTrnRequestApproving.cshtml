@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.SupportUi.Services.ChangeHistory
@model ChangeHistoryEntryViewModel
@{
    var hasPersonCreatedEvent = Model.TryGetEvent<PersonCreatedEvent>(out var personCreatedEvent);
    var hasPersonDetailsUpdatedEvent = Model.TryGetEvent<PersonDetailsUpdatedEvent>(out var personDetailsUpdatedEvent);
    var hasSupportTaskUpdatedEvent = Model.TryGetEvent<SupportTaskUpdatedEvent>(out var supportTaskUpdatedEvent);
    var hasTrnRequestUpdatedEvent = Model.TryGetEvent<TrnRequestUpdatedEvent>(out var trnRequestUpdatedEvent);

    var isPersonContext = Model.Context.ContextType == ChangeHistoryContextType.Person;
    var isSupportTaskContext = Model.Context.ContextType == ChangeHistoryContextType.SupportTask;

    var matchedPersonId = hasPersonCreatedEvent
        ? personCreatedEvent!.PersonId
        : trnRequestUpdatedEvent?.TrnRequest.ResolvedPersonId ?? supportTaskUpdatedEvent?.SupportTask.PersonId;
    var matchedPersonInfo = matchedPersonId is not null ? Model.Context.TryGetPersonInfo(matchedPersonId.Value) : null;
    var matchedPersonLinkText = matchedPersonInfo is not null ? $"{matchedPersonInfo.FirstName} {matchedPersonInfo.LastName}" : null;

    var supportTaskReference = supportTaskUpdatedEvent?.SupportTaskReference;
}

@functions {
    private static IHtmlContent ToDisplayValueOrFallback(string? value)
    {
        if (string.IsNullOrEmpty(value))
        {
            return new HtmlString("<span class=\"trs-empty-fallback\">None</span>");
        }

        return new HtmlString(HtmlEncoder.Default.Encode(value));
    }
}

<timeline-entry title="NPQ TRN request approved" by="@Model.UserName" timestamp="@Model.Timestamp" data-process-id="@Model.ProcessId">
    @if (hasPersonCreatedEvent || matchedPersonId is not null)
    {
        <p class="govuk-body" data-testid="trn-request-summary">
            @if (hasPersonCreatedEvent)
            {
                @:Record created while resolving a TRN request.
            }
            else if (!isPersonContext)
            {
                @:TRN request resolved to <a href="@LinkGenerator.Persons.PersonDetail.Index(matchedPersonId!.Value)" class="govuk-link" target="_blank" data-testid="matched-person-link">@(matchedPersonLinkText ?? "a record") <span class="govuk-visually-hidden">(opens in new tab)</span></a>.
            }
            else
            {
                @:A TRN request was resolved to this record.
            }
        </p>
    }

    @if (hasPersonCreatedEvent)
    {
        <partial name="~/Pages/Shared/Components/ChangeHistoryEntry/_PersonDetailsSummary.cshtml" model="@personCreatedEvent!.Details" />
    }

    @if (hasPersonDetailsUpdatedEvent)
    {
        var details = personDetailsUpdatedEvent!.PersonDetails;
        var oldDetails = personDetailsUpdatedEvent.OldPersonDetails;
        var name = string.JoinNonEmpty(' ', details.FirstName, details.MiddleName, details.LastName);
        var oldName = string.JoinNonEmpty(' ', oldDetails.FirstName, oldDetails.MiddleName, oldDetails.LastName);

        if (personDetailsUpdatedEvent.Changes.HasAnyFlag(PersonDetailsUpdatedEventChanges.NameChange))
        {
            <p class="govuk-body" data-testid="name">Name changed from @ToDisplayValueOrFallback(oldName) to @ToDisplayValueOrFallback(name)</p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.DateOfBirth))
        {
            <p class="govuk-body" data-testid="date-of-birth">
                Date of birth changed from @ToDisplayValueOrFallback(oldDetails.DateOfBirth?.ToString(WebConstants.DateDisplayFormat)) to @ToDisplayValueOrFallback(details.DateOfBirth?.ToString(WebConstants.DateDisplayFormat))
            </p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.EmailAddress))
        {
            <p class="govuk-body" data-testid="email-address">Email address changed from @ToDisplayValueOrFallback(oldDetails.EmailAddress) to @ToDisplayValueOrFallback(details.EmailAddress)</p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.NationalInsuranceNumber))
        {
            <p class="govuk-body" data-testid="national-insurance-number">National Insurance number changed from @ToDisplayValueOrFallback(oldDetails.NationalInsuranceNumber) to @ToDisplayValueOrFallback(details.NationalInsuranceNumber)</p>
        }
        if (personDetailsUpdatedEvent.Changes.HasFlag(PersonDetailsUpdatedEventChanges.Gender))
        {
            <p class="govuk-body" data-testid="gender">Gender changed from @ToDisplayValueOrFallback(oldDetails.Gender?.GetDisplayName()) to @ToDisplayValueOrFallback(details.Gender?.GetDisplayName())</p>
        }
    }

    @if (hasSupportTaskUpdatedEvent && supportTaskReference is not null)
    {
        <p class="govuk-body" data-testid="task-closed-message">
            @if (!isSupportTaskContext)
            {
                <a class="govuk-link" href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(supportTaskReference)" data-testid="support-task-link">
                    Task<span class="govuk-visually-hidden"> @supportTaskReference</span>
                </a>
                <text> closed.</text>
            }
            else
            {
                <text>Task closed.</text>
            }
        </p>
    }

    @if (hasSupportTaskUpdatedEvent && !string.IsNullOrEmpty(supportTaskUpdatedEvent!.Comments))
    {
        <govuk-details class="govuk-!-margin-bottom-2" data-testid="change-reason">
            <summary>Reason for change</summary>
            <text>
                <govuk-summary-list>
                    <row>
                        <key>Reason</key>
                        <value use-empty-fallback data-testid="reason">@Html.ConvertNewlinesToLineBreaks(supportTaskUpdatedEvent.Comments)</value>
                    </row>
                </govuk-summary-list>
            </text>
        </govuk-details>
    }

    @if (Model.ContainsEvent<EmailSentEvent>())
    {
        <p class="govuk-body" data-testid="email-sent-message">
            We’ve sent them an email confirming their TRN.
        </p>
    }
</timeline-entry>
