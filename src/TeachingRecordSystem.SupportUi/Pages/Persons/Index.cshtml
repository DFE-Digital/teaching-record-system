@page "/persons"
@using Microsoft.AspNetCore.Authorization
@using TeachingRecordSystem.SupportUi.Infrastructure.Security
@inject IAuthorizationService AuthorizationService
@model TeachingRecordSystem.SupportUi.Pages.Persons.IndexModel
@{
    ViewBag.Title = "Records";
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Index(selectedTab: "records")">Back</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="get" asp-antiforgery="false" data-testid="search-form">
            <span class="govuk-caption-l">Search</span>
            <govuk-input for="Search" label-class="govuk-label--l" data-testid="search-input" type="search">
                <label>@ViewBag.Title</label>
                <hint>
                    Enter a name, email address, date of birth or TRN
                </hint>
                <after-input>
                    <govuk-button class="govuk-!-margin-bottom-0 govuk-!-margin-left-2 trs-!-height-full" type="submit">Search</govuk-button>
                </after-input>
            </govuk-input>
        </form>

        @if ((await AuthorizationService.AuthorizeAsync(User, AuthorizationPolicies.PersonDataEdit)).Succeeded)
        {
            <p class="govuk-body govuk-!-margin-top-4">
                <a href="@LinkGenerator.Persons.AddPerson.Index()" class="govuk-link">Or create a record</a>
            </p>
        }
    </div>
</div>

<div class="govuk-grid-row govuk-!-margin-top-6">
    <div class="govuk-grid-column-full">

        <div class="trs-horizontal-filters">
            <form method="get" asp-antiforgery="false">
                <h3 class="govuk-heading-s trs-horizontal-filters__heading">Filter by</h3>

                <input type="hidden" asp-for="Search" />

                <div class="trs-horizontal-filters__container">
                    <div class="trs-horizontal-filters__options">
                        <govuk-checkboxes for="IncludeActive">
                            <checkboxes-item value="@true">
                                @PersonStatus.Active.GetDisplayName() (@Model.Facets![nameof(Model.IncludeActive)].GetValueOrDefault(true, 0))
                            </checkboxes-item>
                        </govuk-checkboxes>

                        <govuk-checkboxes for="IncludeDeactivated">
                            <checkboxes-item value="@true">
                                @PersonStatus.Deactivated.GetDisplayName() (@Model.Facets![nameof(Model.IncludeDeactivated)].GetValueOrDefault(true, 0))
                            </checkboxes-item>
                        </govuk-checkboxes>

                        <govuk-checkboxes for="IncludeOneLoginUser">
                            <checkboxes-item value="@true">
                                GOV.UK One Login (@Model.Facets![nameof(Model.IncludeOneLoginUser)].GetValueOrDefault(true, 0))
                            </checkboxes-item>
                        </govuk-checkboxes>
                    </div>
                    <div class="trs-horizontal-filters__actions">
                        <div class="govuk-button-group govuk-!-margin-bottom-0">
                            <a href="@LinkGenerator.Persons.Index(Model.Search)" class="govuk-link">Clear all</a>
                            <govuk-button type="submit" class="govuk-!-margin-bottom-0">Apply filters</govuk-button>
                        </div>
                    </div>
                </div>

            </form>
        </div>

        <govuk-table class="trs-table-layout-fixed" sortable>
            <table-head>
                <table-head-cell class="trs-!-width-200"
                    sort-direction="@(Model.SortBy == PersonSearchSortByOption.Name ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.Persons.Index(Model.Search, Model.IncludeActive, Model.IncludeDeactivated, Model.IncludeOneLoginUser, PersonSearchSortByOption.Name, direction))">
                    Name
                </table-head-cell>
                <table-head-cell
                    sort-direction="@(Model.SortBy == PersonSearchSortByOption.OneLoginEmailAddress ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.Persons.Index(Model.Search, Model.IncludeActive, Model.IncludeDeactivated, Model.IncludeOneLoginUser, PersonSearchSortByOption.OneLoginEmailAddress, direction))">
                    One Login email address
                </table-head-cell>
                <table-head-cell class="trs-!-width-130"
                    sort-direction="@(Model.SortBy == PersonSearchSortByOption.DateOfBirth ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.Persons.Index(Model.Search, Model.IncludeActive, Model.IncludeDeactivated, Model.IncludeOneLoginUser, PersonSearchSortByOption.DateOfBirth, direction))">
                    Date of birth
                </table-head-cell>
                <table-head-cell class="trs-!-width-80"
                    sort-direction="@(Model.SortBy == PersonSearchSortByOption.Trn ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.Persons.Index(Model.Search, Model.IncludeActive, Model.IncludeDeactivated, Model.IncludeOneLoginUser, PersonSearchSortByOption.Trn, direction))">
                    TRN
                </table-head-cell>
                <table-head-cell class="trs-!-width-110"
                    sort-direction="@(Model.SortBy == PersonSearchSortByOption.NationalInsuranceNumber ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.Persons.Index(Model.Search, Model.IncludeActive, Model.IncludeDeactivated, Model.IncludeOneLoginUser, PersonSearchSortByOption.NationalInsuranceNumber, direction))">
                    National Insurance number
                </table-head-cell>
                <table-head-cell class="trs-!-width-80"
                    sort-direction="@(Model.SortBy == PersonSearchSortByOption.RecordStatus ? Model.SortDirection : null)"
                    link-template="@(direction => LinkGenerator.Persons.Index(Model.Search, Model.IncludeActive, Model.IncludeDeactivated, Model.IncludeOneLoginUser, PersonSearchSortByOption.RecordStatus, direction))">
                    Record status
                </table-head-cell>
            </table-head>
            @if (Model.SearchResults!.Count == 0)
            {
                <table-row data-testid="no-matches">
                    <table-cell colspan="6">No matching records</table-cell>
                </table-row>
            }
            else
            {
                @foreach (var personInfo in Model.SearchResults)
                {
                    <table-row data-testid="person-@personInfo.PersonId">
                        <table-cell data-testid="name"><a href="@LinkGenerator.Persons.PersonDetail.Index(personInfo.PersonId)" class="govuk-link">@personInfo.Name</a></table-cell>
                        <table-cell class="trs-break-word" data-testid="one-login-emails" use-empty-fallback>
                            @if (personInfo.OneLoginUserEmailAddresses.Length > 0)
                            {
                                <ul class="govuk-list">
                                    @foreach (var email in personInfo.OneLoginUserEmailAddresses)
                                    {
                                        <li class="govuk-!-margin-bottom-0">@email</li>
                                    }
                                </ul>
                            }
                        </table-cell>
                        <table-cell data-testid="date-of-birth" use-empty-fallback>@(personInfo.DateOfBirth.HasValue ? personInfo.DateOfBirth.Value.ToString(WebConstants.DateDisplayFormat) : string.Empty)</table-cell>
                        <table-cell data-testid="trn">@personInfo.Trn</table-cell>
                        <table-cell data-testid="nino" use-empty-fallback>@personInfo.NationalInsuranceNumber</table-cell>
                        <table-cell data-testid="status">@personInfo.PersonStatus</table-cell>
                    </table-row>
                }
            }
        </govuk-table>

        <govuk-pagination current-page="@Model.Pagination!.CurrentPage" total-pages="@Model.Pagination.LastPage" generate-page-href="@Model.Pagination.GetPageLink" />
    </div>
</div>
