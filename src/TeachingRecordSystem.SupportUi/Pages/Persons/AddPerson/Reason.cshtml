@page "/persons/add/reason"
@using TeachingRecordSystem.Core.Services.Persons
@using TeachingRecordSystem.SupportUi.Pages.Persons.PersonDetail.SetStatus
@model TeachingRecordSystem.SupportUi.Pages.Persons.AddPerson.ReasonModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Why are you creating this record?";
}

@section BeforeContent {
    <govuk-back-link data-testid="back-link" href="@Model.BackLink">Back</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <form method="post" data-testid="submit-form">
            <span class="govuk-caption-l" data-testid="create-reason-caption">Create a record</span>
            <govuk-radios for="Reason" data-testid="create-reason-options">
                <legend class="govuk-fieldset__legend--l" is-page-heading="true" data-testid="create-reason-options-legend">
                    Why are you creating this record?
                </legend>
                <radios-item value="@PersonCreateReason.MandatoryQualification">
                    @PersonCreateReason.MandatoryQualification.GetDisplayName()
                </radios-item>
                <radios-item value="@PersonCreateReason.AlertReceived">
                    @PersonCreateReason.AlertReceived.GetDisplayName()
                </radios-item>
                <radios-item value="@PersonCreateReason.UniversityLateStarter">
                    @PersonCreateReason.UniversityLateStarter.GetDisplayName()
                </radios-item>
                <radios-item value="@PersonCreateReason.AnotherReason">
                    @PersonCreateReason.AnotherReason.GetDisplayName()

                    <conditional data-testid="create-reason-detail">
                        <govuk-input data-testid="reason-detail" for="ReasonDetail" input-class="govuk-input--width-20" spellcheck="false">
                            <label>Enter a reason</label>
                       </govuk-input>
                    </conditional>
                </radios-item>
            </govuk-radios>

            <govuk-radios for="ProvideAdditionalInformation" data-testid="provide-more-information-options">
                <legend class="govuk-fieldset__legend--m" data-testid="create-provide-additional-information-legend">
                    <h2 class="govuk-fieldset__legend--m">Do you want to provide more information?</h2>
                </legend>
                <radios-item value="@ProvideMoreInformationOption.Yes">
                    @ProvideMoreInformationOption.Yes.GetDisplayName()
                    <conditional>
                        <govuk-character-count for="AdditionalInformation" max-length="UiDefaults.ReasonDetailsMaxCharacterCount" rows="UiDefaults.ReasonDetailsRows">
                            <label>Enter details</label>
                        </govuk-character-count>
                    </conditional>
                </radios-item>
                <radios-item value="@ProvideMoreInformationOption.No">
                    @ProvideMoreInformationOption.No.GetDisplayName()
                </radios-item>
            </govuk-radios>
            
            @Html.EditorFor(m => m.Evidence)

            <div class="govuk-button-group">
                <govuk-button type="submit" data-testid="continue-button">Continue</govuk-button>
                <govuk-button data-testid="cancel-button" name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel</govuk-button>
            </div>
        </form>
    </div>
</div>
