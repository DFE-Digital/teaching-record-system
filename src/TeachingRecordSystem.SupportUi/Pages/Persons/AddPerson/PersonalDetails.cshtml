@page "/persons/add/personal-details"
@model TeachingRecordSystem.SupportUi.Pages.Persons.AddPerson.PersonalDetailsModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Enter the person\u2019s personal details";
}

@section BeforeContent {
    <govuk-back-link data-testid="back-link" href="@Model.BackLink" />
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <form method="post" data-testid="submit-form">
            <span class="govuk-caption-l" data-testid="edit-details-caption">Create a record</span>
            <h1 class="govuk-heading-l">@ViewBag.Title</h1>

            <govuk-input for="FirstName" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-first-name">
                <label>First name</label>
            </govuk-input>

            <govuk-input for="MiddleName" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-middle-name">
                <label>Middle name (optional)</label>
            </govuk-input>

            <govuk-input for="LastName" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-last-name">
                <label>Last name</label>
            </govuk-input>

            <govuk-date-input for="DateOfBirth" data-testid="edit-details-date-of-birth">
                <legend class="govuk-fieldset__legend--s">
                    Date of birth
                </legend>
                <hint>For example, 31 3 1980</hint>
            </govuk-date-input>

            <govuk-input for="EmailAddress" type="email" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-email-address">
                <label>Email address (optional)</label>
            </govuk-input>

            <govuk-input for="NationalInsuranceNumber" label-class="govuk-label--s govuk-input--extra-letter-spacing" input-class="govuk-input--width-20" data-testid="edit-details-national-insurance-number">
                <label>National Insurance number (optional)</label>
                <hint>For example, &lsquo;QQ 12 34 56 C&rsquo;</hint>
            </govuk-input>

            <govuk-radios for="Gender" data-testid="edit-details-gender-options">
                <legend class="govuk-fieldset__legend--s" data-testid="edit-details-gender-options-legend">
                    Gender (optional)
                </legend>
                <radios-item value="@Gender.Male">
                    @Gender.Male.GetDisplayName()
                </radios-item>
                <radios-item value="@Gender.Female">
                    @Gender.Female.GetDisplayName()
                </radios-item>
                <radios-item value="@Gender.Other">
                    @Gender.Other.GetDisplayName()
                </radios-item>
                <radios-item value="">
                    Not provided
                </radios-item>
            </govuk-radios>

            <div class="govuk-button-group">
                <govuk-button type="submit" data-testid="continue-button">Continue</govuk-button>
                <govuk-button data-testid="cancel-button" name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel</govuk-button>
            </div>
        </form>
    </div>
</div>
