@page "/persons/{PersonId}/set-status/{TargetStatus}/reason"
@using TeachingRecordSystem.Core.Services.Persons
@model TeachingRecordSystem.SupportUi.Pages.Persons.PersonDetail.SetStatus.ReasonModel
@{
    Layout = "_Layout";
    ViewBag.Title = Model.TargetStatus == PersonStatus.Deactivated
        ? Html.DisplayNameFor(m => m.DeactivateReason)
        : Html.DisplayNameFor(m => m.ReactivateReason);
    var caption = Model.TargetStatus == PersonStatus.Deactivated
        ? $"Deactivate record - {Model.PersonName}"
        : $"Reactivate record - {Model.PersonName}";
}

@section BeforeContent {
    <govuk-back-link data-testid="back-link" href="@Model.BackLink">Back</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-!-width-two-thirds">
        <form method="post" enctype="multipart/form-data" data-testid="submit-form">
            <span class="govuk-caption-l" data-testid="set-status-caption">@caption</span>

            @if (Model.TargetStatus == PersonStatus.Deactivated)
            {
                <govuk-radios for="DeactivateReason" data-testid="deactivate-reason-options">
                    <legend class="govuk-fieldset__legend--l" is-page-heading="true" data-testid="deactivate-reason-options-legend">
                        Why are you deactivating this record?
                    </legend>
                    <radios-item value="@PersonDeactivateReason.RecordHolderDied">
                        @PersonDeactivateReason.RecordHolderDied.GetDisplayName()
                    </radios-item>
                    <radios-item value="@PersonDeactivateReason.ProblemWithTheRecord">
                        @PersonDeactivateReason.ProblemWithTheRecord.GetDisplayName()
                    </radios-item>
                    <radios-item value="@PersonDeactivateReason.AnotherReason">
                        @PersonDeactivateReason.AnotherReason.GetDisplayName()
                        <conditional data-testid="deactivate-reason-detail">
                            <govuk-input data-testid="deactivate-reason-detail" for="DeactivateReasonDetail" input-class="govuk-input--width-20" spellcheck="false">
                                <label>Enter a reason</label>
                            </govuk-input>
                        </conditional>
                    </radios-item>
                </govuk-radios>

                <govuk-radios for="ProvideMoreInformation"  name="ProvideMoreInformation" data-testid="provide-more-information-options">
                    <legend class="govuk-fieldset__legend--l" is-page-heading="true" data-testid="provide-more-information-options-legend">
                        Do you want to provide more information?
                    </legend>
                    <radios-item value="@ProvideMoreInformationOption.Yes">
                        @ProvideMoreInformationOption.Yes.GetDisplayName()
                        <conditional>
                            <govuk-character-count for="DeactivateAdditionalInformation" max-length="UiDefaults.ReasonDetailsMaxCharacterCount" rows="UiDefaults.ReasonDetailsRows">
                                <label>Enter details</label>
                            </govuk-character-count>
                        </conditional>
                    </radios-item>
                    <radios-item value="@ProvideMoreInformationOption.No">
                        @ProvideMoreInformationOption.No.GetDisplayName()
                    </radios-item>
                </govuk-radios>
            }
            else
            {
                <govuk-radios for="ReactivateReason" data-testid="reactivate-reason-options">
                    <legend class="govuk-fieldset__legend--l" is-page-heading="true" data-testid="reactivate-reason-options-legend">
                        Why are you reactivating this record?
                    </legend>
                    <radios-item value="@PersonReactivateReason.DeactivatedByMistake">
                        @PersonReactivateReason.DeactivatedByMistake.GetDisplayName()
                    </radios-item>
                    <radios-item value="@PersonReactivateReason.AnotherReason">
                        @PersonReactivateReason.AnotherReason.GetDisplayName()
                        <conditional>
                            <govuk-input data-testid="reactivate-reason-detail" for="ReactivateReasonDetail" input-class="govuk-input--width-20" spellcheck="false">
                                <label>Enter a reason</label>
                            </govuk-input>
                        </conditional>
                    </radios-item>
                </govuk-radios>

                <govuk-radios for="ProvideMoreInformation"  name="ProvideMoreInformation" data-testid="provide-more-information-options">
                    <legend class="govuk-fieldset__legend--l" is-page-heading="true" data-testid="provide-more-information-options-legend">
                        Do you want to provide more information?
                    </legend>
                    <radios-item value="@ProvideMoreInformationOption.Yes">
                        @ProvideMoreInformationOption.Yes.GetDisplayName()
                        <conditional>
                            <govuk-character-count for="ReactivateAdditionalInformation" max-length="UiDefaults.ReasonDetailsMaxCharacterCount" rows="UiDefaults.ReasonDetailsRows">
                                <label>Enter details</label>
                            </govuk-character-count>
                        </conditional>
                    </radios-item>
                    <radios-item value="@ProvideMoreInformationOption.No">
                        @ProvideMoreInformationOption.No.GetDisplayName()
                    </radios-item>
                </govuk-radios>
            }

            @Html.EditorFor(m => m.Evidence)

            <div class="govuk-button-group">
                <govuk-button type="submit" data-testid="continue-button">Continue</govuk-button>
                <govuk-button type="submit" name="Cancel" value="true" class="govuk-button--secondary" data-testid="cancel-button">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
