@page "/persons/{personId}/edit-details"
@using TeachingRecordSystem.SupportUi.Pages.Common;
@using TeachingRecordSystem.SupportUi.Pages.Shared
@using Microsoft.AspNetCore.Mvc.ModelBinding
@model TeachingRecordSystem.SupportUi.Pages.Persons.PersonDetail.EditDetails.IndexModel
@{
    Layout = "_Layout";
    ViewBag.Title = "Edit personal details";
}

@section BeforeContent {
    <govuk-back-link data-testid="back-link" href="@Model.BackLink">Back</govuk-back-link>
}

@if (ModelState.ErrorCount > 0)
{
    //Re-implement the form error summary to handle validation errors that do not apply to a specific field
    <govuk-error-summary>
        @if (ModelState.ContainsKey("") && ModelState[""] is ModelStateEntry entry && entry.Errors.Count > 0)
        {
            <error-summary-item>@entry.Errors.First().ErrorMessage</error-summary-item>
        }
        <error-summary-item for="FirstName" />
        <error-summary-item for="MiddleName" />
        <error-summary-item for="LastName" />
        <error-summary-item for="DateOfBirth" />
        <error-summary-item for="EmailAddress" />
        <error-summary-item for="NationalInsuranceNumber" />
        <error-summary-item for="Gender" />
    </govuk-error-summary>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-full">
        <form method="post" data-testid="submit-form">
            <span class="govuk-caption-l" data-testid="edit-details-caption">@Model.PersonName</span>
            <h1 class="govuk-heading-l">@ViewBag.Title</h1>

            <govuk-input for="FirstName" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-first-name">
                <label>First name</label>
            </govuk-input>

            <govuk-input for="MiddleName" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-middle-name">
                <label>Middle name (optional)</label>
            </govuk-input>

            <govuk-input for="LastName" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-last-name">
                <label>Last name</label>
            </govuk-input>

            <govuk-date-input for="DateOfBirth" data-testid="edit-details-date-of-birth">
                <legend class="govuk-fieldset__legend--s">
                    Date of birth
                </legend>
                <hint>For example, 31 3 1980</hint>
            </govuk-date-input>

            <govuk-input for="EmailAddress" type="email" label-class="govuk-label--s" input-class="govuk-input--width-20" data-testid="edit-details-email-address">
                <label>Email address (optional)</label>
            </govuk-input>

            <govuk-input for="NationalInsuranceNumber" label-class="govuk-label--s" input-class="govuk-input--width-20 govuk-input--extra-letter-spacing" data-testid="edit-details-national-insurance-number">
                <label>National Insurance number (optional)</label>
                <hint>For example, &lsquo;QQ 12 34 56 C&rsquo;</hint>
            </govuk-input>

            <govuk-radios for="Gender" data-testid="edit-details-gender-options">
                <legend class="govuk-fieldset__legend--s" data-testid="edit-details-gender-options-legend">
                    Gender (optional)
                </legend>
                <radios-item value="@Gender.Male">
                    @Gender.Male.GetDisplayName()
                </radios-item>
                <radios-item value="@Gender.Female">
                    @Gender.Female.GetDisplayName()
                </radios-item>
                <radios-item value="@Gender.Other">
                    @Gender.Other.GetDisplayName()
                </radios-item>
                @* We only allow NotAvailable if it's a pre-existing value on the Person record *@
                @if (Model.Gender == Gender.NotAvailable)
                {
                    <radios-item value="@Gender.NotAvailable">
                        @Gender.NotAvailable.GetDisplayName()
                    </radios-item>
                }
                <radios-item value="">
                    Not provided
                </radios-item>
            </govuk-radios>

            <div class="govuk-button-group">
                <govuk-button type="submit" data-testid="continue-button">Continue</govuk-button>
                <govuk-button data-testid="cancel-button" name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
