@page "/persons/{PersonId}/edit-induction/reason"
@using TeachingRecordSystem.Core.Services.Persons
@model TeachingRecordSystem.SupportUi.Pages.Persons.PersonDetail.EditInduction.ReasonModel
@{
    ViewBag.Title = "Change reason";
}

@section BeforeContent {
    <govuk-back-link data-testid="back-link" href="@Model.BackLink">Back</govuk-back-link>
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <span class="govuk-caption-l">@Model.PageCaption</span>
            <govuk-radios for="ChangeReason" data-testid="reason-options">
                <legend data-testid="reason-options-legend" class="govuk-fieldset__legend--l" is-page-heading="true">Why are you changing the induction details?</legend>
                <radios-item value="@PersonInductionChangeReason.IncompleteDetails">
                    @PersonInductionChangeReason.IncompleteDetails.GetDisplayName()
                </radios-item>
                <radios-item value="@PersonInductionChangeReason.NewInformation">
                    @PersonInductionChangeReason.NewInformation.GetDisplayName()
                </radios-item>
                <radios-item value="@PersonInductionChangeReason.NoLongerExempt">
                    @PersonInductionChangeReason.NoLongerExempt.GetDisplayName()
                </radios-item>
                <radios-item value="@PersonInductionChangeReason.AnotherReason">
                    @PersonInductionChangeReason.AnotherReason.GetDisplayName()
                    <conditional data-testid="change-reason-detail">
                        <govuk-input data-testid="reason-detail" for="ChangeReasonDetail" input-class="govuk-input--width-20" spellcheck="false">
                            <label>Enter a reason</label>
                        </govuk-input>
                    </conditional>
                </radios-item>
            </govuk-radios>

            <govuk-radios for="ProvideAdditionalInformation" data-testid="has-additional-reason_detail-options">
                <legend data-testid="has-additional-reason_detail-options-legend">
                    <h2 class ="govuk-fieldset__legend--m">Do you want to provide more information?</h2>
                </legend>
                <radios-item value="@true">
                    Yes
                    <conditional data-testid="additional-detail">
                        <govuk-character-count for="AdditionalInformation" max-length="UiDefaults.ReasonDetailsMaxCharacterCount" rows="UiDefaults.ReasonDetailsRows">
                            <label>Enter details</label>
                        </govuk-character-count>
                    </conditional>
                </radios-item>
                <radios-item value="@false">
                    No
                </radios-item>
            </govuk-radios>

            @Html.EditorFor(m => m.Evidence)

            <div class="govuk-button-group">
                <govuk-button type="submit" data-testid="continue-button">Continue</govuk-button>
                <govuk-button data-testid="cancel-button" name="Cancel" value="true" class="govuk-button--secondary" type="submit">Cancel and return to record</govuk-button>
            </div>
        </form>
    </div>
</div>
