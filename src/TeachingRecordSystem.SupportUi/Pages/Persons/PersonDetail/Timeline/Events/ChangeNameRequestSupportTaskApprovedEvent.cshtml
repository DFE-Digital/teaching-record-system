@using TeachingRecordSystem.Core.Events
@using TeachingRecordSystem.Core.Events.Legacy
@using ChangeNameRequestSupportTaskApprovedEvent = LegacyEvents.ChangeNameRequestSupportTaskApprovedEvent;
@inject SupportUiLinkGenerator LinkGenerator
@model TimelineItem<LegacyEventChangeHistoryEntry<TeachingRecordSystem.Core.Events.Legacy.ChangeNameRequestSupportTaskApprovedEvent>>
@{
    var supportTaskEvent = Model.ItemModel.Event;
    var details = supportTaskEvent.PersonAttributes;
    var oldDetails = supportTaskEvent.OldPersonAttributes;
    var name = string.JoinNonEmpty(' ', details.FirstName, details.MiddleName, details.LastName);
    var oldName = string.JoinNonEmpty(' ', oldDetails.FirstName, oldDetails.MiddleName, oldDetails.LastName);
}

<div class="moj-timeline__item govuk-!-padding-bottom-2" data-testid="timeline-name-request-approved-event">
    <div class="moj-timeline__header">
        <h2 class="moj-timeline__title">Change of Name request accepted</h2>
    </div>
    <p class="moj-timeline__date">
        <span data-testid="raised-by">By @Model.ItemModel.RaisedByUser.Name on</span>
        <time datetime="@Model.Timestamp.ToString("O")" data-testid="timeline-item-time">@Model.FormattedGmtTimestamp</time>
    </p>
    <div class="moj-timeline__description">
        <p class="govuk-body" data-testid="change-request-context">
            Name changed from <strong>@oldName</strong> to <strong>@name</strong>.
        </p>
        <p class="govuk-body" data-testid="support-task-closed-message">
            <a class="govuk-link" href="@LinkGenerator.SupportTasks.SupportTaskDetail.Index(supportTaskEvent.SupportTask.SupportTaskReference)" data-testid="support-task-link">Task</a>
            <text> closed.</text>
        </p>
    </div>
</div>
