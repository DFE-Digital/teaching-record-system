@page "/persons/{personId}/alerts"
@using TeachingRecordSystem.SupportUi.Pages.Common;
@model TeachingRecordSystem.SupportUi.Pages.Persons.PersonDetail.AlertsModel
@{
    Layout = "Layout";
    ViewBag.SelectedTab = PersonDetailSubNavigationTab.Alerts;
    var person = HttpContext.Features.GetRequiredFeature<CurrentPersonFeature>();
}

@section BeforeContent {
    <govuk-back-link href="@LinkGenerator.Persons.PersonDetail.Index(person.PersonId)">Back to record</govuk-back-link>
}

<div>
    <h2 class="govuk-heading-m">Open alerts</h2>

    @if (Model.ShowOpenAlertFlag)
    {
        <govuk-notification-banner data-testid="OpenAlertFlag">
            <p class="govuk-notification-banner__heading">
                This person has another alert on their record that is not shown here
                <a class="govuk-notification-banner__link" href="mailto:TQ.DATARECEIPT@education.gov.uk">Contact the TRA</a> for more information.
            </p>
        </govuk-notification-banner>
    }

    @if (Model.OpenAlerts!.Length == 0)
    {
        if (!Model.ShowOpenAlertFlag)
        {
            <p class="govuk-body" data-testid="no-open-alerts">No open alerts</p>
        }
    }
    else
    {
        @foreach (var (alert, externalLinkUri, canWrite) in Model.OpenAlerts)
        {
            <govuk-summary-card data-testid="open-alert">
                <card-title heading-level="3">@alert.AlertType!.Name</card-title>
                @if (canWrite)
                {
                    <card-actions>
                        <action href="@LinkGenerator.Alerts.DeleteAlert.Index(alert.AlertId)" visually-hidden-text="alert">Delete</action>
                    </card-actions>
                }
                <govuk-summary-list>
                    <row>
                        <key>Details</key>
                        <value>
                            @if (alert.Details is not null)
                            {
                                @Html.ConvertNewlinesToLineBreaks(alert.Details)
                            }
                            else
                            {
                                <span use-empty-fallback></span>
                            }
                        </value>
                        @if (canWrite)
                        {
                            <row-actions>
                                <action href="@LinkGenerator.Alerts.EditAlert.Details.Index(alert.AlertId)" visually-hidden-text="details">Change</action>
                            </row-actions>
                        }
                    </row>
                    <row>
                        <key>Link</key>
                        <value>
                            @if (alert.ExternalLink is not null)
                            {
                                <a href="@externalLinkUri" class="govuk-link" rel="noreferrer noopener" target="_blank">@($"{alert.ExternalLink} (opens in new tab)")</a>
                            }
                            else
                            {
                                <span use-empty-fallback></span>
                            }
                        </value>
                        @if (canWrite)
                        {
                            <row-actions>
                                <action href="@LinkGenerator.Alerts.EditAlert.Link.Index(alert.AlertId)" visually-hidden-text="link">Change</action>
                            </row-actions>
                        }
                    </row>
                    <row>
                        <key>Start date</key>
                        <value use-empty-fallback>@alert.StartDate?.ToString(WebConstants.DateDisplayFormat)</value>
                        @if (canWrite)
                        {
                            <row-actions>
                                <action href="@LinkGenerator.Alerts.EditAlert.StartDate.Index(alert.AlertId)" visually-hidden-text="start date">Change</action>
                            </row-actions>
                        }
                    </row>
                    <row>
                        <key>End date</key>
                        <value use-empty-fallback></value>
                        @if (canWrite)
                        {
                            <row-actions>
                                <action href="@LinkGenerator.Alerts.CloseAlert.Index(alert.AlertId)" visually-hidden-text="end date">Add</action>
                            </row-actions>
                        }
                    </row>
                </govuk-summary-list>
            </govuk-summary-card>
        }
    }

    @if (Model.CanAddAlert)
    {
        <govuk-button-link href="@LinkGenerator.Alerts.AddAlert.Index(person.PersonId)" class="govuk-!-margin-bottom-0" data-testid="AddAnAlertBtn">Add an alert</govuk-button-link>
    }
</div>

<hr class="govuk-section-break govuk-section-break--xl govuk-section-break--visible">

<div>
    <h2 class="govuk-heading-m">Closed alerts</h2>

    @if (Model.ClosedAlerts!.Length == 0)
    {
        <p class="govuk-body" data-testid="no-closed-alerts">No closed alerts</p>
    }
    else
    {
        <govuk-table data-testid="closed-alerts">
            <table-head>
                <table-head-cell>Alert</table-head-cell>
                <table-head-cell class="trs-\!-width-200">Start date</table-head-cell>
                <table-head-cell class="trs-\!-width-200">End date</table-head-cell>
                <table-head-cell class="trs-\!-width-70"></table-head-cell>
            </table-head>
            @foreach (var (alert, externalLinkUri, canWrite) in Model.ClosedAlerts!)
            {
                <table-row>
                    <table-cell><a href="@LinkGenerator.Alerts.AlertDetail(alert.AlertId)" class="govuk-link">@alert.AlertType!.Name</a></table-cell>
                    <table-cell>@alert.StartDate?.ToString(WebConstants.DateDisplayFormat)</table-cell>
                    <table-cell>@alert.EndDate?.ToString(WebConstants.DateDisplayFormat)</table-cell>
                    <table-cell>
                        @if (canWrite)
                        {
                            <a href="@LinkGenerator.Alerts.DeleteAlert.Index(alert.AlertId)" class="govuk-link">Delete <span class="govuk-visually-hidden">alert</span></a>
                        }
                    </table-cell>
                </table-row>
            }
        </govuk-table>
    }
</div>
