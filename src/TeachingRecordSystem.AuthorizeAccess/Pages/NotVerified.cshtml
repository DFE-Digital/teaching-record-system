@page "/not-verified"
@model TeachingRecordSystem.AuthorizeAccess.Pages.NotVerifiedModel
@{
    ViewBag.Title = "We could not verify your identity";
}

<form method="post">
    <govuk-panel class="govuk-panel--interruption">
        <panel-title>@ViewBag.Title</panel-title>

        <panel-body>
            <p class="govuk-body">
                You can try to verify your identity again using GOV.UK One Login.
            </p>

            <govuk-button name="TryAgain" value="true" class="govuk-button--inverse">Verify with GOV.UK One Login</govuk-button>

            <p class="govuk-body">
                Alternatively, we will try to confirm your identity and match you to a teaching record using your personal details.
                This can take up to 5 working days.
            </p>

            <p class="govuk-body govuk-!-margin-bottom-0">
                We’ll ask for:
            </p>

            <ul class="govuk-list govuk-list--bullet">
                <li>your name</li>
                <li>your date of birth</li>
                <li>your National Insurance number</li>
                <li>your teacher reference number (TRN)</li>
                <li>proof of your identity, such as a passport or driving licence</li>
            </ul>
        </panel-body>
        <panel-actions>
            <action-button type="submit" class="trs-panel--interruption__link-button">Verify using my personal details</action-button>
        </panel-actions>
    </govuk-panel>
</form>
