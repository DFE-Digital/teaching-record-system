@page "/trn-deferred"
@model TeachingRecordSystem.AuthorizeAccess.Pages.TrnDeferredModel
@{
    ViewBag.Title = "Continue your registration";
}

<form method="post">
    <govuk-panel class="govuk-panel--interruption">
        <panel-title>@ViewBag.Title</panel-title>

        <panel-body>
            <p class="govuk-body">
                You’ll be given a teacher reference number (TRN) once you’ve been accepted on a course.
            </p>
        </panel-body>
        <panel-actions>
            <action-button type="submit">Continue</action-button>
        </panel-actions>
    </govuk-panel>
</form>
