@page "/date-of-birth"
@model TeachingRecordSystem.AuthorizeAccess.Pages.DateOfBirthModel
@{
    ViewBag.Title = "Enter your date of birth";
}

<div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
        <form method="post">
            <govuk-date-input for="DateOfBirth" error-message-prefix="Your date of birth">
                <legend is-page-heading="true" class="govuk-fieldset__legend--l">@ViewBag.Title</legend>
                <hint>For example, 31 3 1980</hint>
                <day autocomplete="bday-day" />
                <month autocomplete="bday-month" />
                <year autocomplete="bday-year" />
            </govuk-date-input>

            <govuk-button type="submit">Continue</govuk-button>
        </form>
    </div>
</div>
