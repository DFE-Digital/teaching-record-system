@page "/not-found"
@model TeachingRecordSystem.AuthorizeAccess.Pages.NotFoundModel
@{
    ViewBag.Title = "We cannot find your teaching record or you might not have one";
}

<form method="post">
    <govuk-panel class="govuk-panel--interruption">
        <panel-title>@ViewBag.Title</panel-title>

        <panel-body>
            <p class="govuk-body govuk-!-margin-bottom-0">
                We could not match your details to a teaching record.
            </p>

            <h2 class="govuk-heading-m">What you can do next</h2>

            <p class="govuk-body">
                We will now ask you for details of your QTS award, including award date, provider and subject. If you can provide this information it may help us find your record, but this is not required.
            </p>

            <p class="govuk-body">
                You will then be able to check your answers. If they are correct, you can send a support request to help us find your teaching record.
            </p>

            <p class="govuk-body">
                We’ll review your details and contact you if we need more information.
            </p>
        </panel-body>
        <panel-actions>
            <action-button type="submit">Next</action-button>
        </panel-actions>
    </govuk-panel>
</form>
